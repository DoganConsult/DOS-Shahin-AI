{
  "name": "@dos/types",
  "version": "1.0.0",
  "description": "DOS Platform — shared pure types (zero runtime deps). Used by backend, frontend, and all @dos/* packages.",
  "private": true,
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" },
    "./db": { "types": "./dist/db.d.ts", "default": "./dist/db.js" },
    "./express": { "types": "./dist/express.d.ts", "default": "./dist/express.js" },
    "./module": { "types": "./dist/module.d.ts", "default": "./dist/module.js" },
    "./errors": { "types": "./dist/errors.d.ts", "default": "./dist/errors.js" },
    "./analytics": { "types": "./dist/analytics.d.ts", "default": "./dist/analytics.js" },
    "./asset": { "types": "./dist/asset.d.ts", "default": "./dist/asset.js" },
    "./compliance": { "types": "./dist/compliance.d.ts", "default": "./dist/compliance.js" },
    "./governance": { "types": "./dist/governance.d.ts", "default": "./dist/governance.js" },
    "./incident": { "types": "./dist/incident.d.ts", "default": "./dist/incident.js" },
    "./integration": { "types": "./dist/integration.d.ts", "default": "./dist/integration.js" },
    "./notification": { "types": "./dist/notification.d.ts", "default": "./dist/notification.js" },
    "./privacy": { "types": "./dist/privacy.d.ts", "default": "./dist/privacy.js" },
    "./reporting": { "types": "./dist/reporting.d.ts", "default": "./dist/reporting.js" },
    "./risk": { "types": "./dist/risk.d.ts", "default": "./dist/risk.js" },
    "./training": { "types": "./dist/training.d.ts", "default": "./dist/training.js" },
    "./vendor": { "types": "./dist/vendor.d.ts", "default": "./dist/vendor.js" },
    "./workflow": { "types": "./dist/workflow.d.ts", "default": "./dist/workflow.js" },
    "./events": { "types": "./dist/events.d.ts", "default": "./dist/events.js" },
    "./actor": { "types": "./dist/actor.d.ts", "default": "./dist/actor.js" },
    "./agent": { "types": "./dist/agent.d.ts", "default": "./dist/agent.js" },
    "./blueprint": { "types": "./dist/blueprint.d.ts", "default": "./dist/blueprint.js" },
    "./chart": { "types": "./dist/chart.d.ts", "default": "./dist/chart.js" },
    "./cooperative-workflows": { "types": "./dist/cooperative-workflows.d.ts", "default": "./dist/cooperative-workflows.js" },
    "./engagement": { "types": "./dist/engagement.d.ts", "default": "./dist/engagement.js" },
    "./grc": { "types": "./dist/grc.d.ts", "default": "./dist/grc.js" },
    "./journey": { "types": "./dist/journey.d.ts", "default": "./dist/journey.js" },
    "./workspace-seed": { "types": "./dist/workspace-seed.d.ts", "default": "./dist/workspace-seed.js" },
    "./auth": { "types": "./dist/auth.d.ts", "default": "./dist/auth.js" }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "rm -rf dist"
  },
  "devDependencies": {
    "typescript": "^5.7.0"
  }
}
