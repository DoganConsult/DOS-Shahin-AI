{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "src",
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@dos/types": ["../dos-types/dist/index"],
      "@dos/types/*": ["../dos-types/dist/*"],
      "@dos/contracts": ["../dos-contracts/dist/index"],
      "@dos/contracts/*": ["../dos-contracts/dist/*"],
      "@dos/db": ["../dos-db/dist/index"],
      "@dos/db/*": ["../dos-db/dist/*"],
      "@dos/module-sdk": ["../dos-module-sdk/dist/index"],
      "@dos/module-sdk/*": ["../dos-module-sdk/dist/*"],
      "@dos/platform-core": ["../dos-platform-core/dist/index"],
      "@dos/platform-core/*": ["../dos-platform-core/dist/*"]
    }
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"]
}
