{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "strict": false,
    "outDir": "dist",
    "rootDir": "src",
    "noEmit": false,
    "declaration": true,
    "declarationMap": false,
    "sourceMap": true,
    "noEmitOnError": false,
    "tsBuildInfoFile": "./dist/.tsbuildinfo",
    "baseUrl": ".",
    "paths": {
      "@dos/types": ["../dos-types/dist/index"],
      "@dos/types/*": ["../dos-types/dist/*"],
      "@dos/contracts": ["../dos-contracts/dist/index"],
      "@dos/contracts/*": ["../dos-contracts/dist/*"],
      "@dos/db": ["../dos-db/dist/index"],
      "@dos/db/*": ["../dos-db/dist/*"],
      "@dos/module-sdk": ["../dos-module-sdk/dist/index"],
      "@dos/module-sdk/*": ["../dos-module-sdk/dist/*"],
      "@dos/platform-core": ["../dos-platform-core/dist/index"],
      "@dos/platform-core/*": ["../dos-platform-core/dist/*"],
      "@dos/auth": ["../dos-auth/dist/index"],
      "@dos/auth/*": ["../dos-auth/dist/*"],
      "@dos/event-backbone": ["../dos-event-backbone/dist/index"],
      "@dos/event-backbone/*": ["../dos-event-backbone/dist/*"],
      "@dos/service-client": ["../dos-service-client/dist/index"],
      "@dos/service-client/*": ["../dos-service-client/dist/*"],
      "@dos/runtime-config": ["../dos-runtime-config/dist/index"],
      "@dos/runtime-config/*": ["../dos-runtime-config/dist/*"],
      "@dos/service-bootstrap": ["../dos-service-bootstrap/dist/index"],
      "@dos/service-bootstrap/*": ["../dos-service-bootstrap/dist/*"]
    }
  },
  "include": [
    "src/index.ts",
    "src/ai/tools/**/*"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "**/*.test.ts",
    "**/*.spec.ts",
    "**/__tests__/**",
    "src/agrc-route-manifest.ts",
    "src/agrc-event-subscribers.ts",
    "src/agrc-routes.ts",
    "src/agrc-rules-engine-bridge.ts",
    "src/route-catalogs/**",
    "src/routing/agrc-route-manifest.ts",
    "src/routing/agrc-routes.ts",
    "src/cross-hub/**",
    "src/agent-cooperation/conflict-detection.ts",
    "src/agent-cooperation/handoff.ts",
    "src/jobs/index.ts",
    "src/shahin-ai-asset-catalog.ts",
    "src/shahin-catalog.ts"
  ]
}