{
  "code": "vendor",
  "name": "Third-Party / Vendor Risk",
  "card_position": 9,
  "description": "Vendor due diligence, contracts, external risk.",
  "source_folders": ["vendor","vendors","vendor-hub","vendor-portal","vendor-risk-ext"],
  "lifecycle": {
    "states": [
      "create","classify","assign_owner","raci_map","risk_compliance_link",
      "workflow_approval","evidence_attach","monitor","exception_or_issue",
      "remediate","retest_review","close","archive"
    ],
    "transitions": [
      { "from": "create",                "to": "classify",            "trigger": "submitted" },
      { "from": "classify",              "to": "assign_owner",        "trigger": "classified" },
      { "from": "assign_owner",          "to": "raci_map",            "trigger": "owner_assigned",        "guard_permission": "vendor.record.write" },
      { "from": "raci_map",              "to": "risk_compliance_link","trigger": "raci_set" },
      { "from": "risk_compliance_link",  "to": "workflow_approval",   "trigger": "linked" },
      { "from": "workflow_approval",     "to": "evidence_attach",     "trigger": "approved",              "guard_permission": "vendor.record.approve" },
      { "from": "evidence_attach",       "to": "monitor",             "trigger": "evidence_attached",     "guard_permission": "vendor.evidence.write" },
      { "from": "monitor",               "to": "exception_or_issue",  "trigger": "deviation_detected" },
      { "from": "exception_or_issue",    "to": "remediate",           "trigger": "issue_opened" },
      { "from": "remediate",             "to": "retest_review",       "trigger": "remediation_done" },
      { "from": "retest_review",         "to": "close",               "trigger": "retest_passed" },
      { "from": "close",                 "to": "archive",             "trigger": "retention_elapsed",     "guard_permission": "vendor.record.manage" }
    ]
  },
  "workflow_hooks": [
    { "event": "submitted",            "workflow": "vendor.intake_review",      "sla_hours": 24 },
    { "event": "owner_assigned",       "workflow": "vendor.owner_acknowledge",  "sla_hours": 48 },
    { "event": "approved",             "workflow": "vendor.post_approval",      "sla_hours": 8 },
    { "event": "deviation_detected",   "workflow": "vendor.deviation_triage",   "sla_hours": 12 },
    { "event": "remediation_done",     "workflow": "vendor.retest_review",      "sla_hours": 72 }
  ],
  "owner_role": {
    "accountable": "vendor.executive_owner",
    "responsible": "vendor.module_lead"
  },
  "raci": {
    "responsible": ["vendor.module_lead", "vendor.contributor"],
    "accountable":  "vendor.executive_owner",
    "consulted":  ["vendor.approver", "governance.module_lead"],
    "informed":   ["vendor.viewer", "audit.module_lead"]
  },
  "org_scope": ["org","business_unit","department","team","position","own"],
  "permissions": [
    "record.read","record.write","record.approve","record.manage",
    "record.delete","record.configure",
    "evidence.read","evidence.write",
    "report.read","export"
  ],
  "roles": {
    "executive_owner": { "permissions": [
      "record.read","record.write","record.approve","record.manage",
      "record.delete","record.configure",
      "evidence.read","evidence.write","report.read","export"
    ] },
    "module_lead":    { "permissions": [
      "record.read","record.write","record.approve","record.manage",
      "record.configure","evidence.read","evidence.write","report.read","export"
    ] },
    "approver":       { "permissions": [
      "record.read","record.write","record.approve",
      "evidence.read","report.read"
    ] },
    "contributor":    { "permissions": [
      "record.read","record.write",
      "evidence.read","evidence.write","report.read"
    ] },
    "viewer":         { "permissions": [
      "record.read","evidence.read","report.read"
    ] }
  },
  "evidence_hooks": [
    { "state": "evidence_attach", "evidence_type": "primary_artifact", "required": true,  "expiry_days": 365 },
    { "state": "remediate",       "evidence_type": "remediation_proof", "required": true,  "expiry_days": 365 },
    { "state": "retest_review",   "evidence_type": "retest_result",     "required": true,  "expiry_days": 365 },
    { "state": "monitor",         "evidence_type": "monitoring_log",    "required": false, "expiry_days": 180 }
  ],
  "audit_events": [
    { "event": "vendor.record.created",   "category": "create",    "fields_logged": ["id","tenant_id","actor_id","scope"] },
    { "event": "vendor.record.updated",   "category": "update",    "fields_logged": ["id","actor_id","field_diff"] },
    { "event": "vendor.record.approved",  "category": "approve",   "fields_logged": ["id","approver_id","decision","comment"] },
    { "event": "vendor.record.deleted",   "category": "delete",    "fields_logged": ["id","actor_id","reason"] },
    { "event": "vendor.record.exported",  "category": "export",    "fields_logged": ["id","actor_id","format","filter"] },
    { "event": "vendor.record.viewed",    "category": "access",    "fields_logged": ["id","actor_id"] },
    { "event": "vendor.record.configured","category": "configure", "fields_logged": ["actor_id","config_diff"] }
  ],
  "reporting": {
    "kpis": [
      { "code": "vendor.coverage_pct",      "name": "Coverage %"                 },
      { "code": "vendor.on_time_closure",   "name": "On-time closure rate"       },
      { "code": "vendor.avg_cycle_hours",   "name": "Average cycle time (hours)" }
    ],
    "kris": [
      { "code": "vendor.overdue_count",     "name": "Overdue items"              },
      { "code": "vendor.exception_rate",    "name": "Exception rate"             }
    ],
    "exec_pack_section": "Third-Party / Vendor Risk"
  },
  "consumes": ["foundation","risk","compliance"]
}
