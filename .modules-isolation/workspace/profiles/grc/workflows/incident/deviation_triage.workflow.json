{
  "id": "incident.deviation_triage",
  "module": "incident",
  "hook": "deviation_triage",
  "version": "1.0.0",
  "sla_hours": 12,
  "actor_role_default": "incident.module_lead",
  "states": ["detected","triaged","routed"],
  "initial": "detected",
  "transitions": [{"from":"detected","to":"triaged","on":"triage","actor_role":"incident.module_lead"},{"from":"triaged","to":"routed","on":"route","actor_role":"incident.approver"}],
  "audit_event_prefix": "incident.workflow.deviation_triage",
  "notification_targets": ["incident.module_lead", "incident.approver"],
  "evidence_required_on": ["passed","published"],
  "escalation": { "on": "sla_breach", "to": "incident.executive_owner", "after_hours": 24 }
}
