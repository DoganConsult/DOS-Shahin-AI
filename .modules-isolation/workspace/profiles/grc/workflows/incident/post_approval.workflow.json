{
  "id": "incident.post_approval",
  "module": "incident",
  "hook": "post_approval",
  "version": "1.0.0",
  "sla_hours": 8,
  "actor_role_default": "incident.module_lead",
  "states": ["approved","published","notified"],
  "initial": "approved",
  "transitions": [{"from":"approved","to":"published","on":"publish","actor_role":"incident.module_lead"},{"from":"published","to":"notified","on":"notify"}],
  "audit_event_prefix": "incident.workflow.post_approval",
  "notification_targets": ["incident.module_lead", "incident.approver"],
  "evidence_required_on": ["passed","published"],
  "escalation": { "on": "sla_breach", "to": "incident.executive_owner", "after_hours": 16 }
}
