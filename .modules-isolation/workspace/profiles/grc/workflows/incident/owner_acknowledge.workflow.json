{
  "id": "incident.owner_acknowledge",
  "module": "incident",
  "hook": "owner_acknowledge",
  "version": "1.0.0",
  "sla_hours": 48,
  "actor_role_default": "incident.module_lead",
  "states": ["pending","acknowledged","escalated"],
  "initial": "pending",
  "transitions": [{"from":"pending","to":"acknowledged","on":"ack","actor_role":"incident.module_lead"},{"from":"pending","to":"escalated","on":"sla_breach","actor_role":"incident.executive_owner"}],
  "audit_event_prefix": "incident.workflow.owner_acknowledge",
  "notification_targets": ["incident.module_lead", "incident.approver"],
  "evidence_required_on": ["passed","published"],
  "escalation": { "on": "sla_breach", "to": "incident.executive_owner", "after_hours": 96 }
}
