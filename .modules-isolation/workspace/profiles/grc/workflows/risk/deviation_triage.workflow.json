{
  "id": "risk.deviation_triage",
  "module": "risk",
  "hook": "deviation_triage",
  "version": "1.0.0",
  "sla_hours": 12,
  "actor_role_default": "risk.module_lead",
  "states": ["detected","triaged","routed"],
  "initial": "detected",
  "transitions": [{"from":"detected","to":"triaged","on":"triage","actor_role":"risk.module_lead"},{"from":"triaged","to":"routed","on":"route","actor_role":"risk.approver"}],
  "audit_event_prefix": "risk.workflow.deviation_triage",
  "notification_targets": ["risk.module_lead", "risk.approver"],
  "evidence_required_on": ["passed","published"],
  "escalation": { "on": "sla_breach", "to": "risk.executive_owner", "after_hours": 24 }
}
