{
  "id": "risk.intake_review",
  "module": "risk",
  "hook": "intake_review",
  "version": "1.0.0",
  "sla_hours": 24,
  "actor_role_default": "risk.module_lead",
  "states": ["draft","triage","classified"],
  "initial": "draft",
  "transitions": [{"from":"draft","to":"triage","on":"submit"},{"from":"triage","to":"classified","on":"classify","actor_role":"risk.module_lead"}],
  "audit_event_prefix": "risk.workflow.intake_review",
  "notification_targets": ["risk.module_lead", "risk.approver"],
  "evidence_required_on": ["passed","published"],
  "escalation": { "on": "sla_breach", "to": "risk.executive_owner", "after_hours": 48 }
}
