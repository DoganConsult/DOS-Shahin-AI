{
  "id": "policy.deviation_triage",
  "module": "policy",
  "hook": "deviation_triage",
  "version": "1.0.0",
  "sla_hours": 12,
  "actor_role_default": "policy.module_lead",
  "states": ["detected","triaged","routed"],
  "initial": "detected",
  "transitions": [{"from":"detected","to":"triaged","on":"triage","actor_role":"policy.module_lead"},{"from":"triaged","to":"routed","on":"route","actor_role":"policy.approver"}],
  "audit_event_prefix": "policy.workflow.deviation_triage",
  "notification_targets": ["policy.module_lead", "policy.approver"],
  "evidence_required_on": ["passed","published"],
  "escalation": { "on": "sla_breach", "to": "policy.executive_owner", "after_hours": 24 }
}
