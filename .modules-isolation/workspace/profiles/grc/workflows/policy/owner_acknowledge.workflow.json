{
  "id": "policy.owner_acknowledge",
  "module": "policy",
  "hook": "owner_acknowledge",
  "version": "1.0.0",
  "sla_hours": 48,
  "actor_role_default": "policy.module_lead",
  "states": ["pending","acknowledged","escalated"],
  "initial": "pending",
  "transitions": [{"from":"pending","to":"acknowledged","on":"ack","actor_role":"policy.module_lead"},{"from":"pending","to":"escalated","on":"sla_breach","actor_role":"policy.executive_owner"}],
  "audit_event_prefix": "policy.workflow.owner_acknowledge",
  "notification_targets": ["policy.module_lead", "policy.approver"],
  "evidence_required_on": ["passed","published"],
  "escalation": { "on": "sla_breach", "to": "policy.executive_owner", "after_hours": 96 }
}
