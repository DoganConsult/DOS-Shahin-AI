{
  "id": "policy.intake_review",
  "module": "policy",
  "hook": "intake_review",
  "version": "1.0.0",
  "sla_hours": 24,
  "actor_role_default": "policy.module_lead",
  "states": ["draft","triage","classified"],
  "initial": "draft",
  "transitions": [{"from":"draft","to":"triage","on":"submit"},{"from":"triage","to":"classified","on":"classify","actor_role":"policy.module_lead"}],
  "audit_event_prefix": "policy.workflow.intake_review",
  "notification_targets": ["policy.module_lead", "policy.approver"],
  "evidence_required_on": ["passed","published"],
  "escalation": { "on": "sla_breach", "to": "policy.executive_owner", "after_hours": 48 }
}
