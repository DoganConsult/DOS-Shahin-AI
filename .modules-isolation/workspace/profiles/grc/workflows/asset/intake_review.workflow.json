{
  "id": "asset.intake_review",
  "module": "asset",
  "hook": "intake_review",
  "version": "1.0.0",
  "sla_hours": 24,
  "actor_role_default": "asset.module_lead",
  "states": ["draft","triage","classified"],
  "initial": "draft",
  "transitions": [{"from":"draft","to":"triage","on":"submit"},{"from":"triage","to":"classified","on":"classify","actor_role":"asset.module_lead"}],
  "audit_event_prefix": "asset.workflow.intake_review",
  "notification_targets": ["asset.module_lead", "asset.approver"],
  "evidence_required_on": ["passed","published"],
  "escalation": { "on": "sla_breach", "to": "asset.executive_owner", "after_hours": 48 }
}
