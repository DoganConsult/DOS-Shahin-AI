{
  "id": "controls.post_approval",
  "module": "controls",
  "hook": "post_approval",
  "version": "1.0.0",
  "sla_hours": 8,
  "actor_role_default": "controls.module_lead",
  "states": ["approved","published","notified"],
  "initial": "approved",
  "transitions": [{"from":"approved","to":"published","on":"publish","actor_role":"controls.module_lead"},{"from":"published","to":"notified","on":"notify"}],
  "audit_event_prefix": "controls.workflow.post_approval",
  "notification_targets": ["controls.module_lead", "controls.approver"],
  "evidence_required_on": ["passed","published"],
  "escalation": { "on": "sla_breach", "to": "controls.executive_owner", "after_hours": 16 }
}
