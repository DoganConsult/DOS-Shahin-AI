{
  "id": "controls.retest_review",
  "module": "controls",
  "hook": "retest_review",
  "version": "1.0.0",
  "sla_hours": 72,
  "actor_role_default": "controls.module_lead",
  "states": ["ready","retesting","passed","failed"],
  "initial": "ready",
  "transitions": [{"from":"ready","to":"retesting","on":"start_retest"},{"from":"retesting","to":"passed","on":"pass","actor_role":"controls.approver"},{"from":"retesting","to":"failed","on":"fail","actor_role":"controls.approver"}],
  "audit_event_prefix": "controls.workflow.retest_review",
  "notification_targets": ["controls.module_lead", "controls.approver"],
  "evidence_required_on": ["passed","published"],
  "escalation": { "on": "sla_breach", "to": "controls.executive_owner", "after_hours": 144 }
}
