{
  "id": "reporting.retest_review",
  "module": "reporting",
  "hook": "retest_review",
  "version": "1.0.0",
  "sla_hours": 72,
  "actor_role_default": "reporting.module_lead",
  "states": ["ready","retesting","passed","failed"],
  "initial": "ready",
  "transitions": [{"from":"ready","to":"retesting","on":"start_retest"},{"from":"retesting","to":"passed","on":"pass","actor_role":"reporting.approver"},{"from":"retesting","to":"failed","on":"fail","actor_role":"reporting.approver"}],
  "audit_event_prefix": "reporting.workflow.retest_review",
  "notification_targets": ["reporting.module_lead", "reporting.approver"],
  "evidence_required_on": ["passed","published"],
  "escalation": { "on": "sla_breach", "to": "reporting.executive_owner", "after_hours": 144 }
}
