{
  "id": "reporting.owner_acknowledge",
  "module": "reporting",
  "hook": "owner_acknowledge",
  "version": "1.0.0",
  "sla_hours": 48,
  "actor_role_default": "reporting.module_lead",
  "states": ["pending","acknowledged","escalated"],
  "initial": "pending",
  "transitions": [{"from":"pending","to":"acknowledged","on":"ack","actor_role":"reporting.module_lead"},{"from":"pending","to":"escalated","on":"sla_breach","actor_role":"reporting.executive_owner"}],
  "audit_event_prefix": "reporting.workflow.owner_acknowledge",
  "notification_targets": ["reporting.module_lead", "reporting.approver"],
  "evidence_required_on": ["passed","published"],
  "escalation": { "on": "sla_breach", "to": "reporting.executive_owner", "after_hours": 96 }
}
