{
  "id": "reporting.intake_review",
  "module": "reporting",
  "hook": "intake_review",
  "version": "1.0.0",
  "sla_hours": 24,
  "actor_role_default": "reporting.module_lead",
  "states": ["draft","triage","classified"],
  "initial": "draft",
  "transitions": [{"from":"draft","to":"triage","on":"submit"},{"from":"triage","to":"classified","on":"classify","actor_role":"reporting.module_lead"}],
  "audit_event_prefix": "reporting.workflow.intake_review",
  "notification_targets": ["reporting.module_lead", "reporting.approver"],
  "evidence_required_on": ["passed","published"],
  "escalation": { "on": "sla_breach", "to": "reporting.executive_owner", "after_hours": 48 }
}
