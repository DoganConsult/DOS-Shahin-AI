{
  "id": "ai_governance.post_approval",
  "module": "ai_governance",
  "hook": "post_approval",
  "version": "1.0.0",
  "sla_hours": 8,
  "actor_role_default": "ai_governance.module_lead",
  "states": ["approved","published","notified"],
  "initial": "approved",
  "transitions": [{"from":"approved","to":"published","on":"publish","actor_role":"ai_governance.module_lead"},{"from":"published","to":"notified","on":"notify"}],
  "audit_event_prefix": "ai_governance.workflow.post_approval",
  "notification_targets": ["ai_governance.module_lead", "ai_governance.approver"],
  "evidence_required_on": ["passed","published"],
  "escalation": { "on": "sla_breach", "to": "ai_governance.executive_owner", "after_hours": 16 }
}
