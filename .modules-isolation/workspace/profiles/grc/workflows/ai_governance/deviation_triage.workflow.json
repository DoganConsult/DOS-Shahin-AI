{
  "id": "ai_governance.deviation_triage",
  "module": "ai_governance",
  "hook": "deviation_triage",
  "version": "1.0.0",
  "sla_hours": 12,
  "actor_role_default": "ai_governance.module_lead",
  "states": ["detected","triaged","routed"],
  "initial": "detected",
  "transitions": [{"from":"detected","to":"triaged","on":"triage","actor_role":"ai_governance.module_lead"},{"from":"triaged","to":"routed","on":"route","actor_role":"ai_governance.approver"}],
  "audit_event_prefix": "ai_governance.workflow.deviation_triage",
  "notification_targets": ["ai_governance.module_lead", "ai_governance.approver"],
  "evidence_required_on": ["passed","published"],
  "escalation": { "on": "sla_breach", "to": "ai_governance.executive_owner", "after_hours": 24 }
}
