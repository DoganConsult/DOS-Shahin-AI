{
  "id": "ai_governance.owner_acknowledge",
  "module": "ai_governance",
  "hook": "owner_acknowledge",
  "version": "1.0.0",
  "sla_hours": 48,
  "actor_role_default": "ai_governance.module_lead",
  "states": ["pending","acknowledged","escalated"],
  "initial": "pending",
  "transitions": [{"from":"pending","to":"acknowledged","on":"ack","actor_role":"ai_governance.module_lead"},{"from":"pending","to":"escalated","on":"sla_breach","actor_role":"ai_governance.executive_owner"}],
  "audit_event_prefix": "ai_governance.workflow.owner_acknowledge",
  "notification_targets": ["ai_governance.module_lead", "ai_governance.approver"],
  "evidence_required_on": ["passed","published"],
  "escalation": { "on": "sla_breach", "to": "ai_governance.executive_owner", "after_hours": 96 }
}
