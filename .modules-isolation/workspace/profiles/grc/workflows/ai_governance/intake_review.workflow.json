{
  "id": "ai_governance.intake_review",
  "module": "ai_governance",
  "hook": "intake_review",
  "version": "1.0.0",
  "sla_hours": 24,
  "actor_role_default": "ai_governance.module_lead",
  "states": ["draft","triage","classified"],
  "initial": "draft",
  "transitions": [{"from":"draft","to":"triage","on":"submit"},{"from":"triage","to":"classified","on":"classify","actor_role":"ai_governance.module_lead"}],
  "audit_event_prefix": "ai_governance.workflow.intake_review",
  "notification_targets": ["ai_governance.module_lead", "ai_governance.approver"],
  "evidence_required_on": ["passed","published"],
  "escalation": { "on": "sla_breach", "to": "ai_governance.executive_owner", "after_hours": 48 }
}
