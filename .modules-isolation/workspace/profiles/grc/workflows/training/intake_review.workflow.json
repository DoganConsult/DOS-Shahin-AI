{
  "id": "training.intake_review",
  "module": "training",
  "hook": "intake_review",
  "version": "1.0.0",
  "sla_hours": 24,
  "actor_role_default": "training.module_lead",
  "states": ["draft","triage","classified"],
  "initial": "draft",
  "transitions": [{"from":"draft","to":"triage","on":"submit"},{"from":"triage","to":"classified","on":"classify","actor_role":"training.module_lead"}],
  "audit_event_prefix": "training.workflow.intake_review",
  "notification_targets": ["training.module_lead", "training.approver"],
  "evidence_required_on": ["passed","published"],
  "escalation": { "on": "sla_breach", "to": "training.executive_owner", "after_hours": 48 }
}
