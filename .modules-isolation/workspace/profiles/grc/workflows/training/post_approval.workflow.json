{
  "id": "training.post_approval",
  "module": "training",
  "hook": "post_approval",
  "version": "1.0.0",
  "sla_hours": 8,
  "actor_role_default": "training.module_lead",
  "states": ["approved","published","notified"],
  "initial": "approved",
  "transitions": [{"from":"approved","to":"published","on":"publish","actor_role":"training.module_lead"},{"from":"published","to":"notified","on":"notify"}],
  "audit_event_prefix": "training.workflow.post_approval",
  "notification_targets": ["training.module_lead", "training.approver"],
  "evidence_required_on": ["passed","published"],
  "escalation": { "on": "sla_breach", "to": "training.executive_owner", "after_hours": 16 }
}
