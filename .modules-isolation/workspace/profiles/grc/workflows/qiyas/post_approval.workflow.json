{
  "id": "qiyas.post_approval",
  "module": "qiyas",
  "hook": "post_approval",
  "version": "1.0.0",
  "sla_hours": 8,
  "actor_role_default": "qiyas.module_lead",
  "states": ["approved","published","notified"],
  "initial": "approved",
  "transitions": [{"from":"approved","to":"published","on":"publish","actor_role":"qiyas.module_lead"},{"from":"published","to":"notified","on":"notify"}],
  "audit_event_prefix": "qiyas.workflow.post_approval",
  "notification_targets": ["qiyas.module_lead", "qiyas.approver"],
  "evidence_required_on": ["passed","published"],
  "escalation": { "on": "sla_breach", "to": "qiyas.executive_owner", "after_hours": 16 }
}
