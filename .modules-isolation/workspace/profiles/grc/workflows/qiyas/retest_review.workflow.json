{
  "id": "qiyas.retest_review",
  "module": "qiyas",
  "hook": "retest_review",
  "version": "1.0.0",
  "sla_hours": 72,
  "actor_role_default": "qiyas.module_lead",
  "states": ["ready","retesting","passed","failed"],
  "initial": "ready",
  "transitions": [{"from":"ready","to":"retesting","on":"start_retest"},{"from":"retesting","to":"passed","on":"pass","actor_role":"qiyas.approver"},{"from":"retesting","to":"failed","on":"fail","actor_role":"qiyas.approver"}],
  "audit_event_prefix": "qiyas.workflow.retest_review",
  "notification_targets": ["qiyas.module_lead", "qiyas.approver"],
  "evidence_required_on": ["passed","published"],
  "escalation": { "on": "sla_breach", "to": "qiyas.executive_owner", "after_hours": 144 }
}
