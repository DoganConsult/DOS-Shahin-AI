{
  "id": "qiyas.intake_review",
  "module": "qiyas",
  "hook": "intake_review",
  "version": "1.0.0",
  "sla_hours": 24,
  "actor_role_default": "qiyas.module_lead",
  "states": ["draft","triage","classified"],
  "initial": "draft",
  "transitions": [{"from":"draft","to":"triage","on":"submit"},{"from":"triage","to":"classified","on":"classify","actor_role":"qiyas.module_lead"}],
  "audit_event_prefix": "qiyas.workflow.intake_review",
  "notification_targets": ["qiyas.module_lead", "qiyas.approver"],
  "evidence_required_on": ["passed","published"],
  "escalation": { "on": "sla_breach", "to": "qiyas.executive_owner", "after_hours": 48 }
}
