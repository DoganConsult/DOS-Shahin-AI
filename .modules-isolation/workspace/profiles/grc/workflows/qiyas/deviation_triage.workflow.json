{
  "id": "qiyas.deviation_triage",
  "module": "qiyas",
  "hook": "deviation_triage",
  "version": "1.0.0",
  "sla_hours": 12,
  "actor_role_default": "qiyas.module_lead",
  "states": ["detected","triaged","routed"],
  "initial": "detected",
  "transitions": [{"from":"detected","to":"triaged","on":"triage","actor_role":"qiyas.module_lead"},{"from":"triaged","to":"routed","on":"route","actor_role":"qiyas.approver"}],
  "audit_event_prefix": "qiyas.workflow.deviation_triage",
  "notification_targets": ["qiyas.module_lead", "qiyas.approver"],
  "evidence_required_on": ["passed","published"],
  "escalation": { "on": "sla_breach", "to": "qiyas.executive_owner", "after_hours": 24 }
}
