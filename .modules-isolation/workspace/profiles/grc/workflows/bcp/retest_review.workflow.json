{
  "id": "bcp.retest_review",
  "module": "bcp",
  "hook": "retest_review",
  "version": "1.0.0",
  "sla_hours": 72,
  "actor_role_default": "bcp.module_lead",
  "states": ["ready","retesting","passed","failed"],
  "initial": "ready",
  "transitions": [{"from":"ready","to":"retesting","on":"start_retest"},{"from":"retesting","to":"passed","on":"pass","actor_role":"bcp.approver"},{"from":"retesting","to":"failed","on":"fail","actor_role":"bcp.approver"}],
  "audit_event_prefix": "bcp.workflow.retest_review",
  "notification_targets": ["bcp.module_lead", "bcp.approver"],
  "evidence_required_on": ["passed","published"],
  "escalation": { "on": "sla_breach", "to": "bcp.executive_owner", "after_hours": 144 }
}
