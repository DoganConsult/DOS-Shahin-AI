{
  "id": "bcp.intake_review",
  "module": "bcp",
  "hook": "intake_review",
  "version": "1.0.0",
  "sla_hours": 24,
  "actor_role_default": "bcp.module_lead",
  "states": ["draft","triage","classified"],
  "initial": "draft",
  "transitions": [{"from":"draft","to":"triage","on":"submit"},{"from":"triage","to":"classified","on":"classify","actor_role":"bcp.module_lead"}],
  "audit_event_prefix": "bcp.workflow.intake_review",
  "notification_targets": ["bcp.module_lead", "bcp.approver"],
  "evidence_required_on": ["passed","published"],
  "escalation": { "on": "sla_breach", "to": "bcp.executive_owner", "after_hours": 48 }
}
