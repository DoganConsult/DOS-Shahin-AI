{
  "id": "regulatory.deviation_triage",
  "module": "regulatory",
  "hook": "deviation_triage",
  "version": "1.0.0",
  "sla_hours": 12,
  "actor_role_default": "regulatory.module_lead",
  "states": ["detected","triaged","routed"],
  "initial": "detected",
  "transitions": [{"from":"detected","to":"triaged","on":"triage","actor_role":"regulatory.module_lead"},{"from":"triaged","to":"routed","on":"route","actor_role":"regulatory.approver"}],
  "audit_event_prefix": "regulatory.workflow.deviation_triage",
  "notification_targets": ["regulatory.module_lead", "regulatory.approver"],
  "evidence_required_on": ["passed","published"],
  "escalation": { "on": "sla_breach", "to": "regulatory.executive_owner", "after_hours": 24 }
}
