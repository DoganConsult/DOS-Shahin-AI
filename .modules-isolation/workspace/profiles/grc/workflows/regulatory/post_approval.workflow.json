{
  "id": "regulatory.post_approval",
  "module": "regulatory",
  "hook": "post_approval",
  "version": "1.0.0",
  "sla_hours": 8,
  "actor_role_default": "regulatory.module_lead",
  "states": ["approved","published","notified"],
  "initial": "approved",
  "transitions": [{"from":"approved","to":"published","on":"publish","actor_role":"regulatory.module_lead"},{"from":"published","to":"notified","on":"notify"}],
  "audit_event_prefix": "regulatory.workflow.post_approval",
  "notification_targets": ["regulatory.module_lead", "regulatory.approver"],
  "evidence_required_on": ["passed","published"],
  "escalation": { "on": "sla_breach", "to": "regulatory.executive_owner", "after_hours": 16 }
}
