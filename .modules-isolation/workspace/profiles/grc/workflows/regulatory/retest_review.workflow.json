{
  "id": "regulatory.retest_review",
  "module": "regulatory",
  "hook": "retest_review",
  "version": "1.0.0",
  "sla_hours": 72,
  "actor_role_default": "regulatory.module_lead",
  "states": ["ready","retesting","passed","failed"],
  "initial": "ready",
  "transitions": [{"from":"ready","to":"retesting","on":"start_retest"},{"from":"retesting","to":"passed","on":"pass","actor_role":"regulatory.approver"},{"from":"retesting","to":"failed","on":"fail","actor_role":"regulatory.approver"}],
  "audit_event_prefix": "regulatory.workflow.retest_review",
  "notification_targets": ["regulatory.module_lead", "regulatory.approver"],
  "evidence_required_on": ["passed","published"],
  "escalation": { "on": "sla_breach", "to": "regulatory.executive_owner", "after_hours": 144 }
}
