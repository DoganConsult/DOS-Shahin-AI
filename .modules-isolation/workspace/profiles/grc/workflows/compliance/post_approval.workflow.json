{
  "id": "compliance.post_approval",
  "module": "compliance",
  "hook": "post_approval",
  "version": "1.0.0",
  "sla_hours": 8,
  "actor_role_default": "compliance.module_lead",
  "states": ["approved","published","notified"],
  "initial": "approved",
  "transitions": [{"from":"approved","to":"published","on":"publish","actor_role":"compliance.module_lead"},{"from":"published","to":"notified","on":"notify"}],
  "audit_event_prefix": "compliance.workflow.post_approval",
  "notification_targets": ["compliance.module_lead", "compliance.approver"],
  "evidence_required_on": ["passed","published"],
  "escalation": { "on": "sla_breach", "to": "compliance.executive_owner", "after_hours": 16 }
}
