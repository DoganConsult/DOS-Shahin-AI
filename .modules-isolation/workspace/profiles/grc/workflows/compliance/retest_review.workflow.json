{
  "id": "compliance.retest_review",
  "module": "compliance",
  "hook": "retest_review",
  "version": "1.0.0",
  "sla_hours": 72,
  "actor_role_default": "compliance.module_lead",
  "states": ["ready","retesting","passed","failed"],
  "initial": "ready",
  "transitions": [{"from":"ready","to":"retesting","on":"start_retest"},{"from":"retesting","to":"passed","on":"pass","actor_role":"compliance.approver"},{"from":"retesting","to":"failed","on":"fail","actor_role":"compliance.approver"}],
  "audit_event_prefix": "compliance.workflow.retest_review",
  "notification_targets": ["compliance.module_lead", "compliance.approver"],
  "evidence_required_on": ["passed","published"],
  "escalation": { "on": "sla_breach", "to": "compliance.executive_owner", "after_hours": 144 }
}
