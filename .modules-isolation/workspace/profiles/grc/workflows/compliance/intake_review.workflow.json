{
  "id": "compliance.intake_review",
  "module": "compliance",
  "hook": "intake_review",
  "version": "1.0.0",
  "sla_hours": 24,
  "actor_role_default": "compliance.module_lead",
  "states": ["draft","triage","classified"],
  "initial": "draft",
  "transitions": [{"from":"draft","to":"triage","on":"submit"},{"from":"triage","to":"classified","on":"classify","actor_role":"compliance.module_lead"}],
  "audit_event_prefix": "compliance.workflow.intake_review",
  "notification_targets": ["compliance.module_lead", "compliance.approver"],
  "evidence_required_on": ["passed","published"],
  "escalation": { "on": "sla_breach", "to": "compliance.executive_owner", "after_hours": 48 }
}
