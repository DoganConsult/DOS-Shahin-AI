{
  "id": "evidence.intake_review",
  "module": "evidence",
  "hook": "intake_review",
  "version": "1.0.0",
  "sla_hours": 24,
  "actor_role_default": "evidence.module_lead",
  "states": ["draft","triage","classified"],
  "initial": "draft",
  "transitions": [{"from":"draft","to":"triage","on":"submit"},{"from":"triage","to":"classified","on":"classify","actor_role":"evidence.module_lead"}],
  "audit_event_prefix": "evidence.workflow.intake_review",
  "notification_targets": ["evidence.module_lead", "evidence.approver"],
  "evidence_required_on": ["passed","published"],
  "escalation": { "on": "sla_breach", "to": "evidence.executive_owner", "after_hours": 48 }
}
