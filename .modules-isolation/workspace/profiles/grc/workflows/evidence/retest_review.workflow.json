{
  "id": "evidence.retest_review",
  "module": "evidence",
  "hook": "retest_review",
  "version": "1.0.0",
  "sla_hours": 72,
  "actor_role_default": "evidence.module_lead",
  "states": ["ready","retesting","passed","failed"],
  "initial": "ready",
  "transitions": [{"from":"ready","to":"retesting","on":"start_retest"},{"from":"retesting","to":"passed","on":"pass","actor_role":"evidence.approver"},{"from":"retesting","to":"failed","on":"fail","actor_role":"evidence.approver"}],
  "audit_event_prefix": "evidence.workflow.retest_review",
  "notification_targets": ["evidence.module_lead", "evidence.approver"],
  "evidence_required_on": ["passed","published"],
  "escalation": { "on": "sla_breach", "to": "evidence.executive_owner", "after_hours": 144 }
}
