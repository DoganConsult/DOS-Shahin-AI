{
  "id": "evidence.post_approval",
  "module": "evidence",
  "hook": "post_approval",
  "version": "1.0.0",
  "sla_hours": 8,
  "actor_role_default": "evidence.module_lead",
  "states": ["approved","published","notified"],
  "initial": "approved",
  "transitions": [{"from":"approved","to":"published","on":"publish","actor_role":"evidence.module_lead"},{"from":"published","to":"notified","on":"notify"}],
  "audit_event_prefix": "evidence.workflow.post_approval",
  "notification_targets": ["evidence.module_lead", "evidence.approver"],
  "evidence_required_on": ["passed","published"],
  "escalation": { "on": "sla_breach", "to": "evidence.executive_owner", "after_hours": 16 }
}
