{
  "id": "evidence.owner_acknowledge",
  "module": "evidence",
  "hook": "owner_acknowledge",
  "version": "1.0.0",
  "sla_hours": 48,
  "actor_role_default": "evidence.module_lead",
  "states": ["pending","acknowledged","escalated"],
  "initial": "pending",
  "transitions": [{"from":"pending","to":"acknowledged","on":"ack","actor_role":"evidence.module_lead"},{"from":"pending","to":"escalated","on":"sla_breach","actor_role":"evidence.executive_owner"}],
  "audit_event_prefix": "evidence.workflow.owner_acknowledge",
  "notification_targets": ["evidence.module_lead", "evidence.approver"],
  "evidence_required_on": ["passed","published"],
  "escalation": { "on": "sla_breach", "to": "evidence.executive_owner", "after_hours": 96 }
}
