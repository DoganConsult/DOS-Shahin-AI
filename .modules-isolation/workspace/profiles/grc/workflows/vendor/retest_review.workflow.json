{
  "id": "vendor.retest_review",
  "module": "vendor",
  "hook": "retest_review",
  "version": "1.0.0",
  "sla_hours": 72,
  "actor_role_default": "vendor.module_lead",
  "states": ["ready","retesting","passed","failed"],
  "initial": "ready",
  "transitions": [{"from":"ready","to":"retesting","on":"start_retest"},{"from":"retesting","to":"passed","on":"pass","actor_role":"vendor.approver"},{"from":"retesting","to":"failed","on":"fail","actor_role":"vendor.approver"}],
  "audit_event_prefix": "vendor.workflow.retest_review",
  "notification_targets": ["vendor.module_lead", "vendor.approver"],
  "evidence_required_on": ["passed","published"],
  "escalation": { "on": "sla_breach", "to": "vendor.executive_owner", "after_hours": 144 }
}
