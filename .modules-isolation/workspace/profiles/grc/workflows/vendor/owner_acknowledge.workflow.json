{
  "id": "vendor.owner_acknowledge",
  "module": "vendor",
  "hook": "owner_acknowledge",
  "version": "1.0.0",
  "sla_hours": 48,
  "actor_role_default": "vendor.module_lead",
  "states": ["pending","acknowledged","escalated"],
  "initial": "pending",
  "transitions": [{"from":"pending","to":"acknowledged","on":"ack","actor_role":"vendor.module_lead"},{"from":"pending","to":"escalated","on":"sla_breach","actor_role":"vendor.executive_owner"}],
  "audit_event_prefix": "vendor.workflow.owner_acknowledge",
  "notification_targets": ["vendor.module_lead", "vendor.approver"],
  "evidence_required_on": ["passed","published"],
  "escalation": { "on": "sla_breach", "to": "vendor.executive_owner", "after_hours": 96 }
}
