{
  "id": "exceptions.post_approval",
  "module": "exceptions",
  "hook": "post_approval",
  "version": "1.0.0",
  "sla_hours": 8,
  "actor_role_default": "exceptions.module_lead",
  "states": ["approved","published","notified"],
  "initial": "approved",
  "transitions": [{"from":"approved","to":"published","on":"publish","actor_role":"exceptions.module_lead"},{"from":"published","to":"notified","on":"notify"}],
  "audit_event_prefix": "exceptions.workflow.post_approval",
  "notification_targets": ["exceptions.module_lead", "exceptions.approver"],
  "evidence_required_on": ["passed","published"],
  "escalation": { "on": "sla_breach", "to": "exceptions.executive_owner", "after_hours": 16 }
}
