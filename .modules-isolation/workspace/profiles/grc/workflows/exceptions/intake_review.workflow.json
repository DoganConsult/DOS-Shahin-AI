{
  "id": "exceptions.intake_review",
  "module": "exceptions",
  "hook": "intake_review",
  "version": "1.0.0",
  "sla_hours": 24,
  "actor_role_default": "exceptions.module_lead",
  "states": ["draft","triage","classified"],
  "initial": "draft",
  "transitions": [{"from":"draft","to":"triage","on":"submit"},{"from":"triage","to":"classified","on":"classify","actor_role":"exceptions.module_lead"}],
  "audit_event_prefix": "exceptions.workflow.intake_review",
  "notification_targets": ["exceptions.module_lead", "exceptions.approver"],
  "evidence_required_on": ["passed","published"],
  "escalation": { "on": "sla_breach", "to": "exceptions.executive_owner", "after_hours": 48 }
}
