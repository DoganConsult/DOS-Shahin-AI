{
  "id": "exceptions.retest_review",
  "module": "exceptions",
  "hook": "retest_review",
  "version": "1.0.0",
  "sla_hours": 72,
  "actor_role_default": "exceptions.module_lead",
  "states": ["ready","retesting","passed","failed"],
  "initial": "ready",
  "transitions": [{"from":"ready","to":"retesting","on":"start_retest"},{"from":"retesting","to":"passed","on":"pass","actor_role":"exceptions.approver"},{"from":"retesting","to":"failed","on":"fail","actor_role":"exceptions.approver"}],
  "audit_event_prefix": "exceptions.workflow.retest_review",
  "notification_targets": ["exceptions.module_lead", "exceptions.approver"],
  "evidence_required_on": ["passed","published"],
  "escalation": { "on": "sla_breach", "to": "exceptions.executive_owner", "after_hours": 144 }
}
