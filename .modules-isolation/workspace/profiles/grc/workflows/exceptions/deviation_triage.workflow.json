{
  "id": "exceptions.deviation_triage",
  "module": "exceptions",
  "hook": "deviation_triage",
  "version": "1.0.0",
  "sla_hours": 12,
  "actor_role_default": "exceptions.module_lead",
  "states": ["detected","triaged","routed"],
  "initial": "detected",
  "transitions": [{"from":"detected","to":"triaged","on":"triage","actor_role":"exceptions.module_lead"},{"from":"triaged","to":"routed","on":"route","actor_role":"exceptions.approver"}],
  "audit_event_prefix": "exceptions.workflow.deviation_triage",
  "notification_targets": ["exceptions.module_lead", "exceptions.approver"],
  "evidence_required_on": ["passed","published"],
  "escalation": { "on": "sla_breach", "to": "exceptions.executive_owner", "after_hours": 24 }
}
