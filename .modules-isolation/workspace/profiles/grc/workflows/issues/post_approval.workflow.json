{
  "id": "issues.post_approval",
  "module": "issues",
  "hook": "post_approval",
  "version": "1.0.0",
  "sla_hours": 8,
  "actor_role_default": "issues.module_lead",
  "states": ["approved","published","notified"],
  "initial": "approved",
  "transitions": [{"from":"approved","to":"published","on":"publish","actor_role":"issues.module_lead"},{"from":"published","to":"notified","on":"notify"}],
  "audit_event_prefix": "issues.workflow.post_approval",
  "notification_targets": ["issues.module_lead", "issues.approver"],
  "evidence_required_on": ["passed","published"],
  "escalation": { "on": "sla_breach", "to": "issues.executive_owner", "after_hours": 16 }
}
