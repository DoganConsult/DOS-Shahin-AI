{
  "id": "issues.retest_review",
  "module": "issues",
  "hook": "retest_review",
  "version": "1.0.0",
  "sla_hours": 72,
  "actor_role_default": "issues.module_lead",
  "states": ["ready","retesting","passed","failed"],
  "initial": "ready",
  "transitions": [{"from":"ready","to":"retesting","on":"start_retest"},{"from":"retesting","to":"passed","on":"pass","actor_role":"issues.approver"},{"from":"retesting","to":"failed","on":"fail","actor_role":"issues.approver"}],
  "audit_event_prefix": "issues.workflow.retest_review",
  "notification_targets": ["issues.module_lead", "issues.approver"],
  "evidence_required_on": ["passed","published"],
  "escalation": { "on": "sla_breach", "to": "issues.executive_owner", "after_hours": 144 }
}
