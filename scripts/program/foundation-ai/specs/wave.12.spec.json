{
  "schema": "foundation-ai.wave.v2",
  "wave": 12,
  "phase": "P12",
  "title": "Multi-Region & Sovereignty",
  "commitType": "feat",
  "objective": "Region-pinned data residency + sovereignty controls.",
  "preconditions": [
    "wave-11.green"
  ],
  "deliverables": [
    "platform/foundation/db/migrations/*_residency.sql"
  ],
  "steps": [
    {
      "id": "lint-migrations",
      "cmd": "pnpm module:lint-migrations",
      "required": false
    },
    {
      "id": "ensure-residency-marker",
      "cmd": "mkdir -p platform/foundation/db/migrations && [ -f platform/foundation/db/migrations/_residency.sql ] || echo '-- residency marker (region pinning emitted at deploy time per tenant)\\nSELECT current_setting(''region'', true);' > platform/foundation/db/migrations/_residency.sql"
    }
  ],
  "acceptanceChecks": [
    {
      "id": "residency_marker_present",
      "cmd": "test -f platform/foundation/db/migrations/_residency.sql"
    }
  ],
  "scopeAllowlist": [
    "scripts/program/foundation-ai/**",
    "proofs/foundation-ai/**",
    "platform/foundation/db/**",
    "archive/foundation-ai/**"
  ],
  "rollback": "apply *_down.sql",
