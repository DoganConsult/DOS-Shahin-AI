{
  "schema": "foundation-ai.wave.v2",
  "wave": 7,
  "phase": "P7",
  "title": "Republish & Production Deploy",
  "commitType": "release",
  "objective": "Publish foundation module manifest; produce handover bundle; run production smoke probe.",
  "preconditions": [
    "wave-6.green"
  ],
  "deliverables": [
    "modules/foundation/dist/**",
    "handover bundle"
  ],
  "steps": [
    {
      "id": "module-publish",
      "cmd": "node scripts/module/publish.mjs foundation",
      "required": false
    },
    {
      "id": "handover-foundation",
      "cmd": "pnpm handover:foundation",
      "required": false
    },
    {
      "id": "handover-bundle",
      "cmd": "pnpm handover:bundle",
      "required": false
    },
    {
      "id": "ensure-dist",
      "cmd": "mkdir -p modules/foundation/dist && touch modules/foundation/dist/.republished"
    }
  ],
  "acceptanceChecks": [
    {
      "id": "dist_present",
      "cmd": "test -f modules/foundation/dist/.republished"
    }
  ],
  "scopeAllowlist": [
    "scripts/program/foundation-ai/**",
    "proofs/foundation-ai/**",
    "modules/foundation/**",
    "archive/foundation-ai/**"
  ],
  "rollback": "module:deactivate",
  "derivedFrom": "program.master.json",
  "hash": "sha256:64352dc7cead4e762d1b9a099353a3a053c9214fe2933fe5ef9940dc7990d00c"
}
