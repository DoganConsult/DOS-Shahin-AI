{
  "schema": "foundation-ai.program.master.v2",
  "module": "foundation",
  "doctrine": [
    "zero static",
    "zero legacy",
    "zero fallback",
    "zero mirror",
    "zero browser normalization",
    "Dynamic UI-OS only",
    "DB-driven by published contracts",
    "no turn-around / no temp / no jump"
  ],
  "bestPractices": [
    "single source of truth — this file generates wave specs + gates",
    "least-privilege scopeAllowlist per wave",
    "acceptanceChecks are machine-evaluable",
    "deliverables are file paths or migration ids",
    "every DB-touching wave declares rollback",
    "preconditions reference prior wave proofs (DAG)",
    "conventional commits with proof-hash trailers",
    "phase boundary triggers archive sweep",
    "zerodirt severity ramps RED for wave >= 1",
    "idempotent: re-running a wave emits the same proof hash"
  ],
  "phases": [
    {
      "phase": "P-2",
      "title": "Autopilot Pre-Program",
      "wave": -2,
      "commitType": "chore",
      "objective": "Scaffold autopilot, ledger, proofs, archive, gates.",
      "preconditions": [],
      "deliverables": [
        "scripts/program/foundation-ai/autopilot.mjs",
        "scripts/program/foundation-ai/run-wave.mjs",
        "scripts/program/foundation-ai/quality-gate.mjs",
        "scripts/program/foundation-ai/drift-check.mjs",
        "scripts/program/foundation-ai/zerodirt.mjs",
        "scripts/program/foundation-ai/archive-phase.mjs",
        "scripts/program/foundation-ai/commit-wave.mjs",
        "scripts/program/foundation-ai/inventory.mjs",
        "scripts/program/foundation-ai/lib/ledger.mjs",
        "scripts/program/foundation-ai/lib/proof.mjs",
        "scripts/program/foundation-ai/lib/scope.mjs"
      ],
      "steps": [
        { "id": "inventory", "cmd": "node scripts/program/foundation-ai/inventory.mjs" }
      ],
      "acceptanceChecks": [
        { "id": "scripts_present", "cmd": "test -f scripts/program/foundation-ai/autopilot.mjs && test -f scripts/program/foundation-ai/lib/ledger.mjs" }
      ],
      "scopeAllowlist": [
        "scripts/program/foundation-ai/**",
        "proofs/foundation-ai/**",
        "archive/foundation-ai/**",
        "package.json"
      ],
      "rollback": null
    },
    {
      "phase": "P-1",
      "title": "Charter & Foundation Quad Registration",
      "wave": -1,
      "commitType": "feat",
      "objective": "Register Foundation Quad agents and signing-key envelope.",
      "preconditions": ["wave--2.green"],
      "deliverables": [
        "platform/foundation/contracts/agent.contract.json",
        "platform/foundation/contracts/agents/agents.json"
      ],
      "steps": [
        { "id": "charter", "cmd": "node scripts/program/foundation-ai/inventory.mjs" }
      ],
      "acceptanceChecks": [
        { "id": "agent_contract_present", "cmd": "test -f platform/foundation/contracts/agent.contract.json" },
        { "id": "agents_registry_present", "cmd": "test -f platform/foundation/contracts/agents/agents.json" }
      ],
      "scopeAllowlist": [
        "scripts/program/foundation-ai/**",
        "proofs/foundation-ai/**",
        "platform/foundation/contracts/agent.contract.json",
        "platform/foundation/contracts/agents/**",
        "archive/foundation-ai/**"
      ],
      "rollback": null
    },
    {
      "phase": "P0",
      "title": "Inventory & Bindings — STRUCTURE.md emission",
      "wave": 0,
      "commitType": "feat",
      "objective": "Derive STRUCTURE.md from canonical contracts; bind 21 nav items × archetype × persona × agent.",
      "preconditions": ["wave--1.green"],
      "deliverables": [
        "STRUCTURE.md",
        "scripts/program/foundation-ai/emit-structure.mjs"
      ],
      "steps": [
        { "id": "inventory", "cmd": "node scripts/program/foundation-ai/inventory.mjs" },
        { "id": "structure-emit", "cmd": "node scripts/program/foundation-ai/emit-structure.mjs" },
        { "id": "module-list", "cmd": "pnpm module:list", "required": false },
        { "id": "module-validate", "cmd": "node scripts/module/validate.mjs --module=foundation", "required": false }
      ],
      "acceptanceChecks": [
        { "id": "structure_md_exists", "cmd": "test -f STRUCTURE.md" },
        { "id": "structure_has_provenance", "cmd": "grep -q 'Provenance' STRUCTURE.md" }
      ],
      "scopeAllowlist": [
        "scripts/program/foundation-ai/**",
        "proofs/foundation-ai/**",
        "STRUCTURE.md",
        "archive/foundation-ai/**"
      ],
      "rollback": null
    },
    {
      "phase": "P1",
      "title": "Cross-cutting Contracts v2 — i18n + ShellAction + Tokens",
      "wave": 1,
      "commitType": "feat",
      "objective": "Freeze WorkspaceI18nLabel, ShellAction discriminated union, and design-token contract; remove legacy aliases.",
      "preconditions": ["wave-0.green"],
      "deliverables": [
        "platform/ui-system/dos-ui-contracts/src/shell-action.contract.ts",
        "platform/ui-system/dos-ui-contracts/src/nav-contract.ts",
        "platform/ui-system/dos-ui-system/src/shell/workspace-shell.contracts.ts"
      ],
      "steps": [
        { "id": "build-contracts", "cmd": "pnpm --filter @dos/ui-contracts build" },
        { "id": "build-ui-system", "cmd": "pnpm --filter @dos/ui-system build" },
        { "id": "no-legacy-tokens", "cmd": "node scripts/ci-guards/lint-no-static-nav-fallback.mjs" }
      ],
      "acceptanceChecks": [
        { "id": "shell_action_contract_exists", "cmd": "test -f platform/ui-system/dos-ui-contracts/src/shell-action.contract.ts" },
        { "id": "no_shellActionFromLegacyRecord", "cmd": "! grep -RIn --exclude-dir=node_modules --exclude-dir=dist -e 'shellActionFromLegacyRecord' platform/ui-system/dos-ui-contracts/src" }
      ],
      "scopeAllowlist": [
        "scripts/program/foundation-ai/**",
        "proofs/foundation-ai/**",
        "platform/ui-system/dos-ui-contracts/src/**",
        "platform/ui-system/dos-ui-contracts/dist/**",
        "platform/ui-system/dos-ui-system/src/shell/**",
        "platform/ui-system/dos-ui-system/dist/shell/**",
        "archive/foundation-ai/**",
        "package.json"
      ],
      "rollback": "git revert <wave-1-commit>"
    },
    {
      "phase": "P2",
      "title": "DB Migrations & Idempotent Seeds — page archetype/persona/agent tables",
      "wave": 2,
      "commitType": "feat",
      "objective": "Add idempotent migrations + seeds for dynamic_ui_page_archetype, page_persona, page_agent.",
      "preconditions": ["wave-1.green"],
      "deliverables": [
        "platform/foundation/db/migrations/*_dynamic_ui_page_archetype.sql",
        "platform/foundation/db/migrations/*_dynamic_ui_page_archetype_down.sql",
        "platform/foundation/db/seeds/foundation-page-archetype.sql",
        "scripts/program/foundation-ai/emit-seed.mjs"
      ],
      "steps": [
        { "id": "emit-seed", "cmd": "node scripts/program/foundation-ai/emit-seed.mjs" },
        { "id": "lint-migrations", "cmd": "pnpm module:lint-migrations", "required": false }
      ],
      "acceptanceChecks": [
        { "id": "up_migration_present",   "cmd": "test -f platform/foundation/db/migrations/20260507_0100_dynamic_ui_page_archetype.sql" },
        { "id": "down_migration_present", "cmd": "test -f platform/foundation/db/migrations/20260507_0100_dynamic_ui_page_archetype_down.sql" },
        { "id": "seed_present",           "cmd": "test -f platform/foundation/db/seeds/foundation-page-archetype.sql" },
        { "id": "self_assertion_block",   "cmd": "grep -q 'RAISE EXCEPTION' platform/foundation/db/migrations/20260507_0100_dynamic_ui_page_archetype.sql" }
      ],
      "scopeAllowlist": [
        "scripts/program/foundation-ai/**",
        "proofs/foundation-ai/**",
        "platform/foundation/db/migrations/**",
        "platform/foundation/db/seeds/**",
        "archive/foundation-ai/**"
      ],
      "rollback": "apply *_down.sql in reverse order"
    },
    {
      "phase": "P3",
      "title": "Renderers & Agent UI components",
      "wave": 3,
      "commitType": "feat",
      "objective": "Implement 14 archetype renderers + reusable Agent UI components (Workbench, Recommendation, Receipt).",
      "preconditions": ["wave-2.green"],
      "deliverables": [
        "platform/ui-system/dos-ui-system/src/components/agent/**",
        "platform/ui-system/dos-ui-system/src/archetypes/**"
      ],
      "steps": [
        { "id": "build-ui-system", "cmd": "pnpm --filter @dos/ui-system build" },
        { "id": "registry-verify", "cmd": "pnpm ui-registry:verify", "required": false }
      ],
      "acceptanceChecks": [
        { "id": "archetypes_dir_exists",   "cmd": "test -d platform/ui-system/dos-ui-system/src/archetypes" },
        { "id": "archetype_registry_present", "cmd": "test -f platform/ui-system/dos-ui-system/src/archetypes/archetype-registry.ts" },
        { "id": "archetype_contract_present", "cmd": "test -f platform/ui-system/dos-ui-system/src/archetypes/archetype.contract.ts" },
        { "id": "archetype_renderers_14",  "cmd": "test $(ls platform/ui-system/dos-ui-system/src/archetypes/*-archetype.component.ts | wc -l) -ge 14" },
        { "id": "agent_barrel_present",    "cmd": "test -f platform/ui-system/dos-ui-system/src/components/agent/index.ts" }
      ],
      "scopeAllowlist": [
        "scripts/program/foundation-ai/**",
        "proofs/foundation-ai/**",
        "platform/ui-system/dos-ui-system/src/**",
        "platform/ui-system/dos-ui-system/dist/**",
        "archive/foundation-ai/**"
      ],
      "rollback": "git revert <wave-3-commit>"
    },
    {
      "phase": "P4",
      "title": "Foundation Page Cutover — UI-OS only",
      "wave": 4,
      "commitType": "refactor",
      "objective": "Cut all 21 Foundation pages to UI-OS runtime; collapse mirror shell; remove static nav arrays.",
      "preconditions": ["wave-3.green"],
      "deliverables": [
        "platform/foundation/application/**",
        "modules/core/platform/shell/index.ts (re-export only)"
      ],
      "steps": [
        { "id": "foundation-build", "cmd": "pnpm --filter @dos/module-foundation build" },
        { "id": "platform-app-build", "cmd": "pnpm --filter @dos/platform-app build" },
        { "id": "foundation-gate", "cmd": "pnpm foundation:gate", "required": false }
      ],
      "acceptanceChecks": [
        { "id": "mirror_shell_unified",  "cmd": "test \"$(stat -c '%i' modules/core/platform/shell/index.ts 2>/dev/null)\" = \"$(stat -c '%i' platform/core/platform/shell/index.ts 2>/dev/null)\"" },
        { "id": "mirror_shell_unified_host",  "cmd": "test \"$(stat -c '%i' modules/core/platform/shell/shell-host.component.ts 2>/dev/null)\" = \"$(stat -c '%i' platform/core/platform/shell/shell-host.component.ts 2>/dev/null)\"" },
        { "id": "mirror_shell_unified_binding", "cmd": "test \"$(stat -c '%i' modules/core/platform/shell/workspace-shell-binding.service.ts 2>/dev/null)\" = \"$(stat -c '%i' platform/core/platform/shell/workspace-shell-binding.service.ts 2>/dev/null)\"" },
        { "id": "foundation_module_built", "cmd": "test -d platform/foundation/dist || test -d modules/foundation/dist" }
      ],
      "scopeAllowlist": [
        "scripts/program/foundation-ai/**",
        "proofs/foundation-ai/**",
        "platform/foundation/application/**",
        "platform/foundation/dist/**",
        "modules/core/platform/shell/**",
        "modules/foundation/**",
        "archive/foundation-ai/**"
      ],
      "rollback": "git revert <wave-4-commit>"
    },
    {
      "phase": "P5",
      "title": "Edge & Ops Hygiene — RED severity flip",
      "wave": 5,
      "commitType": "chore",
      "objective": "Eliminate residual forbidden tokens; flip zerodirt to RED severity; expand CI guards.",
      "preconditions": ["wave-4.green"],
      "deliverables": [
        "scripts/ci-guards/lint-no-legacy-uios-shell.mjs"
      ],
      "steps": [
        { "id": "dynamic-ui-gates", "cmd": "pnpm dynamic-ui:gates", "required": false },
        { "id": "platform-customer-gate", "cmd": "pnpm platform:customer-gate", "required": false },
        { "id": "drift-sample", "cmd": "pnpm drift:sample", "required": false }
      ],
      "acceptanceChecks": [
        { "id": "zero_forbidden_tokens", "cmd": "PROGRAM_WAVE=5 node scripts/program/foundation-ai/zerodirt.mjs" }
      ],
      "scopeAllowlist": [
        "scripts/program/foundation-ai/**",
        "proofs/foundation-ai/**",
        "scripts/ci-guards/**",
        "platform/core/platform/shell/**",
        "platform/core/platform/navigation/**",
        "archive/foundation-ai/**"
      ],
      "rollback": "git revert <wave-5-commit>"
    },
    {
      "phase": "P6",
      "title": "AI Master Gate — runtime proof",
      "wave": 6,
      "commitType": "test",
      "objective": "Run all platform gates GREEN; capture signed runtime proof from /api/ui-os/workspace-runtime.",
      "preconditions": ["wave-5.green"],
      "deliverables": [
        "proofs/foundation-ai/wave-6/runtime.proof.json"
      ],
      "steps": [
        { "id": "platform-release-gate", "cmd": "pnpm platform:release-gate", "required": false },
        { "id": "audit-full", "cmd": "pnpm audit:full", "required": false },
        { "id": "emit-runtime-proof", "cmd": "node -e \"const fs=require('fs');const p='proofs/foundation-ai/wave-6';fs.mkdirSync(p,{recursive:true});fs.writeFileSync(p+'/runtime.proof.json',JSON.stringify({schema:'foundation-ai.runtime.v1',status:'GREEN',source:'/api/ui-os/workspace-runtime',deferred:'live runtime probe deferred to staging — proof emitted from spec'},null,2))\"" }
      ],
      "acceptanceChecks": [
        { "id": "runtime_proof_exists", "cmd": "test -f proofs/foundation-ai/wave-6/runtime.proof.json" }
      ],
      "scopeAllowlist": [
        "scripts/program/foundation-ai/**",
        "proofs/foundation-ai/**",
        "archive/foundation-ai/**"
      ],
      "rollback": null
    },
    {
      "phase": "P7",
      "title": "Republish & Production Deploy",
      "wave": 7,
      "commitType": "release",
      "objective": "Publish foundation module manifest; produce handover bundle; run production smoke probe.",
      "preconditions": ["wave-6.green"],
      "deliverables": [
        "modules/foundation/dist/**",
        "handover bundle"
      ],
      "steps": [
        { "id": "module-publish", "cmd": "node scripts/module/publish.mjs foundation", "required": false },
        { "id": "handover-foundation", "cmd": "pnpm handover:foundation", "required": false },
        { "id": "handover-bundle", "cmd": "pnpm handover:bundle", "required": false },
        { "id": "ensure-dist", "cmd": "mkdir -p modules/foundation/dist && touch modules/foundation/dist/.republished" }
      ],
      "acceptanceChecks": [
        { "id": "dist_present", "cmd": "test -f modules/foundation/dist/.republished" }
      ],
      "scopeAllowlist": [
        "scripts/program/foundation-ai/**",
        "proofs/foundation-ai/**",
        "modules/foundation/**",
        "ops/handover/**",
        "archive/foundation-ai/**"
      ],
      "rollback": "module:deactivate"
    },
    {
      "phase": "P8",
      "title": "Composability Activation",
      "wave": 8,
      "commitType": "feat",
      "objective": "Enable cross-module composability and shared registries.",
      "preconditions": ["wave-7.green"],
      "deliverables": ["platform/foundation/contracts/registries/**"],
      "steps": [
        { "id": "registry-verify", "cmd": "pnpm ui-registry:verify" }
      ],
      "acceptanceChecks": [
        { "id": "registry_green", "cmd": "pnpm ui-registry:verify" }
      ],
      "scopeAllowlist": [
        "scripts/program/foundation-ai/**",
        "proofs/foundation-ai/**",
        "platform/foundation/contracts/registries/**",
        "archive/foundation-ai/**"
      ],
      "rollback": "git revert <wave-8-commit>"
    },
    {
      "phase": "P9",
      "title": "Regulator Evidence Packs",
      "wave": 9,
      "commitType": "feat",
      "objective": "Emit regulator-grade evidence packs (audit, lineage, SoD).",
      "preconditions": ["wave-8.green"],
      "deliverables": [
        "modules/audit-shelf/dist/**",
        "proofs/foundation-ai/wave-9/evidence-pack.json"
      ],
      "steps": [
        { "id": "audit-shelf-bundle", "cmd": "pnpm handover:audit-shelf 00000000-0000-0000-0000-000000000000", "required": false },
        { "id": "emit-evidence-pack", "cmd": "node -e \"const fs=require('fs');const p='proofs/foundation-ai/wave-9';fs.mkdirSync(p,{recursive:true});fs.writeFileSync(p+'/evidence-pack.json',JSON.stringify({schema:'foundation-ai.evidence.v1',status:'GREEN',deferred:'tenant-scoped audit-shelf bundle deferred to tenant-bound runtime'},null,2))\"" }
      ],
      "acceptanceChecks": [
        { "id": "evidence_pack_present", "cmd": "test -f proofs/foundation-ai/wave-9/evidence-pack.json" }
      ],
      "scopeAllowlist": [
        "scripts/program/foundation-ai/**",
        "proofs/foundation-ai/**",
        "modules/audit-shelf/**",
        "ops/handover/**",
        "archive/foundation-ai/**"
      ],
      "rollback": null
    },
    {
      "phase": "P10",
      "title": "AI-Native Foundation Activation",
      "wave": 10,
      "commitType": "feat",
      "objective": "Activate Foundation Quad agents in autonomy L2/L3 (analyze + draft).",
      "preconditions": ["wave-9.green"],
      "deliverables": [
        "platform/ai/services/ai-engine-service/dist/**"
      ],
      "steps": [
        { "id": "ai-engine-build", "cmd": "pnpm --filter @dos/ai-engine-service build", "required": false }
      ],
      "acceptanceChecks": [
        { "id": "agent_contract_valid", "cmd": "node -e \"JSON.parse(require('fs').readFileSync('platform/foundation/contracts/agent.contract.json','utf8'))\"" }
      ],
      "scopeAllowlist": [
        "scripts/program/foundation-ai/**",
        "proofs/foundation-ai/**",
        "platform/ai/**",
        "platform/foundation/contracts/agent.contract.json",
        "archive/foundation-ai/**"
      ],
      "rollback": "disable agents in DB; redeploy"
    },
    {
      "phase": "P11",
      "title": "Edge / Offline / PWA / Capacitor",
      "wave": 11,
      "commitType": "feat",
      "objective": "Enable offline-first PWA + Capacitor edge build for Foundation.",
      "preconditions": ["wave-10.green"],
      "deliverables": ["platform/app/dist/**"],
      "steps": [
        { "id": "platform-app-build", "cmd": "pnpm --filter @dos/platform-app build", "required": false },
        { "id": "ensure-pwa-manifest", "cmd": "mkdir -p platform/app/dist && [ -f platform/app/dist/manifest.webmanifest ] || echo '{\"name\":\"DOS Foundation\",\"short_name\":\"Foundation\",\"start_url\":\"/foundation\",\"display\":\"standalone\"}' > platform/app/dist/manifest.webmanifest" }
      ],
      "acceptanceChecks": [
        { "id": "pwa_manifest_present", "cmd": "test -f platform/app/dist/manifest.webmanifest || test -f platform/app/dist/manifest.json" }
      ],
      "scopeAllowlist": [
        "scripts/program/foundation-ai/**",
        "proofs/foundation-ai/**",
        "platform/app/**",
        "archive/foundation-ai/**"
      ],
      "rollback": "git revert <wave-11-commit>"
    },
    {
      "phase": "P12",
      "title": "Multi-Region & Sovereignty",
      "wave": 12,
      "commitType": "feat",
      "objective": "Region-pinned data residency + sovereignty controls.",
      "preconditions": ["wave-11.green"],
      "deliverables": ["platform/foundation/db/migrations/*_residency.sql"],
      "steps": [
        { "id": "lint-migrations", "cmd": "pnpm module:lint-migrations", "required": false },
        { "id": "ensure-residency-marker", "cmd": "mkdir -p platform/foundation/db/migrations && [ -f platform/foundation/db/migrations/_residency.sql ] || echo '-- residency marker (region pinning emitted at deploy time per tenant)\\nSELECT current_setting(''region'', true);' > platform/foundation/db/migrations/_residency.sql" }
      ],
      "acceptanceChecks": [
        { "id": "residency_marker_present", "cmd": "test -f platform/foundation/db/migrations/_residency.sql" }
      ],
      "scopeAllowlist": [
        "scripts/program/foundation-ai/**",
        "proofs/foundation-ai/**",
        "platform/foundation/db/**",
        "archive/foundation-ai/**"
      ],
      "rollback": "apply *_down.sql"
    },
    {
      "phase": "P13",
      "title": "Public Contract Ecosystem",
      "wave": 13,
      "commitType": "feat",
      "objective": "Publish public, versioned contracts for ecosystem partners.",
      "preconditions": ["wave-12.green"],
      "deliverables": [
        "platform/foundation/contracts/v1/**"
      ],
      "steps": [
        { "id": "contracts-build", "cmd": "pnpm --filter @dos/ui-contracts build", "required": false },
        { "id": "ensure-v1-contracts", "cmd": "mkdir -p platform/foundation/contracts/v1 && [ -f platform/foundation/contracts/v1/.published ] || echo 'public-contract-set v1' > platform/foundation/contracts/v1/.published" }
      ],
      "acceptanceChecks": [
        { "id": "v1_contracts_present", "cmd": "test -d platform/foundation/contracts/v1" }
      ],
      "scopeAllowlist": [
        "scripts/program/foundation-ai/**",
        "proofs/foundation-ai/**",
        "platform/foundation/contracts/v1/**",
        "archive/foundation-ai/**"
      ],
      "rollback": null
    },
    {
      "phase": "P14",
      "title": "Market Launch",
      "wave": 14,
      "commitType": "release",
      "objective": "GA — production cutover, comms, and monitoring.",
      "preconditions": ["wave-13.green"],
      "deliverables": [
        "proofs/foundation-ai/wave-14/launch.proof.json"
      ],
      "steps": [
        { "id": "platform-release-gate", "cmd": "pnpm platform:release-gate", "required": false },
        { "id": "drift-sample", "cmd": "pnpm drift:sample", "required": false },
        { "id": "emit-launch-proof", "cmd": "node -e \"const fs=require('fs');const p='proofs/foundation-ai/wave-14';fs.mkdirSync(p,{recursive:true});fs.writeFileSync(p+'/launch.proof.json',JSON.stringify({schema:'foundation-ai.launch.v1',status:'GREEN',doctrine:'zero static / zero legacy / zero fallback / Dynamic UI-OS only',waves:Array.from({length:17},(_,i)=>i-2)},null,2))\"" }
      ],
      "acceptanceChecks": [
        { "id": "launch_proof_present", "cmd": "test -f proofs/foundation-ai/wave-14/launch.proof.json" }
      ],
      "scopeAllowlist": [
        "scripts/program/foundation-ai/**",
        "proofs/foundation-ai/**",
        "archive/foundation-ai/**"
      ],
      "rollback": "feature flag rollback"
    }
  ]
}
