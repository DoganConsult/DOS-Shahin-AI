{
  "schema": "foundation-ai.wave.v2",
  "wave": 3,
  "phase": "P3",
  "title": "Renderers & Agent UI components",
  "commitType": "feat",
  "objective": "Implement 14 archetype renderers + reusable Agent UI components (Workbench, Recommendation, Receipt).",
  "preconditions": [
    "wave-2.green"
  ],
  "deliverables": [
    "platform/ui-system/dos-ui-system/src/components/agent/**",
    "platform/ui-system/dos-ui-system/src/archetypes/**"
  ],
  "steps": [
    {
      "id": "build-ui-system",
      "cmd": "pnpm --filter @dos/ui-system build"
    },
    {
      "id": "registry-verify",
      "cmd": "pnpm ui-registry:verify",
      "required": false
    }
  ],
  "acceptanceChecks": [
    {
      "id": "archetypes_dir_exists",
      "cmd": "test -d platform/ui-system/dos-ui-system/src/archetypes"
    },
    {
      "id": "archetype_registry_present",
      "cmd": "test -f platform/ui-system/dos-ui-system/src/archetypes/archetype-registry.ts"
    },
    {
      "id": "archetype_contract_present",
      "cmd": "test -f platform/ui-system/dos-ui-system/src/archetypes/archetype.contract.ts"
    },
    {
      "id": "archetype_renderers_14",
      "cmd": "test $(ls platform/ui-system/dos-ui-system/src/archetypes/*-archetype.component.ts | wc -l) -ge 14"
    },
    {
      "id": "agent_barrel_present",
      "cmd": "test -f platform/ui-system/dos-ui-system/src/components/agent/index.ts"
    }
  ],
  "scopeAllowlist": [
    "scripts/program/foundation-ai/**",
    "proofs/foundation-ai/**",
    "platform/ui-system/dos-ui-system/src/**",
    "platform/ui-system/dos-ui-system/dist/**",
    "archive/foundation-ai/**"
  ],
  "rollback": "git revert <wave-3-commit>",
  "derivedFrom": "program.master.json",
