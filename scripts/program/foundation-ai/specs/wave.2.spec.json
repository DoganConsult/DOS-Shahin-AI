{
  "schema": "foundation-ai.wave.v2",
  "wave": 2,
  "phase": "P2",
  "title": "DB Migrations & Idempotent Seeds — page archetype/persona/agent tables",
  "commitType": "feat",
  "objective": "Add idempotent migrations + seeds for dynamic_ui_page_archetype, page_persona, page_agent.",
  "preconditions": [
    "wave-1.green"
  ],
  "deliverables": [
    "platform/foundation/db/migrations/*_dynamic_ui_page_archetype.sql",
    "platform/foundation/db/migrations/*_dynamic_ui_page_archetype_down.sql",
    "platform/foundation/db/seeds/foundation-page-archetype.sql",
    "scripts/program/foundation-ai/emit-seed.mjs"
  ],
  "steps": [
    {
      "id": "emit-seed",
      "cmd": "node scripts/program/foundation-ai/emit-seed.mjs"
    },
    {
      "id": "lint-migrations",
      "cmd": "pnpm module:lint-migrations",
      "required": false
    }
  ],
  "acceptanceChecks": [
    {
      "id": "up_migration_present",
      "cmd": "test -f platform/foundation/db/migrations/20260507_0100_dynamic_ui_page_archetype.sql"
    },
    {
      "id": "down_migration_present",
      "cmd": "test -f platform/foundation/db/migrations/20260507_0100_dynamic_ui_page_archetype_down.sql"
    },
    {
      "id": "seed_present",
      "cmd": "test -f platform/foundation/db/seeds/foundation-page-archetype.sql"
    },
    {
      "id": "self_assertion_block",
      "cmd": "grep -q 'RAISE EXCEPTION' platform/foundation/db/migrations/20260507_0100_dynamic_ui_page_archetype.sql"
    }
  ],
  "scopeAllowlist": [
    "scripts/program/foundation-ai/**",
    "proofs/foundation-ai/**",
    "platform/foundation/db/migrations/**",
    "platform/foundation/db/seeds/**",
    "archive/foundation-ai/**"
  ],
  "rollback": "apply *_down.sql in reverse order",
  "derivedFrom": "program.master.json",
  "hash": "sha256:16c7257c41d506252818274dd915126f15d2da379a4d6f9a49ee935cf10ce043"
}
