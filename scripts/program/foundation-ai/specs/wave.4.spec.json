{
  "schema": "foundation-ai.wave.v2",
  "wave": 4,
  "phase": "P4",
  "title": "Foundation Page Cutover — UI-OS only",
  "commitType": "refactor",
  "objective": "Cut all 21 Foundation pages to UI-OS runtime; collapse mirror shell; remove static nav arrays.",
  "preconditions": [
    "wave-3.green"
  ],
  "deliverables": [
    "platform/foundation/application/**",
    "modules/core/platform/shell/index.ts (re-export only)"
  ],
  "steps": [
    {
      "id": "foundation-build",
      "cmd": "pnpm --filter @dos/module-foundation build"
    },
    {
      "id": "platform-app-build",
      "cmd": "pnpm --filter @dos/platform-app build"
    },
    {
      "id": "foundation-gate",
      "cmd": "pnpm foundation:gate",
      "required": false
    }
  ],
  "acceptanceChecks": [
    {
      "id": "mirror_shell_unified",
      "cmd": "test \"$(stat -c '%i' modules/core/platform/shell/index.ts 2>/dev/null)\" = \"$(stat -c '%i' platform/core/platform/shell/index.ts 2>/dev/null)\""
    },
    {
      "id": "mirror_shell_unified_host",
      "cmd": "test \"$(stat -c '%i' modules/core/platform/shell/shell-host.component.ts 2>/dev/null)\" = \"$(stat -c '%i' platform/core/platform/shell/shell-host.component.ts 2>/dev/null)\""
    },
    {
      "id": "mirror_shell_unified_binding",
      "cmd": "test \"$(stat -c '%i' modules/core/platform/shell/workspace-shell-binding.service.ts 2>/dev/null)\" = \"$(stat -c '%i' platform/core/platform/shell/workspace-shell-binding.service.ts 2>/dev/null)\""
    },
    {
      "id": "foundation_module_built",
      "cmd": "test -d platform/foundation/dist || test -d modules/foundation/dist"
    }
  ],
  "scopeAllowlist": [
    "scripts/program/foundation-ai/**",
    "proofs/foundation-ai/**",
    "platform/foundation/application/**",
    "platform/foundation/dist/**",
    "modules/core/platform/shell/**",
    "modules/foundation/**",
    "archive/foundation-ai/**"
  ],
  "rollback": "git revert <wave-4-commit>",
  "derivedFrom": "program.master.json",
  "hash": "sha256:0a1acba5a213f48f65cf04694040292276d699753fb305180796a5549bece418"
}
