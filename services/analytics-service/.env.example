# Runtime environment (development | staging | production | test)
NODE_ENV=development
# Service listen port
PORT=4024
# Structured log verbosity (fatal error warn info debug trace)
LOG_LEVEL=info

# Database
DATABASE_URL=postgresql://dos_user:password@localhost:5432/dos_platform
DB_POOL_MAX=10

# Redis
REDIS_URL=redis://localhost:6379
REDIS_PREFIX=dos:

# Inter-service URLs
AUTH_SERVICE_URL=http://127.0.0.1:4001
TENANT_SERVICE_URL=http://127.0.0.1:4002
USER_SERVICE_URL=http://127.0.0.1:4003
WORKFLOW_SERVICE_URL=http://127.0.0.1:4004
NOTIFICATION_SERVICE_URL=http://127.0.0.1:4005
AUDIT_SERVICE_URL=http://127.0.0.1:4006
AI_GATEWAY_SERVICE_URL=http://127.0.0.1:4007
GATEWAY_URL=http://127.0.0.1:4000

# Observability
# Set OTEL_TRACING_ENABLED=true and point OTEL_EXPORTER_OTLP_ENDPOINT at Jaeger
# (default local dev: http://localhost:4318/v1/traces) to get distributed traces.
OTEL_TRACING_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318/v1/traces
OTEL_SAMPLING_RATE=0.1
OTEL_ERROR_SAMPLING_RATE=1.0
OTEL_SUCCESS_SAMPLING_RATE=0.1

# ClickHouse — analytics columnar store.
# When enabled, analytics-service auto-ensures DDL on boot, starts the 5s flush
# timer, and exposes dos_clickhouse_* metrics on /metrics. Run the versioned
# migrator first with:  pnpm --filter analytics-service run migrate:clickhouse
CLICKHOUSE_ENABLED=false
CLICKHOUSE_HOST=localhost
CLICKHOUSE_PORT=8123
CLICKHOUSE_DATABASE=dos_analytics
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=
