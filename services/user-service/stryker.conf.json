{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "packageManager": "pnpm",
  "testRunner": "vitest",
  "plugins": [
    "@stryker-mutator/vitest-runner"
  ],
  "coverageAnalysis": "perTest",
  "mutate": [
    "src/domain/user.service.ts",
    "src/domain/team.service.ts",
    "src/domain/role.service.ts",
    "src/domain/role-assignment.service.ts",
    "src/domain/department.service.ts",
    "src/domain/raci.service.ts",
    "src/domain/view-preference.service.ts",
    "src/domain/contracts/user-errors.ts",
    "src/middleware/ownership.ts",
    "src/events/publisher.ts"
  ],
  "ignorePatterns": [
    "dist",
    "node_modules"
  ],
  "thresholds": {
    "high": 85,
    "low": 75,
    "break": 50
  },
  "timeoutMS": 10000,
  "concurrency": 4,
  "reporters": ["html", "clear-text", "progress"]
}
