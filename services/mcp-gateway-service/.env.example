# mcp-gateway-service — environment contract.
# Real values are injected by the secrets manager at deploy time.

NODE_ENV=production
PORT=3011
LOG_LEVEL=info

# Database — mcp_servers, mcp_sessions, mcp_audit_log live in tenant schemas
DATABASE_URL=<SET_VIA_SECRETS_MANAGER>
DB_POOL_MAX=10

# Redis (session caching)
REDIS_URL=<SET_VIA_SECRETS_MANAGER>
REDIS_PREFIX=dos:

# Inter-service URLs
AUTH_SERVICE_URL=<SET_VIA_SECRETS_MANAGER>
TENANT_SERVICE_URL=<SET_VIA_SECRETS_MANAGER>
AUDIT_SERVICE_URL=<SET_VIA_SECRETS_MANAGER>

# JWT (shared verification)
JWT_SECRET=<SET_VIA_SECRETS_MANAGER>
JWT_REFRESH_SECRET=<SET_VIA_SECRETS_MANAGER>

# Gateway → service trust
INTER_SERVICE_SECRET=<SET_VIA_SECRETS_MANAGER>

# MCP runtime
MCP_ENABLED=true
MCP_TRANSPORT=streamable-http
MCP_PORT=3011
