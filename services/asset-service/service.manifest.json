{
  "serviceCode": "asset-service",
  "displayName": "Asset Management Service",
  "layer": "domain-service",
  "ownerTeam": "product-shahin-ai",
  "runtime": "node",
  "trustZone": "tenant",
  "dependsOn": [
    "auth-service",
    "tenant-service",
    "workflow-service"
  ],
  "modules": [
    "asset"
  ],
  "apiPrefix": "/api/assets",
