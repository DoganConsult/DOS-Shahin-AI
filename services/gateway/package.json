{
  "name": "@dos/gateway",
  "version": "1.0.0",
  "description": "DOS Platform — API Gateway (clean shell). Verifies Keycloak tokens and proxies to auth-service / tenant-service. No business modules wired.",
  "private": true,
  "main": "dist/server.js",
  "type": "commonjs",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@types/ws": "^8.18.1",
    "axios": "^1.7.7",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "express": "^4.21.0",
    "helmet": "^7.1.0",
    "http-proxy-middleware": "^3.0.3",
    "ioredis": "^5.10.1",
    "jose": "^5.9.6",
    "morgan": "^1.10.0",
    "pg": "^8.13.0",
    "pino": "^9.5.0",
    "pino-http": "^10.3.0",
    "ws": "^8.20.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.7",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/morgan": "^1.9.9",
    "@types/pg": "^8.11.10",
    "vitest": "^2.1.4",
    "@types/node": "^20.16.10",
    "typescript": "5.4.5"
  }
