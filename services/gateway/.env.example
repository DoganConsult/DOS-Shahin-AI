# Runtime environment (development | staging | production | test)
NODE_ENV=development
# Service listen port
PORT=4000
# Structured log verbosity (fatal error warn info debug trace)
LOG_LEVEL=info

# Database
DATABASE_URL=postgresql://dos_user:password@localhost:5432/dos_platform
DB_POOL_MAX=10

# Redis
REDIS_URL=redis://localhost:6379
REDIS_PREFIX=dos:

# Inter-service URLs
AUTH_SERVICE_URL=http://127.0.0.1:4001
TENANT_SERVICE_URL=http://127.0.0.1:4002
USER_SERVICE_URL=http://127.0.0.1:4003
WORKFLOW_SERVICE_URL=http://127.0.0.1:4004
NOTIFICATION_SERVICE_URL=http://127.0.0.1:4005
AUDIT_SERVICE_URL=http://127.0.0.1:4006
AI_GATEWAY_SERVICE_URL=http://127.0.0.1:4007
AI_ENGINE_SERVICE_URL=http://127.0.0.1:4008
ONBOARDING_SERVICE_URL=http://127.0.0.1:4010
GOVERNANCE_POLICY_SERVICE_URL=http://127.0.0.1:4011
COMPLIANCE_CONTROLS_SERVICE_URL=http://127.0.0.1:4012
RISK_INCIDENT_SERVICE_URL=http://127.0.0.1:4013
EVIDENCE_AUDIT_REPORTING_SERVICE_URL=http://127.0.0.1:4014
VENDOR_SERVICE_URL=http://127.0.0.1:4015
ASSET_SERVICE_URL=http://127.0.0.1:4016
BCP_SERVICE_URL=http://127.0.0.1:4017
TRAINING_SERVICE_URL=http://127.0.0.1:4018
PRIVACY_SERVICE_URL=http://127.0.0.1:4019
DORA_SERVICE_URL=http://127.0.0.1:4020
REMEDIATION_ACTION_SERVICE_URL=http://127.0.0.1:4021
QIYAS_JOURNEY_SERVICE_URL=http://127.0.0.1:4022
DASHBOARD_WIDGETS_SERVICE_URL=http://127.0.0.1:4023
ANALYTICS_SERVICE_URL=http://127.0.0.1:4024
EXECUTIVE_INTELLIGENCE_SERVICE_URL=http://127.0.0.1:4025
INTEGRATIONS_SERVICE_URL=http://127.0.0.1:4026
NOTIFICATION_INBOX_SERVICE_URL=http://127.0.0.1:4027
PORTALS_SERVICE_URL=http://127.0.0.1:4028
RECORDS_SERVICE_URL=http://127.0.0.1:4029
PLATFORM_PRODUCT_SERVICE_URL=http://127.0.0.1:4030
AGRC_OS_SERVICE_URL=http://127.0.0.1:4031
GATEWAY_URL=http://127.0.0.1:4000

# Observability
OTEL_TRACING_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SAMPLING_RATE=0.1

# CORS (required — no hardcoded fallback)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:4200,http://localhost:4000

# Repo root path — used by public-content routes for static asset resolution (required)
DOS_AIO_SOURCE_ROOT=/root/DOS-AIO

# ── AI Safety Gate ──
# Wave-1 default keeps AI surfaces 404'd at the gateway. Flip to `true`
# to allow /api/copilot/*, /api/ai/*, /api/ai-engine/* to reach upstream.
# Public-safe AI surfaces (/api/copilot/public-chat, /api/public/agents/*,
# /api/public/diagnose, /api/public/sandbox/start) bypass this gate via
# AI_PUBLIC_EXEMPT_PATHS in ai-safety.middleware.ts.
AI_ENABLED=false
