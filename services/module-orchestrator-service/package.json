{
  "name": "@dos/module-orchestrator-service",
  "version": "0.1.0",
  "private": true,
  "description": "Module orchestrator: readiness verifier API, pool-keeper, capability broker. Backed by dos.module_readiness / dos.module_pool_slots / dos.module_capabilities.",
  "type": "module",
  "main": "./dist/server.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "express": "^4.21.0",
    "pg": "^8.13.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.16.10",
    "@types/pg": "^8.11.10",
    "typescript": "5.4.5"
  }
}
