{
  "name": "@dos/tenant-service",
  "version": "1.0.0",
  "description": "DOS Platform — Tenant service (clean shell). Returns the caller's tenant + profile context only. No business module endpoints.",
  "private": true,
  "main": "dist/server.js",
  "type": "commonjs",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@dos/service-bootstrap": "workspace:*",
    "express": "^4.21.0",
    "morgan": "^1.10.0",
    "pg": "^8.13.0",
    "prom-client": "^15.1.3",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/morgan": "^1.9.9",
    "@types/node": "^20.16.10",
    "@types/pg": "^8.11.10",
    "typescript": "5.4.5"
  }
}
