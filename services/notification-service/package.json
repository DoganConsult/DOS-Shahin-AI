{
  "name": "@dos/notification-service",
  "version": "0.1.0",
  "description": "DOS Platform \u2014 Notification Service",
  "private": true,
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc -p tsconfig.json && pnpm run build:copy-templates",
    "build:copy-templates": "mkdir -p dist/templates && cp -R src/templates/. dist/templates/",
    "start": "node dist/server.js",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@dos/contracts": "workspace:*",
    "@dos/dauth-shared": "workspace:*",
    "@dos/db": "workspace:*",
    "@dos/event-backbone": "workspace:*",
    "@dos/module-sdk": "workspace:*",
    "@dos/platform-core": "workspace:*",
    "@dos/runtime-config": "workspace:*",
    "@dos/service-bootstrap": "workspace:*",
    "@dos/service-client": "workspace:*",
    "@dos/types": "workspace:*",
    "express": "^4.22.0",
    "ioredis": "^5.4.1",
    "mjml": "^5.0.1",
    "nodemailer": "^7.0.11",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^25.6.0",
    "@types/nodemailer": "^6.4.23",
    "@types/ws": "^8.5.12",
    "typescript": "^5.7.0"
  }
}
