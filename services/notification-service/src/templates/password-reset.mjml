<mj-text align="{{ textAlign }}" font-size="20px" font-weight="600" padding-bottom="8px">
  {{ t.title }}
</mj-text>
<mj-text align="{{ textAlign }}">
  {{ t.body }}
</mj-text>
<mj-button href="{{ resetUrl }}" align="{{ textAlign }}">
  {{ t.cta }}
</mj-button>
<mj-text align="{{ textAlign }}" css-class="muted" padding-top="16px">
  {{ t.expiryNote }}
</mj-text>
<mj-text align="{{ textAlign }}" css-class="muted">
  {{ t.fallback }}
  <br />
  <a href="{{ resetUrl }}" style="color:#2563eb;word-break:break-all">{{ resetUrl }}</a>
</mj-text>
