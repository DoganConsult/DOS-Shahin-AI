<mjml>
  <mj-head>
    <mj-title>{{ subject }}</mj-title>
    <mj-preview>{{ preview }}</mj-preview>
    <mj-attributes>
      <mj-all font-family="'Helvetica Neue', Arial, sans-serif" />
      <mj-text line-height="1.6" font-size="14px" color="#1f2937" />
      <mj-button background-color="#111827" color="#ffffff" font-size="14px" inner-padding="12px 24px" border-radius="6px" />
    </mj-attributes>
    <mj-style inline="inline">
      .brand { color:#111827; font-weight:600; letter-spacing:.5px; }
      .muted { color:#6b7280; font-size:12px; }
      .hr    { border:0;border-top:1px solid #e5e7eb;margin:24px 0; }
    </mj-style>
  </mj-head>
  <mj-body background-color="#f8fafc" width="600px">
    <mj-section padding="24px 24px 0" css-class="brand">
      <mj-column>
        <mj-text align="{{ textAlign }}" font-size="18px" font-weight="700">{{ brandName }}</mj-text>
      </mj-column>
    </mj-section>
    <mj-section background-color="#ffffff" padding="24px" border-radius="8px">
      <mj-column>
        {{{ body }}}
      </mj-column>
    </mj-section>
    <mj-section padding="16px 24px 32px">
      <mj-column>
        <mj-text align="{{ textAlign }}" css-class="muted">
          {{ footer }}
        </mj-text>
      </mj-column>
    </mj-section>
  </mj-body>
</mjml>
