{
  "serviceCode": "agrc-os-service",
  "displayName": "AGRC OS Service",
  "layer": "platform-service",
  "ownerTeam": "platform-ai",
  "runtime": "node",
  "trustZone": "tenant",
  "dependsOn": [
    "auth-service",
    "tenant-service",
    "ai-gateway-service"
  ],
  "modules": [
    "agrc-engine"
  ],
  "apiPrefix": "/api/agrc",
  "exposes": {
    "apiBase": "/api/agrc",
    "events": [
      "agrc.analysis.completed",
      "agrc.recommendation.generated"
    ]
  }
}
