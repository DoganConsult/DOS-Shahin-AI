# ----------------------------------------------------------------------------
# Environment Variable Example File
# Replace all placeholders with actual values within your local .env
# ----------------------------------------------------------------------------

# The execution environment frame (development, test, staging, production)
NODE_ENV=development

# The port on which the service will run
PORT=4031

# Logger verbosity (trace, debug, info, warn, error, fatal)
LOG_LEVEL=info

# ----------------------------------------------------------------------------
# Database Configurations
# ----------------------------------------------------------------------------
# SECRET - The connection string for the PostgreSQL database (must include credentials)
DATABASE_URL=postgresql://dos_user:password@localhost:5432/dos_platform
# The max connection pool size for postgres client
DB_POOL_MAX=10

# ----------------------------------------------------------------------------
# Cache & KV Storage
# ----------------------------------------------------------------------------
# SECRET - Redis connection URL
REDIS_URL=redis://localhost:6379
# Prefix applied to all keys managed by this service instance
REDIS_PREFIX=dos:

# ----------------------------------------------------------------------------
# Inter-service Connectivity URLs
# ----------------------------------------------------------------------------
# Local endpoint resolving to the authorization microservice
AUTH_SERVICE_URL=http://127.0.0.1:4001
# Local endpoint resolving to tenant manager
TENANT_SERVICE_URL=http://127.0.0.1:4002
# Local endpoint resolving to user microservice profiles
USER_SERVICE_URL=http://127.0.0.1:4003
# Endpoint for temporal/workflow integrations
WORKFLOW_SERVICE_URL=http://127.0.0.1:4004
# Endpoint for sending platform notifications (Push/Email)
NOTIFICATION_SERVICE_URL=http://127.0.0.1:4005
# Endpoint for audit trial append entries
AUDIT_SERVICE_URL=http://127.0.0.1:4006
# Endpoint interfacing directly with LangChain/Graph AI gateways
AI_GATEWAY_SERVICE_URL=http://127.0.0.1:4007
# The public or intra-network gateway exposing the platform
GATEWAY_URL=http://127.0.0.1:4000

# ----------------------------------------------------------------------------
# Observability & Telemetry
# ----------------------------------------------------------------------------
# Toggle for OpenTelemetry remote tracing
OTEL_TRACING_ENABLED=false
# OTLP connection endpoint for telemetry ingestion
OTEL_EXPORTER_OTLP_ENDPOINT=
# Sampling rate from 0.0 (none) to 1.0 (all requests traced)
OTEL_SAMPLING_RATE=0.1
