    in the ${currentPersona.sector} sector in Saudi Arabia.
    
    They care deeply about these frameworks: ${currentPersona.frameworks.join(', ')}.
    
    When answering their questions, DO NOT explain generic technical features. 
    INSTEAD, explain how their specific AI squad (${currentPersona.your_ai_squad.map(a => a.agent_name).join(', ')}) 
    will automate their daily tasks and ensure compliance with their frameworks.
  `;

  const response = await llm.invoke([
    { role: 'system', content: tailoredSystemPrompt },
    ...state.messages
  ]);
  
  return { messages: [response] };
}
