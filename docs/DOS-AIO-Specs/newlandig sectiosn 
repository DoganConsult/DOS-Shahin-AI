  const keywordsRes = await llm.invoke(searchPrompt);
  const keywords = keywordsRes.content.toString().split(',').map(k => k.trim());

  // 2. استدعاء أداة MCP للبحث عن الجداول
  // (يفترض أن الوكيل قام باستدعاء ToolNode هنا، ولكن هذا تبسيط للمنطق)
  const possibleTables = await searchDbSchema(keywords);

  // 3. توجيه الوكيل لفحص الجداول ودمج البيانات
  const mergePrompt = `
    You are merging data for a ${persona.role}. 
    I found these tables: ${possibleTables.join(', ')}.
    Use your tools to inspect their columns, fetch the top 5 relevant metrics, 
    and output a unified JSON object that highlights KSA compliance and role KPIs.
  `;
  
  const mergedDataRes = await llm.invoke([
    { role: 'system', content: mergePrompt },
