export class ModuleExplorerComponent implements OnInit {
  http = inject(HttpClient);
  stream = inject(NocStreamService);

  viewMode = signal<'TECH' | 'BUSINESS'>('BUSINESS'); // الافتراضي للزوار
  moduleCatalog = signal<any[]>([]);
  catalogVersion = signal<string>('v1.0.0');

  ngOnInit() {
    // 1. تحميل الكتالوج المخبأ من Redis عبر API سريع
    this.http.get('/api/public/catalog').subscribe((data: any) => {
      this.moduleCatalog.set(data.modules);
      this.catalogVersion.set(data.version);
    });

    // 2. الاستماع لأي تحديثات عبر WebSockets
    this.stream.socket.on('catalog_updated', () => {
      // إعادة جلب البيانات عند إشعار الواجهة بوجود تحديث جديد
      this.http.get('/api/public/catalog').subscribe((data: any) => {
        this.moduleCatalog.set(data.modules);
        this.catalogVersion.set(data.version);
      });
    });
  }

  getLivePulse(moduleId: string) {
    // استخراج الإحصائيات الحية من البث المباشر (Pulse) للوحدة المحددة
    return this.stream.systemPulse()?.modules[moduleId];
  }
}
