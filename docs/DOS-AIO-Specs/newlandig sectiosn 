  currentTrace: string; // المتغير الذي يخبر الواجهة أي طبقة تضيء الآن
}

const llm = new ChatOpenAI({ modelName: 'gpt-4-turbo', temperature: 0.2 });

// 1. عقدة التفكير الأولي (تضيء طبقة الـ AI)
async function analyzeIntent(state: AgentState) {
  // بث مباشر للـ WebSocket أننا في طبقة الـ AI
  global.nocSocketIO.emit('agent_trace', { layer: 'Layer5_AI', action: 'Analyzing Question' });
  
  const response = await llm.invoke([
    { role: 'system', content: 'You are the Public Guide for Dogan-AI-OS. Explain the architecture simply.' },
    ...state.messages
  ]);
  
  return { messages: [response], currentTrace: 'Layer5_AI' };
}

// 2. عقدة استرجاع المعرفة (تضيء طبقة قواعد البيانات/ClickHouse)
async function fetchArchitectureDocs(state: AgentState) {
  global.nocSocketIO.emit('agent_trace', { layer: 'Data_Architecture', action: 'Fetching Docs' });
  // (هنا يتم استدعاء أدوات البحث الخاصة بك)
  return { currentTrace: 'Data_Architecture' };
}

// 3. بناء مسار LangGraph
export const guestAgentGraph = new StateGraph<AgentState>({
  channels: { messages: { value: (x, y) => x.concat(y), default: () => [] }, currentTrace: { value: (x, y) => y, default: () => '' } }
})
  .addNode('analyze', analyzeIntent)
  .addNode('fetch', fetchArchitectureDocs)
  .addEdge('analyze', 'fetch')
  .addEdge('fetch', END)
  .compile();
