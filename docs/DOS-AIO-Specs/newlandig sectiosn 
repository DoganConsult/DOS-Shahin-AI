// server/routes/ci-cd-hooks.ts
import { Router } from 'express';
import { Connection, Client } from '@temporalio/client';

export const webhookRouter = Router();

// نقطة يتم استدعاؤها آلياً بعد كل عملية نشر (Release)
webhookRouter.post('/hooks/release-success', async (req, res) => {
  try {
    const connection = await Connection.connect();
    const client = new Client({ connection });

    // إطلاق مسار عمل Temporal ليقوم بتحديث الكتالوج التجاري في Redis
    const handle = await client.workflow.start('updateBusinessCatalogWorkflow', {
      taskQueue: 'system-maintenance-queue',
      workflowId: `catalog-update-${Date.now()}`,
      args: [req.body.version_tag] // تمرير رقم الإصدار الجديد
    });

    res.status(202).json({ message: 'Catalog Update Workflow Triggered', workflowId: handle.workflowId });
  } catch (error) {
    res.status(500).json({ error: 'Failed to trigger Temporal workflow' });
  }
});
