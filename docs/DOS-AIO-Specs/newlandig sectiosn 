// server/mcp-tools/schema-tools.ts
import { db } from '../database/connection'; // اتصال PostgreSQL

// أداة 1: البحث عن الجداول بالكلمات المفتاحية
export async function searchDbSchema(keywords: string[]) {
  // بحث ذكي في أسماء الجداول والتعليقات (Comments) المحفوظة في قاعدة البيانات
  const query = `
    SELECT table_name 
    FROM information_schema.tables 
    WHERE table_schema = 'public' 
    AND (${keywords.map(k => `table_name ILIKE '%${k}%'`).join(' OR ')});
  `;
  const result = await db.query(query);
  return result.rows.map(r => r.table_name);
}

// أداة 2: جلب أسماء الأعمدة الدقيقة لجدول معين
export async function getTableColumns(tableName: string) {
  const query = `
    SELECT column_name, data_type 
    FROM information_schema.columns 
    WHERE table_name = $1;
  `;
  const result = await db.query(query, [tableName]);
  return result.rows;
}
