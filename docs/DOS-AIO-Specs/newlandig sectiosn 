// server/workflows/catalog-updater.ts
import { proxyActivities } from '@temporalio/workflow';
import type * as activities from '../activities';

const { fetchActualUsage, agentRegenerateBusinessValue, updateRedisCache } = proxyActivities<typeof activities>({
  startToCloseTimeout: '5 minutes',
});

// هذا الـ Workflow يمكن جدولته ليعمل أسبوعياً أو عند كل عملية نشر (Deployment)
export async function updateBusinessCatalogWorkflow() {
  // 1. جلب بيانات الاستخدام الحقيقية من قواعد البيانات
  const usageStats = await fetchActualUsage();
  
  // 2. تمرير البيانات للوكيل لكتابة القيمة التجارية وتحديث الميزات
  const updatedCatalogJSON = await agentRegenerateBusinessValue(usageStats);
  
  // 3. تحديث الذاكرة المؤقتة (Redis) لتقرأ منها الواجهة الأمامية فوراً
  await updateRedisCache('module_business_catalog', updatedCatalogJSON);
  
  return 'Catalog Updated Successfully';
}
