// src/app/services/noc-stream.service.ts
import { Injectable, signal } from '@angular/core';
import { io, Socket } from 'socket.io-client';

@Injectable({ providedIn: 'root' })
export class NocStreamService {
  private socket: Socket;
  
  // استخدام Angular Signals لتحديث الواجهة فوراً
  public systemPulse = signal<any>(null);
  public isConnected = signal<boolean>(false);

  constructor() {
    this.socket = io('https://api.yourdomain.com/live-noc');

    this.socket.on('connect', () => this.isConnected.set(true));
    this.socket.on('disconnect', () => this.isConnected.set(false));
    
    this.socket.on('system_pulse', (data) => {
      this.systemPulse.set(data);
    });
  }

