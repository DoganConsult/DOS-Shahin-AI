{
  "$schema": "https://dos-platform.local/schemas/audit-bundle.contract.v1.json",
  "schemaVersion": 1,
  "contractKey": "module.audit-shelf.bundle",
  "version": "1.0.0",
  "doctrine": "An audit bundle is a deterministic, hash-stamped snapshot of the regulator-relevant state of a tenant at point-in-time. It is reproducible: re-running the bundle command on the same DB at the same instant must produce a byte-equivalent payload (modulo timestamps).",
  "sections": [
    {
      "key": "role_profile_sync_ledger",
      "source": "dos.role_profile_sync_log",
      "filter": "tenant_id = :tenant_id",
      "limit": 5000,
      "purpose": "Prove which acceptor (HRIS/SCIM/Okta/AAD) wrote each role assignment and when."
    },
    {
      "key": "ura_projection_state",
      "source": "platform_dauth.user_role_assignments",
      "filter": "tenant_id = :tenant_id AND is_active = true",
      "purpose": "Currently effective role assignments derived from role-profile-sync."
    },
    {
      "key": "rbac_matrix_snapshot",
      "source": "ops/handover/<date>/foundation-rbac-matrix.json",
      "purpose": "The 64-cell role × route resolution table at handover time."
    },
    {
      "key": "drift_telemetry_window",
      "source": "dos.platform_drift_log",
      "filter": "occurred_at >= now() - interval '30 days'",
      "purpose": "30-day rolling drift evidence."
    },
    {
      "key": "tenant_migration_ledger",
      "source": "dos.tenant_migrations",
      "filter": "tenant_id = :tenant_id",
      "purpose": "Schema-evolution provenance for the tenant."
    },
    {
      "key": "access_reviews",
      "source": "tenant_<id>.access_reviews",
      "purpose": "Latest attestation campaigns and outcomes."
    },
    {
      "key": "delegations",
      "source": "tenant_<id>.delegations",
      "purpose": "Active and historical authority delegations."
    },
    {
      "key": "audit_signoff_ledger",
      "source": "dos.audit_signoff_ledger",
      "filter": "tenant_id = :tenant_id",
      "purpose": "Counter-signature trail for prior bundles."
    }
  ],
  "signing": {
    "algo": "sha256",
    "fields": ["tenant_id","generated_at","sections"],
    "ledger": "dos.audit_signoff_ledger"
  }
}
