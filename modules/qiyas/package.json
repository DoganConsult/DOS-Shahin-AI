{
  "name": "@dos/module-qiyas",
  "version": "1.0.0",
  "description": "DOS Qiyas module — maturity assessments, dimensions, scoring, gap analysis, benchmarks, roadmap, target profiles, trend analysis.",
  "private": true,
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./bootstrap": {
      "types": "./dist/bootstrap.d.ts",
      "default": "./dist/bootstrap.js"
    },
    "./contracts": {
      "types": "./dist/contracts/index.d.ts",
      "default": "./dist/contracts/index.js"
    },
    "./module.manifest.json": "./module.manifest.json",
    "./db/migrations/*": "./db/migrations/*",
    "./ui": "./ui/index.ts",
    "./ui/*": "./ui/*"
  },
  "files": [
    "dist",
    "ui",
    "db",
    "config",
    "schemas",
    "module.manifest.json",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test tests/smoke/*.test.mjs",
    "test:smoke": "node --test tests/smoke/*.test.mjs",
    "verify:permissions": "node ops/scripts/verify-permissions.mjs",
    "boot:harness": "node ops/scripts/boot-harness.mjs",
    "ci": "node ops/scripts/ci.mjs",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "express": "^4.19.2",
    "zod": "^3.23.8"
  },
  "peerDependencies": {
    "@dos/db": "workspace:*",
    "@dos/module-sdk": "workspace:*",
    "@dos/platform-core": "workspace:*",
    "@dos/types": "workspace:*"
  },
  "peerDependenciesMeta": {
    "@dos/db": { "optional": true },
    "@dos/module-sdk": { "optional": true },
    "@dos/platform-core": { "optional": true },
    "@dos/types": { "optional": true }
  },
  "devDependencies": {
    "typescript": "^5.5.4"
  },
  "dos": {
    "moduleCode": "qiyas",
    "tier": "platform",
    "hostService": "qiyas-journey-service",
    "manifest": "module.manifest.json",
    "entrypoint": "./dist/bootstrap.js#registerQiyas"
  }
}
