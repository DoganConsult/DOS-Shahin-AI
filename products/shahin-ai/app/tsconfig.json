{
  "compileOnSave": false,
  "compilerOptions": {
    "outDir": "./dist/out-tsc",
    "forceConsistentCasingInFileNames": true,
    "strict": false,
    "strictNullChecks": false,
    "noImplicitAny": false,
    "noImplicitOverride": true,
    "noPropertyAccessFromIndexSignature": false,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "sourceMap": true,
    "declaration": false,
    "experimentalDecorators": true,
    "moduleResolution": "bundler",
    "importHelpers": true,
    "target": "ES2022",
    "module": "ES2022",
    "useDefineForClassFields": false,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "allowSyntheticDefaultImports": true,
    "lib": ["ES2022", "dom"],
    "paths": {
        "@app/dos": ["../../../platform/dos/index.core.ts"],
        "@app/dos/*": ["../../../platform/dos/*"],
        "@app/dauth": ["../../../platform/dauth/index.ts"],
        "@app/dauth/*": ["../../../platform/dauth/*"],
        "@dos/module-foundation": ["../../../platform/foundation/dist/index"],
        "@dos/module-foundation/*": ["../../../platform/foundation/dist/*"],
        "@dos/module-foundation/ui": ["../../../platform/foundation/ui/index.ts"],
        "@dos/module-foundation/ui/*": ["../../../platform/foundation/ui/*"],
        "@app/api": ["../../../platform/core/services/api/index.ts"],
        "@app/api/*": ["../../../platform/core/services/api/*"],
        "@app/layout/*": ["./src/app/layout/*"],
        "@app/infrastructure": ["../../../platform/runtime/infrastructure/index.ts"],
        "@app/infrastructure/*": ["../../../platform/runtime/infrastructure/*"],
        "@app/runtime": ["../../../platform/runtime/index.ts"],
        "@app/runtime/*": ["../../../platform/runtime/*"],
        "@app/admin": ["../../../platform/core/admin/index.ts"],
        "@app/admin/*": ["../../../platform/core/admin/*"],
        "@app/ai": ["../../../platform/ai/services/index.ts"],
        "@app/ai/*": ["../../../platform/ai/services/*"],
        "@app/grc": ["../../../platform/core/grc/index.ts"],
        "@app/grc/*": ["../../../platform/core/grc/*"],
        "@app/modules": ["../../../platform/core/modules/index.ts"],
        "@app/modules/*": ["../../../platform/core/modules/*"],
        "@app/portals": ["../../../platform/core/portals/index.ts"],
        "@app/portals/*": ["../../../platform/core/portals/*"],
        "@app/reporting": ["../../../platform/core/reporting/index.ts"],
        "@app/reporting/*": ["../../../platform/core/reporting/*"],
        "@app/websocket": ["../../../platform/runtime/websocket/index.ts"],
        "@app/websocket/*": ["../../../platform/runtime/websocket/*"],
        "@app/workspace": ["../../../platform/core/workspace/index.ts"],
        "@app/workspace/*": ["../../../platform/core/workspace/*"],
        "@app/core/*": ["../../../platform/core/*"],
        "@app/shared/*": ["../../../platform/config-center/shared/*"],
        "@app/charts/*": ["../../../platform/config-center/shared/charts/*"],
        "@app/widgets": ["../../../platform/config-center/shared/widgets/index.ts"],
        "@app/widgets/*": ["../../../platform/config-center/shared/widgets/*"],
        "@app/features/*": ["../../../modules/compliance/ui/features/*"],
        "@app/services/*": ["../../../platform/core/services/*"],
        "@compliance-module/ui": ["../../../modules/compliance/ui/index.ts"],
        "@compliance-module/ui/*": ["../../../modules/compliance/ui/*"],
        "@risk-module/ui": ["../../../modules/risk/ui/index.ts"],
        "@risk-module/ui/*": ["../../../modules/risk/ui/*"],
        "@foundation-module/ui": ["../../../platform/foundation/ui/index.ts"],
        "@foundation-module/ui/*": ["../../../platform/foundation/ui/*"],
        "@workflow-module/ui": ["./src/_stubs/workflow-module-ui.stub.ts"],
        "@workflow-module/ui/*": ["./src/_stubs/workflow-module-ui.stub.ts"],
        "@app/features/risk/*": ["../../../modules/risk/ui/features/risk/*"],
        "@app/features/compliance/*": ["../../../modules/compliance/ui/features/compliance/*"],
        "@app/grc/services/grc-compliance.service": ["../../../modules/compliance/ui/services/grc-compliance.service.ts"],
        "@app/*": ["./src/app/*"],
        "@env/*": ["./src/environments/*"]
      }
  },
  "angularCompilerOptions": {
    "enableI18nLegacyMessageIdFormat": false,
    "strictInjectionParameters": true,
    "strictInputAccessModifiers": true
  },
  "exclude": [
    "node_modules",
    "capacitor.config.ts",
    "src/app/mobile/**",
    "src/app/layout/**",
    "src/app/pages/landing/**",
    "src/app/pages/login/**",
    "src/app/pages/findings/**",
    "src/app/pages/exceptions/**",
    "src/app/pages/evidence-hub/**",
    "src/app/pages/assets/**",
    "src/app/pages/esg/**",
    "src/app/pages/executive-command/**",
    "src/app/pages/policy-code/**",
    "src/app/pages/playbook/**",
    "src/**/*.spec.ts",
    "src/**/*.test.ts",
    "src/**/*.pbt.ts"
  ]
}
