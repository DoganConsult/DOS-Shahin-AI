{
  "$schema": "../../../node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "shahin-ai": {
      "projectType": "application",
      "root": "",
      "sourceRoot": "src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-angular:application",
          "options": {
            "externalDependencies": ["web-worker"],
            "allowedCommonJsDependencies": [
              "events",
              "graphology-utils/is-graph",
              "lottie-web",
              "plotly.js-dist-min",
              "elkjs",
              "@profoundlogic/hogan"
            ],
            "outputPath": "dist/shahin-ai",
            "index": "src/index.html",
            "browser": "src/main.ts",
            "polyfills": ["zone.js"],
            "tsConfig": "tsconfig.app.json",
            "assets": [
              { "glob": "**/*", "input": "public", "output": "." },
              { "glob": "**/*", "input": "src/assets", "output": "assets" },
              { "glob": "*.json", "input": "src/app/assets/i18n", "output": "assets/i18n" }
            ],
            "styles": [
              "@fontsource-variable/inter/index.css",
              "@fontsource/tajawal/300.css",
              "@fontsource/tajawal/400.css",
              "@fontsource/tajawal/500.css",
              "@fontsource/tajawal/700.css",
              "@fontsource/tajawal/800.css",
              "@fontsource-variable/ibm-plex-sans/index.css",
              "@fontsource/ibm-plex-sans-arabic/300.css",
              "@fontsource/ibm-plex-sans-arabic/400.css",
              "@fontsource/ibm-plex-sans-arabic/500.css",
              "@fontsource/ibm-plex-sans-arabic/600.css",
              "@fontsource/ibm-plex-sans-arabic/700.css",
              "@fontsource/ibm-plex-mono/400.css",
              "@fontsource/ibm-plex-mono/500.css",
              "@fontsource/ibm-plex-mono/600.css",
              "@dos/design-tokens/tokens.css",
              "@dos/design-tokens/colors.css",
              "@dos/design-tokens/typography.css",
              "@dos/design-tokens/spacing.css",
              "@dos/design-tokens/radius.css",
              "@dos/design-tokens/shadows.css",
              "@dos/design-tokens/layout.css",
              "@dos/design-tokens/rtl.css",
              "@dos/ui-system/styles.css",
              "src/app/design-tokens.css",
              "src/styles/carbon-shell-tokens.scss",
              "src/auth-form.styles.css",
              "src/styles.css",
              "src/app/styles/mobile.css"
            ],
            "scripts": []
          },
          "configurations": {
            "production": {
              "budgets": [
                { "type": "initial", "maximumWarning": "4MB", "maximumError": "5MB" },
                { "type": "anyComponentStyle", "maximumWarning": "30kB", "maximumError": "50kB" }
              ],
              "outputHashing": "all",
              "fileReplacements": [
                { "replace": "../../../platform/config-center/environments/environment.ts", "with": "../../../platform/config-center/environments/environment.prod.ts" }
              ],
              "optimization": {
                "scripts": true,
                "styles": {
                  "minify": true,
                  "inlineCritical": false
                },
                "fonts": false
              }
            },
            "staging": {
              "budgets": [
                { "type": "initial", "maximumWarning": "3MB", "maximumError": "5MB" }
              ],
              "outputHashing": "all",
              "optimization": true,
              "sourceMap": true,
              "fileReplacements": [
                { "replace": "src/environments/environment.ts", "with": "src/environments/environment.staging.ts" }
              ]
            },
            "development": { "optimization": false, "extractLicenses": false, "sourceMap": true }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular-devkit/build-angular:dev-server",
          "options": { "proxyConfig": "proxy.conf.json" },
          "configurations": {
            "production": { "buildTarget": "shahin-ai:build:production" },
            "development": { "buildTarget": "shahin-ai:build:development" }
          },
          "defaultConfiguration": "development"
        },
        "lint": {
          "builder": "@angular-eslint/builder:lint",
          "options": {
            "lintFilePatterns": ["src/**/*.ts", "src/**/*.html"]
          }
        }
      }
    }
  },
  "cli": {
    "analytics": "9bb096c4-9ceb-4a67-a8f8-db8dfd7567e6"
  }
}
