{
  "name": "shahin-ai-frontend",
  "version": "1.0.0",
  "description": "Shahin-AI GRC Platform - by Dogan Consult",
  "scripts": {
    "postinstall": "node scripts/patch-angular-testing-standalone.mjs",
    "ng": "ng",
    "start": "ng serve",
    "generate:route-fragments": "node scripts/generate-route-fragments.mjs",
    "manifest:parity": "node scripts/manifest-parity.mjs",
    "prebuild": "echo 'prebuild skipped (landing-only build)'",
    "build": "ng build && sed -i 's/<script src=\"\\([^\"]*\\)\" type=\"module\"><\\/script>/<script src=\"\\1\" type=\"module\" data-cfasync=\"false\"><\\/script>/g' dist/shahin-ai/browser/index.html",
    "watch": "ng build --watch --configuration development",
    "test": "node --experimental-require-module --experimental-vm-modules ./node_modules/vitest/vitest.mjs run",
    "test:watch": "node --experimental-require-module --experimental-vm-modules ./node_modules/vitest/vitest.mjs",
    "test:foundation:routes": "node --experimental-require-module --experimental-vm-modules ./node_modules/vitest/vitest.mjs run --environment node src/app/blueprint/features/foundation/foundation-route-smoke.test.ts",
    "lint": "ng lint",
    "cap:sync": "ng build --configuration=production && cap sync",
    "mobile:android": "pnpm run cap:sync && cap open android",
    "mobile:ios": "pnpm run cap:sync && cap open ios",
    "mobile:run:android": "cap run android",
    "mobile:run:ios": "cap run ios"
  },
  "private": true,
