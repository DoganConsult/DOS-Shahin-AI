{
  "name": "shahin-ai-grc-frontend",
  "version": "1.0.0",
  "description": "Shahin-AI GRC Platform - by Dogan Consult",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "generate:route-fragments": "node ../../scripts/generate-route-fragments.mjs",
    "manifest:parity": "node ../../scripts/manifest-parity.mjs",
    "prebuild": "pnpm run generate:route-fragments",
    "build": "ng build && sed -i 's/<script src=\"\\([^\"]*\\)\" type=\"module\"><\\/script>/<script src=\"\\1\" type=\"module\" data-cfasync=\"false\"><\\/script>/g' ../../dist/shahin-ai/browser/index.html",
    "watch": "ng build --watch --configuration development",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "ng lint",
    "cap:sync": "ng build --configuration=production && cap sync",
    "mobile:android": "pnpm run cap:sync && cap open android",
    "mobile:ios": "pnpm run cap:sync && cap open ios",
    "mobile:run:android": "cap run android",
    "mobile:run:ios": "cap run ios"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^21.2.7",
    "@angular/cdk": "^21.2.5",
    "@angular/common": "^21.2.7",
