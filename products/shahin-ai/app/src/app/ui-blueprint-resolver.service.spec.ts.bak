/**
 * @vitest-environment jsdom
 * Page entitlement: entitlementModuleCodes OR-logic vs activeModules (registry parity).
 */
import 'zone.js';
import { getTestBed, TestBed } from '@angular/core/testing';
import {
  BrowserDynamicTestingModule,
  platformBrowserDynamicTesting,
} from '@angular/platform-browser-dynamic/testing';
import { UiBlueprintResolverService } from './ui-blueprint-resolver.service';
import { NavigationDerivationService } from './core/navigation/navigation-derivation.service';
import type { UiRenderContext } from './core/runtime/ui-state.models';

if (!getTestBed().platform) {
  getTestBed().initTestEnvironment(BrowserDynamicTestingModule, platformBrowserDynamicTesting());
}

function makeCtx(partial: Partial<UiRenderContext>): UiRenderContext {
  return {
    tenantId: 't1',
    userId: 'u1',
    roleCode: 'TenantAdmin',
    lang: 'en',
    rtl: false,
    permissions: new Set<string>(),
    functionalRoles: [],
    accessProfiles: [],
    activeModules: [],
    featureFlags: [],
    tier: 'enterprise',
    operationMode: 'human',
    globalFilters: {},
    ...partial,
  };
}

describe('UiBlueprintResolverService — entitlementModuleCodes', () => {
  let resolver: UiBlueprintResolverService;

  beforeEach(() => {
    TestBed.configureTestingModule({
      providers: [UiBlueprintResolverService, NavigationDerivationService],
    });
    resolver = TestBed.inject(UiBlueprintResolverService);
  });

  it('allows foundation-notifications when only foundation is active (not notification)', () => {
    const ctx = makeCtx({
      activeModules: ['foundation'],
      permissions: new Set(['foundation.org.read']),
    });
    const pages = resolver.resolvePages(ctx, 'standard');
    const p = pages.find(x => x.pageCode === 'foundation-notifications');
    expect(p?.allowed).toBe(true);
  });

  it('allows foundation-notifications when only notification is active', () => {
    const ctx = makeCtx({
      activeModules: ['notification'],
      permissions: new Set(['foundation.org.read']),
    });
    const pages = resolver.resolvePages(ctx, 'standard');
    const p = pages.find(x => x.pageCode === 'foundation-notifications');
    expect(p?.allowed).toBe(true);
  });

  it('denies foundation-notifications when neither foundation nor notification is active', () => {
    const ctx = makeCtx({
      activeModules: ['risk'],
      permissions: new Set(['foundation.org.read']),
    });
    const pages = resolver.resolvePages(ctx, 'standard');
    const p = pages.find(x => x.pageCode === 'foundation-notifications');
    expect(p?.allowed).toBe(false);
  });

  it('allows analytics-hub when only admin is active', () => {
    const ctx = makeCtx({
      activeModules: ['admin'],
      permissions: new Set(['analytics.report.read']),
    });
    const pages = resolver.resolvePages(ctx, 'standard');
    const p = pages.find(x => x.pageCode === 'analytics-hub');
    expect(p?.allowed).toBe(true);
  });

  it('allows analytics-hub when only analytics is active', () => {
    const ctx = makeCtx({
      activeModules: ['analytics'],
      permissions: new Set(['analytics.report.read']),
    });
    const pages = resolver.resolvePages(ctx, 'standard');
    const p = pages.find(x => x.pageCode === 'analytics-hub');
    expect(p?.allowed).toBe(true);
  });

  it('denies analytics-hub when neither admin nor analytics is active', () => {
    const ctx = makeCtx({
      activeModules: ['risk'],
      permissions: new Set(['analytics.report.read']),
    });
    const pages = resolver.resolvePages(ctx, 'standard');
    const p = pages.find(x => x.pageCode === 'analytics-hub');
    expect(p?.allowed).toBe(false);
  });

  it('allows my-tasks when only admin is active (workflow bundle via admin)', () => {
    const ctx = makeCtx({
      activeModules: ['admin'],
      permissions: new Set(['task.item.read']),
    });
    const pages = resolver.resolvePages(ctx, 'standard');
    const p = pages.find(x => x.pageCode === 'my-tasks');
    expect(p?.allowed).toBe(true);
  });

  it('allows my-tasks when only workflow is active', () => {
    const ctx = makeCtx({
      activeModules: ['workflow'],
      permissions: new Set(['task.item.read']),
    });
    const pages = resolver.resolvePages(ctx, 'standard');
    const p = pages.find(x => x.pageCode === 'my-tasks');
    expect(p?.allowed).toBe(true);
  });

  it('denies my-tasks when neither admin nor workflow is active', () => {
    const ctx = makeCtx({
      activeModules: ['risk'],
      permissions: new Set(['task.item.read']),
    });
    const pages = resolver.resolvePages(ctx, 'standard');
    const p = pages.find(x => x.pageCode === 'my-tasks');
    expect(p?.allowed).toBe(false);
  });
});
