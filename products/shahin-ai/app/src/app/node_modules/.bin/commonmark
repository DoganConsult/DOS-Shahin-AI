#!/bin/sh
basedir=$(dirname "$(echo "$0" | sed -e 's,\\,/,g')")

case `uname` in
    *CYGWIN*) basedir=`cygpath -w "$basedir"`;;
esac

if [ -z "$NODE_PATH" ]; then
  export NODE_PATH="/root/DOS-Platform/node_modules/.pnpm/commonmark@0.31.2/node_modules/commonmark/bin/node_modules:/root/DOS-Platform/node_modules/.pnpm/commonmark@0.31.2/node_modules/commonmark/node_modules:/root/DOS-Platform/node_modules/.pnpm/commonmark@0.31.2/node_modules:/root/DOS-Platform/node_modules/.pnpm/node_modules"
else
  export NODE_PATH="/root/DOS-Platform/node_modules/.pnpm/commonmark@0.31.2/node_modules/commonmark/bin/node_modules:/root/DOS-Platform/node_modules/.pnpm/commonmark@0.31.2/node_modules/commonmark/node_modules:/root/DOS-Platform/node_modules/.pnpm/commonmark@0.31.2/node_modules:/root/DOS-Platform/node_modules/.pnpm/node_modules:$NODE_PATH"
fi
if [ -x "$basedir/node" ]; then
  exec "$basedir/node"  "$basedir/../commonmark/bin/commonmark" "$@"
else
  exec node  "$basedir/../commonmark/bin/commonmark" "$@"
fi
