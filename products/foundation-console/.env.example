# Foundation Console runtime config (FC_* prefix only).
# Loaded via `node --env-file=.env` (Node 24 native).

# ── Ports ─────────────────────────────────────────────────────────────
FC_GATEWAY_PORT=3000
FC_UI_OS_PORT=3101
FC_DYNAMIC_UI_PORT=3102
FC_APP_DEV_PORT=4000

# ── Database (Foundation Console-owned schemas only) ──────────────────
FC_DB_URL=postgresql://fc_app:fc_app_pass_change_me@localhost:5432/shahin_grc
FC_DB_SCHEMAS=fc_ui_os,fc_dynamic_ui

# ── Keycloak (shared with host platform) ──────────────────────────────
FC_OIDC_ISSUER_URL=http://localhost:8180/login/realms/dogan
FC_OIDC_REALM=dogan
FC_OIDC_CLIENT_ID=foundation-console
FC_OIDC_CLIENT_SECRET=
FC_OIDC_REDIRECT_URI=http://localhost:3000/auth/callback
FC_SESSION_COOKIE_NAME=fc_sid
FC_SESSION_COOKIE_DOMAIN=localhost
FC_SESSION_SECRET=change_me_in_prod

# ── Service URLs (gateway uses these to reverse-proxy) ────────────────
FC_GATEWAY_URL=http://localhost:3000
FC_UI_OS_URL=http://localhost:3101
FC_DYNAMIC_UI_URL=http://localhost:3102

# ── Logging ───────────────────────────────────────────────────────────
FC_LOG_LEVEL=info
NODE_ENV=development

# ── Public tenant scope (used until per-session tenant lands in F11) ──
FC_PUBLIC_TENANT_ID=*
