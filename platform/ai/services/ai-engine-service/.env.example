# Runtime environment (development | staging | production | test)
NODE_ENV=development
# Service listen port
PORT=4311
# Structured log verbosity (fatal error warn info debug trace)
LOG_LEVEL=info

# Database
DATABASE_URL=postgresql://dos_user:password@localhost:5432/dos_platform
DB_POOL_MAX=10

# Redis
REDIS_URL=redis://localhost:6379
REDIS_PREFIX=dos:

# Inter-service URLs
AUTH_SERVICE_URL=http://127.0.0.1:4001
TENANT_SERVICE_URL=http://127.0.0.1:4002
USER_SERVICE_URL=http://127.0.0.1:4003
WORKFLOW_SERVICE_URL=http://127.0.0.1:4004
NOTIFICATION_SERVICE_URL=http://127.0.0.1:4005
AUDIT_SERVICE_URL=http://127.0.0.1:4006
AI_GATEWAY_SERVICE_URL=http://127.0.0.1:4007
GATEWAY_URL=http://127.0.0.1:4000

# Observability
OTEL_TRACING_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SAMPLING_RATE=0.1

# AI Configuration
AI_PROVIDER=anthropic
# SECRET - Anthropic API key for upstream LLM access
CLAUDE_API_KEY=
# SECRET - OpenAI API key for upstream LLM access
OPENAI_API_KEY=
# Local Ollama runtime (no API key required). When set, ai-engine routes
# callClaude() requests to Ollama's OpenAI-compatible /v1/chat endpoint
# before falling through to Anthropic. Useful for dev / offline smoke.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# ── Anthropic / Claude (canonical key name) ──
# The Claude provider in ai-engine reads ANTHROPIC_API_KEY first, then
# falls back to CLAUDE_API_KEY for backward compatibility.
ANTHROPIC_API_KEY=

# ── OpenRouter (OpenAI-compatible aggregator) ──
# When set, ai-engine routes callClaude() requests through OpenRouter,
# letting one key reach Anthropic, OpenAI, Google, Meta, etc. The model
# id uses OpenRouter's slug format (vendor/model) — see openrouter.ai/models.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-sonnet-4-5
# Optional ranking attribution shown on openrouter.ai leaderboards.
OPENROUTER_REFERER=
OPENROUTER_TITLE=

# ── LLM provider selection (priority order in callClaude) ──
#   1. LLM_OFFLINE_MODE=1     → deterministic offline stub (no LLM call)
#   2. OPENROUTER_API_KEY set → OpenRouter (OpenAI-compatible)
#   3. OLLAMA_BASE_URL set    → local Ollama
#   4. ANTHROPIC_API_KEY      → Anthropic API direct
#   5. (none)                 → offline stub + warning
# Set LLM_OFFLINE_MODE=1 to run smoke harness without keys.
LLM_OFFLINE_MODE=

# ── LangSmith (LangChain observability) ──
# Independent of Langfuse. When LANGSMITH_TRACING=true and LANGSMITH_API_KEY
# is set, every callClaude() invocation POSTs a run to LangSmith's /runs
# endpoint. Project routes runs into the named LangSmith dashboard.
LANGSMITH_TRACING=
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=
