# ai-governance-service — environment contract.
# Real values are injected by the secrets manager at deploy time.
# This file exists to satisfy the inter-service structural contract
# (tests/contract/inter-service-contracts.test.ts) and to document
# the variables the service reads at boot.

NODE_ENV=production
PORT=4034
LOG_LEVEL=info

# Database (non-superuser per-service role)
DATABASE_URL=<SET_VIA_SECRETS_MANAGER>
DB_POOL_MAX=10

# Redis
REDIS_URL=<SET_VIA_SECRETS_MANAGER>
REDIS_PREFIX=dos:

# Inter-service URLs consumed by ai-governance-service
AUTH_SERVICE_URL=<SET_VIA_SECRETS_MANAGER>
TENANT_SERVICE_URL=<SET_VIA_SECRETS_MANAGER>
USER_SERVICE_URL=<SET_VIA_SECRETS_MANAGER>
AUDIT_SERVICE_URL=<SET_VIA_SECRETS_MANAGER>
AI_ENGINE_SERVICE_URL=<SET_VIA_SECRETS_MANAGER>

# JWT signing (shared across services for verification)
JWT_SECRET=<SET_VIA_SECRETS_MANAGER>
JWT_REFRESH_SECRET=<SET_VIA_SECRETS_MANAGER>

# Gateway → service trust
INTER_SERVICE_SECRET=<SET_VIA_SECRETS_MANAGER>
