    "@dos/module-sdk": "^1.0.0",
    "@dos/contracts": "^1.0.0",
    "@dos/types": "^1.0.0",
    "@dos/runtime-config": "^1.0.0"
  },
  "futureService": "ai-governance-service",
  "metadata": {
