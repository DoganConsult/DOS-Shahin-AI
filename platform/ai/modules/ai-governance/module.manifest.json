    "parentModule": "ai-os",
    "previousLocation": "AI-OS Module/_sources/modules_ai-governance",
    "promotedAt": "2026-04-30",
    "migrationNote": "Promoted to kind=platform as sub-module of AI-OS. Removed product-specific productCode binding (was 'shahin-ai') and absolute foreign-machine currentSources/frontendSources paths. Migrations physically moved to platform/ai/migrations/{public,tenant}/ai-governance/.",
    "seedProviders": [
