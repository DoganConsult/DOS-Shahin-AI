{
  "extends": "../../../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": ".",
    "outDir": "dist",
    "noEmit": false,
    "composite": true,
    "declaration": true,
    "sourceMap": true,
    "tsBuildInfoFile": "./dist/.tsbuildinfo",
    "baseUrl": ".",
    "paths": {
      "@dos/db": ["../../../../packages/dos-db/dist/index"],
      "@dos/db/*": ["../../../../packages/dos-db/dist/*"],
      "@dos/types": ["../../../../packages/dos-types/dist/index"],
      "@dos/types/*": ["../../../../packages/dos-types/dist/*"],
      "@dos/contracts": ["../../../../packages/dos-contracts/dist/index"],
      "@dos/contracts/*": ["../../../../packages/dos-contracts/dist/*"],
      "@dos/platform-core": ["../../../../packages/dos-platform-core/dist/index"],
      "@dos/platform-core/*": ["../../../../packages/dos-platform-core/dist/*"]
    }
  },
  "include": ["ports/**/*.ts", "routes/**/*.ts", "services/**/*.ts", "ai-governance.controller.ts", "ai-governance.ts"],
  "exclude": ["node_modules", "dist", "**/*.test.ts", "**/*.spec.ts"]
}
