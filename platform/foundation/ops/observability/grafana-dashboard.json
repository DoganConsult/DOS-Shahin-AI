{
  "title": "Foundation Module (DOS-AIO)",
  "uid": "dos-foundation",
  "schemaVersion": 38,
  "version": 1,
  "editable": true,
  "tags": ["dos", "module", "foundation"],
  "timezone": "browser",
  "time": { "from": "now-6h", "to": "now" },
  "refresh": "30s",
  "templating": {
    "list": [
      {
        "name": "tenant",
        "type": "query",
        "datasource": "Prometheus",
        "query": "label_values(foundation_requests_total, tenant_id)",
        "includeAll": true,
        "multi": true,
        "current": { "text": "All", "value": "$__all" }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Requests/min",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "targets": [
        { "expr": "sum(rate(foundation_requests_total{tenant_id=~\"$tenant\"}[5m])) * 60" }
      ],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] } }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Error rate (5m)",
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 0 },
      "targets": [
        {
          "expr": "sum(rate(foundation_requests_total{status=~\"5..\"}[5m])) / sum(rate(foundation_requests_total[5m]))"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "percentunit", "thresholds": { "steps": [{ "color": "green", "value": null }, { "color": "orange", "value": 0.01 }, { "color": "red", "value": 0.05 }] } }
      }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Request latency (p50/p95/p99)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [
        { "expr": "histogram_quantile(0.50, sum by (le) (rate(foundation_request_duration_seconds_bucket[5m])))", "legendFormat": "p50" },
        { "expr": "histogram_quantile(0.95, sum by (le) (rate(foundation_request_duration_seconds_bucket[5m])))", "legendFormat": "p95" },
        { "expr": "histogram_quantile(0.99, sum by (le) (rate(foundation_request_duration_seconds_bucket[5m])))", "legendFormat": "p99" }
      ],
      "fieldConfig": { "defaults": { "unit": "s" } }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Events published/min",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "targets": [
        {
          "expr": "sum by (event_type) (rate(foundation_events_published_total[5m])) * 60",
          "legendFormat": "{{event_type}}"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "RLS denials / tenant",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 12 },
      "targets": [
        { "expr": "sum by (tenant_id) (rate(foundation_rls_denials_total[5m]))", "legendFormat": "{{tenant_id}}" }
      ]
    },
    {
      "id": 6,
      "type": "table",
      "title": "Foundation health signals",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 12 },
      "targets": [
        { "expr": "foundation_health_signal", "instant": true, "format": "table" }
      ]
    }
  ]
}
