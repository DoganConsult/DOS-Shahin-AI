{
  "name": "@dos/dauth-service",
  "version": "1.0.0",
  "description": "DOS Platform — DAuth (auth-service). Same-domain /login Keycloak topology. OIDC start/callback + session cookies. No onboarding wizard.",
  "private": true,
  "main": "dist/server.js",
  "type": "commonjs",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "axios": "^1.7.7",
    "cookie-parser": "^1.4.7",
    "express": "^4.21.0",
    "jose": "^5.9.6",
    "morgan": "^1.10.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.7",
    "@types/express": "^4.17.21",
    "@types/morgan": "^1.9.9",
    "@types/node": "^20.16.10",
    "typescript": "5.4.5"
  }
}
