DB_POOL_MAX=15
REDIS_URL=redis://127.0.0.1:6379
JWT_PRIVATE_KEY_PATH=/etc/dos-platform/keys/jwt-signing.key
JWT_PUBLIC_KEY_PATH=/etc/dos-platform/keys/jwt-public.key
JWT_ALGORITHM=RS256
JWT_EXPIRES_IN=3600
JWT_REFRESH_EXPIRES_IN=86400
JWT_SECRET=jvoN6ynoM4hK5OaFDcbwqrgb3Lp+7AXhwHpXM85t4FHZR5oaCqNd9RBkyabksPZn
JWT_REFRESH_SECRET=jvoN6ynoM4hK5OaFDcbwqrgb3Lp+7AXhwHpXM85t4FHZR5oaCqNd9RBkyabksPZn_refresh
