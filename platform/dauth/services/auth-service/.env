# ─────────── DAuth Enterprise Stack (shadow activation) ───────────
# All engines plug in as adapters behind the DAuth facade.
# SHADOW=true  → engine runs parallel to native, result logged to decision ledger (engineResults.<name>)
# ENFORCE=true → engine is authoritative, native becomes degraded fallback
# Golden rule (assertDauthConfigSafe): ENFORCE requires SHADOW to have run ≥ 2 cycles.

# Keycloak (Identity + Token verification)
# NOTE: KEYCLOAK_REALM=master and AUDIENCE=dos-auth are the current shadow values.
# Target post-provisioning values (per KEYCLOAK-REALM-MAPPING.md): realm=dogan, audience=shahin-bff.
# Run: pnpm exec tsx scripts/keycloak/provision-realm.ts
# Then: flip KEYCLOAK_REALM/_JWKS_URL/_ISSUER/_AUDIENCE to the *_TARGET_* values below.
KEYCLOAK_BASE_URL=http://127.0.0.1:8180
KEYCLOAK_REALM=dogan
KEYCLOAK_CLIENT_ID=shahin-bff
KEYCLOAK_JWKS_URL=http://127.0.0.1:8180/realms/dogan/protocol/openid-connect/certs
KEYCLOAK_ISSUER=http://127.0.0.1:8180/realms/dogan
KEYCLOAK_AUDIENCE=shahin-bff
KEYCLOAK_JWKS_CACHE_TTL_MS=600000
# Target realm / audience — assertDauthConfigSafe() warns when ENFORCE is on
# while active values still equal master / dos-auth.
KEYCLOAK_TARGET_REALM=dogan
KEYCLOAK_TARGET_AUDIENCE=shahin-bff
KEYCLOAK_TARGET_CLIENT_BFF=shahin-bff
KEYCLOAK_TARGET_CLIENT_WEB=shahin-web
# Narrow admin-write service account (per KEYCLOAK-REALM-MAPPING.md §Service accounts).
# Leave blank until the dauth-write client exists; KeycloakAdminClient stays disabled.
KEYCLOAK_ADMIN_WRITE_CLIENT_ID=dauth-admin-write
KEYCLOAK_ADMIN_WRITE_CLIENT_SECRET=4c7d97880d6754a81ace881aa440a4c1fbd9bbf97e727cb07a273ad771abc301
DAUTH_KEYCLOAK_SHADOW=true
DAUTH_KEYCLOAK_ENFORCE=true
REGISTER_USE_KEYCLOAK_FIRST=true
LOGIN_USE_KEYCLOAK=true
# Native JWT issuance algorithm. Today: HS256 (shared secret). When Keycloak
# ENFORCE flips true, either migrate native to RS256 or set
# DAUTH_JWT_MIXED_ALG_ACK=true to acknowledge HS256+RS256 coexistence.
DAUTH_JWT_ALGORITHM=HS256
DAUTH_JWT_MIXED_ALG_ACK=true

# OpenFGA (ReBAC) — canonical model id mirrors declarations/dauth-activation-status.md
OPENFGA_API_URL=http://127.0.0.1:8080
OPENFGA_STORE_ID=01KNSF17SBJBCF4H0E4KZM15EQ
OPENFGA_MODEL_ID=01KPQ9HBVC3K3BCN64TFGRPVP1
OPENFGA_API_TOKEN=
OPENFGA_TIMEOUT_MS=250
OPENFGA_RETRY_ATTEMPTS=1
OPENFGA_ENABLED=true
DAUTH_OPENFGA_SHADOW=true
DAUTH_OPENFGA_ENFORCE=true

# Cerbos (ABAC / policy)
CERBOS_PDP_URL=http://127.0.0.1:3592
CERBOS_TLS_ENABLED=false
CERBOS_TIMEOUT_MS=250
DAUTH_CERBOS_SHADOW=true
DAUTH_CERBOS_ENFORCE=false

# Vault (Secrets) — server not yet provisioned; keep disabled
DAUTH_VAULT_ENABLED=false
VAULT_ADDR=
VAULT_MOUNT=secret

# Decision ledger / safety
DAUTH_DECISION_LEDGER_ENABLED=true
DAUTH_POLICY_SIMULATION_ENABLED=true
DAUTH_ACCESS_REPLAY_ENABLED=true
RLS_ENABLED=true
DAUTH_RLS_FAIL_CLOSED=true
KEYCLOAK_OIDC_CLIENT_SECRET=c96c0661318f3a5d5bceda3d74c3274fe2f3a839189d3b042234cc9284e070d1
KEYCLOAK_OIDC_CLIENT_ID=shahin-bff
KEYCLOAK_OIDC_REDIRECT_URI=https://shahin-ai.com/api/auth/oidc/callback
KEYCLOAK_CLIENT_SECRET=c96c0661318f3a5d5bceda3d74c3274fe2f3a839189d3b042234cc9284e070d1
