# Runtime environment (development | staging | production | test)
NODE_ENV=development
# Service listen port
PORT=4001
# Structured log verbosity (fatal error warn info debug trace)
LOG_LEVEL=info

# Database
DATABASE_URL=postgresql://dos_auth:password@localhost:5432/dos_platform
DB_POOL_MAX=10

# Redis
REDIS_URL=redis://localhost:6379
REDIS_PREFIX=dos:

# JWT
# SECRET - JWT signing secret used to mint access tokens
JWT_SECRET=change-me-in-production
# SECRET - JWT signing secret used to mint refresh tokens (rotate independently from access)
JWT_REFRESH_SECRET=change-me-refresh-token-secret-min-32-chars
# SECRET - HMAC key for email verification tokens (optional in dev)
EMAIL_VERIFY_SIGNING_KEY=change-me-email-verify-key-min-32-chars
# SECRET - SSE stream signing key (optional in dev)
SSE_STREAM_KEY=change-me-sse-stream-key-min-32-chars
# SECRET - Captcha provider secret (optional in dev)
CAPTCHA_SECRET=change-me-captcha-secret-min-32-chars
JWT_SIGNING_KEY_PATH=/etc/dos-platform/keys/jwt-signing.key
JWT_PUBLIC_KEY_PATH=/etc/dos-platform/keys/jwt-public.key
JWT_ACCESS_TOKEN_EXPIRY=900
JWT_REFRESH_TOKEN_EXPIRY=604800

# Service URLs
AUTH_SERVICE_URL=http://127.0.0.1:4001
TENANT_SERVICE_URL=http://127.0.0.1:4002
USER_SERVICE_URL=http://127.0.0.1:4003
GATEWAY_URL=http://127.0.0.1:4000
