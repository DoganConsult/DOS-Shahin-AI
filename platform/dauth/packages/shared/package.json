{
  "name": "@dos/dauth-shared",
  "version": "1.0.0",
  "description": "DAuth — Dogan-Auth package. Identity, sessions, MFA, access/decision engine, scope, authority, delegation, SoD, lifecycle-auth, audit, middleware, contracts.",
  "private": true,
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./middleware": {
      "types": "./dist/middleware.d.ts",
      "default": "./dist/middleware.js"
    },
    "./contracts": {
      "types": "./dist/contracts.d.ts",
      "default": "./dist/contracts.js"
    },
    "./ports": {
      "types": "./dist/ports.d.ts",
      "default": "./dist/ports.js"
    },
    "./access": {
      "types": "./dist/access/index.d.ts",
      "default": "./dist/access/index.js"
    },
    "./canonical-middleware": {
      "types": "./dist/canonical-middleware.d.ts",
      "development": "./src/canonical-middleware.ts",
      "import": "./dist/canonical-middleware.js",
      "default": "./dist/canonical-middleware.js"
    },
    "./key-store": {
      "types": "./dist/key-store.d.ts",
      "development": "./src/key-store.ts",
      "import": "./dist/key-store.js",
      "default": "./dist/key-store.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@dos/contracts": "workspace:*",
    "@dos/db": "workspace:*",
    "@dos/ports": "workspace:*",
    "@dos/platform-core": "workspace:*",
    "@dos/types": "workspace:*",
    "bcryptjs": "^3.0.3",
    "express": "^4.22.1",
    "jose": "^5.9.6",
    "jsonwebtoken": "^9.0.3",
    "otplib": "^13.4.0",
    "pg": "^8.20.0",
    "uuid": "^11.1.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/bcryptjs": "^3.0.0",
    "@types/express": "^4.17.25",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/pg": "^8.20.0",
    "@types/uuid": "^10.0.0",
    "typescript": "^5.7.0"
  }
}
