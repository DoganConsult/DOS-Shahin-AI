[Unit]
Description=Prometheus Alertmanager
Documentation=https://prometheus.io/docs/alerting/latest/alertmanager/
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=alertmanager
Group=alertmanager
# RuntimeDirectory= must exist before namespacing (ReadWritePaths references it);
# systemd auto-creates /run/alertmanager owned by alertmanager:alertmanager.
RuntimeDirectory=alertmanager
RuntimeDirectoryMode=0750
# The `+` prefix runs ExecStartPre as root regardless of User=, so the
# pre-render step can read /etc/alertmanager/* (mode 0640 root:alertmanager)
# and write /run/alertmanager/alertmanager.yml owned by alertmanager.
ExecStartPre=+/usr/local/sbin/alertmanager-render-config
ExecStart=/usr/local/bin/alertmanager \
    --config.file=/run/alertmanager/alertmanager.yml \
    --storage.path=/var/lib/alertmanager \
    --web.listen-address=0.0.0.0:9093
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=5
LimitNOFILE=65536

NoNewPrivileges=true
ProtectSystem=full
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ReadWritePaths=/var/lib/alertmanager /run/alertmanager

[Install]
WantedBy=multi-user.target
