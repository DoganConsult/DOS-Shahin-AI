# Environment file for grafana-server.service (EnvironmentFile target).
# Install location: /etc/sysconfig/grafana-server (RPM) or /etc/default/grafana-server (DEB).
# The install.sh script copies this file into the correct path for the detected distro.

GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=dosplatform2026
GF_USERS_ALLOW_SIGN_UP=false
GF_DASHBOARDS_DEFAULT_HOME_DASHBOARD_PATH=/var/lib/grafana/dashboards/platform-overview.json

# Bind Grafana to 3001 — port 3000 is owned by product-shell (the Angular SPA).
# See docs/PORT-MAP.md for the canonical port allocation.
GF_SERVER_HTTP_PORT=3001

CONF_FILE=/etc/grafana/grafana.ini
PID_FILE_DIR=/run/grafana
LOG_DIR=/var/log/grafana
DATA_DIR=/var/lib/grafana
PLUGINS_DIR=/var/lib/grafana/plugins
PROVISIONING_CFG_DIR=/etc/grafana/provisioning
