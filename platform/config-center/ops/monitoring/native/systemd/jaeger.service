[Unit]
Description=Jaeger all-in-one distributed tracing
Documentation=https://www.jaegertracing.io/docs/
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=jaeger
Group=jaeger
Environment=COLLECTOR_OTLP_ENABLED=true
Environment=SPAN_STORAGE_TYPE=badger
Environment=BADGER_EPHEMERAL=false
Environment=BADGER_DIRECTORY_VALUE=/var/lib/jaeger/data
Environment=BADGER_DIRECTORY_KEY=/var/lib/jaeger/key
ExecStart=/usr/local/bin/jaeger-all-in-one
Restart=on-failure
RestartSec=5
LimitNOFILE=65536

NoNewPrivileges=true
ProtectSystem=full
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ReadWritePaths=/var/lib/jaeger

[Install]
WantedBy=multi-user.target
