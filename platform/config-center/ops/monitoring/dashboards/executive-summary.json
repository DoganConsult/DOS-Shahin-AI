{
  "dashboard": {
    "title": "DOS Platform \u2014 Executive Summary",
    "uid": "dos-executive-summary",
    "tags": [
      "dos",
      "executive",
      "c-level"
    ],
    "timezone": "browser",
    "refresh": "1m",
    "time": {
      "from": "now-24h",
      "to": "now"
    },
    "panels": [
      {
        "title": "Platform Health",
        "type": "stat",
        "gridPos": {
          "h": 6,
          "w": 6,
          "x": 0,
          "y": 0
        },
        "targets": [
          {
            "expr": "min(up)",
            "legendFormat": "Health"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "mappings": [
              {
                "type": "value",
                "options": {
                  "1": {
                    "text": "HEALTHY",
                    "color": "green"
                  }
                }
              },
              {
                "type": "value",
                "options": {
                  "0": {
                    "text": "DEGRADED",
                    "color": "red"
                  }
                }
              }
            ],
            "thresholds": {
              "steps": [
                {
                  "color": "red",
                  "value": 0
                },
                {
                  "color": "green",
                  "value": 1
                }
              ]
            }
          }
        }
      },
      {
        "title": "Services Up / Total",
        "type": "stat",
        "gridPos": {
          "h": 6,
          "w": 6,
          "x": 6,
          "y": 0
        },
        "targets": [
          {
            "expr": "sum(up)",
            "legendFormat": "Up"
          },
          {
            "expr": "count(up)",
            "legendFormat": "Total"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "thresholds": {
              "steps": [
                {
                  "color": "red",
                  "value": 0
                },
                {
                  "color": "yellow",
                  "value": 25
                },
                {
                  "color": "green",
                  "value": 30
                }
              ]
            }
          }
        }
      },
      {
        "title": "Overall Availability (30d)",
        "type": "gauge",
        "gridPos": {
          "h": 6,
          "w": 6,
          "x": 12,
          "y": 0
        },
        "targets": [
          {
            "expr": "(1 - (sum(rate(dos_http_requests_total{status_code=~\"5..\"}[30d])) / sum(rate(dos_http_requests_total[30d])))) * 100",
            "legendFormat": "Availability %"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "percent",
            "min": 95,
            "max": 100,
            "thresholds": {
              "steps": [
                {
                  "color": "red",
                  "value": 95
                },
                {
                  "color": "yellow",
                  "value": 99
                },
                {
                  "color": "green",
                  "value": 99.5
                }
              ]
            }
          }
        }
      },
      {
        "title": "P95 Global Latency",
        "type": "stat",
        "gridPos": {
          "h": 6,
          "w": 6,
          "x": 18,
          "y": 0
        },
        "targets": [
          {
            "expr": "histogram_quantile(0.95, sum(rate(dos_http_request_duration_seconds_bucket[5m])) by (le))",
            "legendFormat": "P95"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "s",
            "thresholds": {
              "steps": [
                {
                  "color": "green",
                  "value": 0
                },
                {
                  "color": "yellow",
                  "value": 1
                },
                {
                  "color": "red",
                  "value": 2
                }
              ]
            }
          }
        }
      },
      {
        "title": "Active Firing Alerts",
        "type": "stat",
        "gridPos": {
          "h": 6,
          "w": 6,
          "x": 0,
          "y": 6
        },
        "targets": [
          {
            "expr": "count(ALERTS{alertstate=\"firing\"}) or vector(0)",
            "legendFormat": "Firing"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "thresholds": {
              "steps": [
                {
                  "color": "green",
                  "value": 0
                },
                {
                  "color": "yellow",
                  "value": 1
                },
                {
                  "color": "red",
                  "value": 5
                }
              ]
            }
          }
        }
      },
      {
        "title": "Error Rate",
        "type": "stat",
        "gridPos": {
          "h": 6,
          "w": 6,
          "x": 6,
          "y": 6
        },
        "targets": [
          {
            "expr": "sum(rate(dos_errors_total[5m])) / sum(rate(dos_http_requests_total[5m])) * 100",
            "legendFormat": "Error %"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "percent",
            "decimals": 2,
            "thresholds": {
              "steps": [
                {
                  "color": "green",
                  "value": 0
                },
                {
                  "color": "yellow",
                  "value": 1
                },
                {
                  "color": "red",
                  "value": 5
                }
              ]
            }
          }
        }
      },
      {
        "title": "Total Request Rate",
        "type": "stat",
        "gridPos": {
          "h": 6,
          "w": 6,
          "x": 12,
          "y": 6
        },
        "targets": [
          {
            "expr": "sum(rate(dos_http_requests_total[5m]))",
            "legendFormat": "req/s"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "reqps",
            "thresholds": {
              "steps": [
                {
                  "color": "green",
                  "value": 0
                }
              ]
            }
          }
        }
      },
      {
        "title": "SLO Error Budget Remaining",
        "type": "gauge",
        "gridPos": {
          "h": 6,
          "w": 6,
          "x": 18,
          "y": 6
        },
        "targets": [
          {
            "expr": "((0.005 - (sum(rate(dos_http_requests_total{status_code=~\"5..\"}[30d])) / sum(rate(dos_http_requests_total[30d])))) / 0.005) * 100",
            "legendFormat": "Budget %"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "percent",
            "min": 0,
            "max": 100,
            "thresholds": {
              "steps": [
                {
                  "color": "red",
                  "value": 0
                },
                {
                  "color": "yellow",
                  "value": 25
                },
                {
                  "color": "green",
                  "value": 50
                }
              ]
            }
          }
        },
        "description": "Percentage of 30-day error budget (0.5%) remaining. SLO target: 99.5% availability."
      }
    ]
  },
  "title": "DOS Executive Summary"
}