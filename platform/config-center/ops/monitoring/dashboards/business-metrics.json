{
  "dashboard": {
    "title": "DOS Platform \u2014 Business Metrics",
    "uid": "dos-business-metrics",
    "tags": [
      "dos",
      "business",
      "executive"
    ],
    "timezone": "browser",
    "refresh": "5m",
    "time": {
      "from": "now-24h",
      "to": "now"
    },
    "panels": [
      {
        "title": "Active Tenants (last 1h)",
        "type": "stat",
        "gridPos": {
          "h": 6,
          "w": 6,
          "x": 0,
          "y": 0
        },
        "targets": [
          {
            "expr": "count(count by (tenant_id)(dos_http_requests_total))",
            "legendFormat": "Tenants"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "thresholds": {
              "steps": [
                {
                  "color": "blue",
                  "value": 0
                }
              ]
            }
          }
        }
      },
      {
        "title": "Total Request Rate",
        "type": "stat",
        "gridPos": {
          "h": 6,
          "w": 6,
          "x": 6,
          "y": 0
        },
        "targets": [
          {
            "expr": "sum(rate(dos_http_requests_total[5m]))",
            "legendFormat": "req/s"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "reqps",
            "thresholds": {
              "steps": [
                {
                  "color": "green",
                  "value": 0
                }
              ]
            }
          }
        }
      },
      {
        "title": "Module Routes Loaded",
        "type": "stat",
        "gridPos": {
          "h": 6,
          "w": 6,
          "x": 12,
          "y": 0
        },
        "targets": [
          {
            "expr": "sum(dos_module_routes_loaded{status=\"loaded\"})",
            "legendFormat": "Loaded"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "thresholds": {
              "steps": [
                {
                  "color": "green",
                  "value": 0
                }
              ]
            }
          }
        }
      },
      {
        "title": "Module Load Failures",
        "type": "stat",
        "gridPos": {
          "h": 6,
          "w": 6,
          "x": 18,
          "y": 0
        },
        "targets": [
          {
            "expr": "sum(dos_module_routes_loaded{status=\"failed\"}) or vector(0)",
            "legendFormat": "Failed"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "thresholds": {
              "steps": [
                {
                  "color": "green",
                  "value": 0
                },
                {
                  "color": "red",
                  "value": 1
                }
              ]
            }
          }
        }
      },
      {
        "title": "Request Volume by Tenant (Top 10)",
        "type": "bargauge",
        "gridPos": {
          "h": 8,
          "w": 12,
          "x": 0,
          "y": 6
        },
        "targets": [
          {
            "expr": "topk(10, sum(rate(dos_http_requests_total[1h])) by (tenant_id))",
            "legendFormat": "{{ tenant_id }}"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "reqps"
          }
        }
      },
      {
        "title": "Error Rate by Tenant",
        "type": "bargauge",
        "gridPos": {
          "h": 8,
          "w": 12,
          "x": 12,
          "y": 6
        },
        "targets": [
          {
            "expr": "topk(10, sum(rate(dos_errors_total[1h])) by (tenant_id) / sum(rate(dos_http_requests_total[1h])) by (tenant_id) * 100)",
            "legendFormat": "{{ tenant_id }}"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "percent",
            "thresholds": {
              "steps": [
                {
                  "color": "green",
                  "value": 0
                },
                {
                  "color": "yellow",
                  "value": 1
                },
                {
                  "color": "red",
                  "value": 5
                }
              ]
            }
          }
        }
      },
      {
        "title": "Services Up",
        "type": "stat",
        "gridPos": {
          "h": 4,
          "w": 8,
          "x": 0,
          "y": 14
        },
        "targets": [
          {
            "expr": "sum(up)",
            "legendFormat": "Services Up"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "thresholds": {
              "steps": [
                {
                  "color": "red",
                  "value": 0
                },
                {
                  "color": "yellow",
                  "value": 25
                },
                {
                  "color": "green",
                  "value": 30
                }
              ]
            }
          }
        }
      },
      {
        "title": "GRC Posture Score",
        "type": "gauge",
        "gridPos": {
          "h": 4,
          "w": 8,
          "x": 8,
          "y": 14
        },
        "targets": [
          {
            "expr": "dos_grc_posture_score or vector(0)",
            "legendFormat": "Posture"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "percent",
            "min": 0,
            "max": 100,
            "thresholds": {
              "steps": [
                {
                  "color": "red",
                  "value": 0
                },
                {
                  "color": "yellow",
                  "value": 60
                },
                {
                  "color": "green",
                  "value": 80
                }
              ]
            }
          }
        },
        "description": "Requires dos_grc_posture_score gauge metric registration. Shows 0 until metric is available."
      },
      {
        "title": "MRR (placeholder)",
        "type": "stat",
        "gridPos": {
          "h": 4,
          "w": 8,
          "x": 16,
          "y": 14
        },
        "targets": [
          {
            "expr": "dos_mrr_cents / 100 or vector(0)",
            "legendFormat": "MRR"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "currencyUSD",
            "thresholds": {
              "steps": [
                {
                  "color": "blue",
                  "value": 0
                }
              ]
            }
          }
        },
        "description": "Requires dos_mrr_cents gauge metric registration. Shows 0 until metric is available."
      }
    ]
  },
  "title": "DOS Business Metrics"
}