{
  "dashboard": {
    "title": "DOS Platform \u2014 Event Backbone",
    "uid": "dos-event-backbone",
    "tags": [
      "dos",
      "events",
      "redis"
    ],
    "timezone": "browser",
    "refresh": "30s",
    "time": {
      "from": "now-1h",
      "to": "now"
    },
    "panels": [
      {
        "title": "Events Published/s",
        "type": "timeseries",
        "gridPos": {
          "h": 8,
          "w": 12,
          "x": 0,
          "y": 0
        },
        "targets": [
          {
            "expr": "sum(rate(dos_event_bus_publish_total[5m])) by (event_type)",
            "legendFormat": "{{ event_type }}"
          }
        ]
      },
      {
        "title": "Events Published Successfully/s",
        "type": "timeseries",
        "gridPos": {
          "h": 8,
          "w": 12,
          "x": 12,
          "y": 0
        },
        "targets": [
          {
            "expr": "sum(rate(dos_event_bus_publish_total{status=\"success\"}[5m])) by (event_type)",
            "legendFormat": "{{ event_type }}"
          }
        ],
        "description": "Successful event publishes. Consumer-side metrics require dos_event_bus_consume_total registration."
      },
      {
        "title": "Publish Failures (Dead Letter Proxy)",
        "type": "timeseries",
        "gridPos": {
          "h": 8,
          "w": 12,
          "x": 0,
          "y": 8
        },
        "targets": [
          {
            "expr": "sum(rate(dos_event_bus_publish_total{status=\"failure\"}[5m])) by (event_type)",
            "legendFormat": "{{ event_type }}"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "thresholds": {
              "steps": [
                {
                  "color": "green",
                  "value": 0
                },
                {
                  "color": "yellow",
                  "value": 5
                },
                {
                  "color": "red",
                  "value": 20
                }
              ]
            }
          }
        },
        "description": "Failed event publishes. Full DLQ depth requires dos_event_bus_dlq_depth gauge registration."
      },
      {
        "title": "Publish Latency P95",
        "type": "timeseries",
        "gridPos": {
          "h": 8,
          "w": 12,
          "x": 12,
          "y": 8
        },
        "targets": [
          {
            "expr": "histogram_quantile(0.95, sum(rate(dos_event_bus_publish_duration_seconds_bucket[5m])) by (le, event_type))",
            "legendFormat": "{{ event_type }}"
          }
        ]
      },
      {
        "title": "Total Publish Failure Count",
        "type": "stat",
        "gridPos": {
          "h": 4,
          "w": 24,
          "x": 0,
          "y": 16
        },
        "targets": [
          {
            "expr": "sum(dos_event_bus_publish_total{status=\"failure\"}) by (event_type)",
            "legendFormat": "{{ event_type }}"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "thresholds": {
              "steps": [
                {
                  "color": "green",
                  "value": 0
                },
                {
                  "color": "red",
                  "value": 1
                }
              ]
            }
          }
        },
        "description": "Cumulative publish failures. Full poisoned event tracking requires dos_event_bus_poisoned_total registration."
      }
    ]
  },
  "title": "DOS Event Backbone"
}