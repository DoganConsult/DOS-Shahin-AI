{
  "dashboard": {
    "title": "DOS Platform \u2014 API Throttling",
    "uid": "dos-api-throttling",
    "timezone": "browser",
    "refresh": "30s",
    "panels": [
      {
        "id": 1,
        "title": "Rate Limit Rejections/sec (by namespace)",
        "type": "timeseries",
        "gridPos": {
          "h": 8,
          "w": 12,
          "x": 0,
          "y": 0
        },
        "targets": [
          {
            "expr": "sum(rate(dos_rate_limit_rejections_total[5m])) by (namespace)",
            "legendFormat": "{{namespace}}"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "color": {
              "mode": "palette-classic"
            },
            "custom": {
              "fillOpacity": 20
            },
            "unit": "reqps"
          }
        }
      },
      {
        "id": 2,
        "title": "429 Responses by Service",
        "type": "timeseries",
        "gridPos": {
          "h": 8,
          "w": 12,
          "x": 12,
          "y": 0
        },
        "targets": [
          {
            "expr": "sum(rate(dos_http_requests_total{status_code=\"429\"}[5m])) by (job)",
            "legendFormat": "{{job}}"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "color": {
              "mode": "palette-classic"
            },
            "custom": {
              "fillOpacity": 20
            },
            "unit": "reqps"
          }
        }
      },
      {
        "id": 3,
        "title": "Rejections by Tenant Tier",
        "type": "timeseries",
        "gridPos": {
          "h": 8,
          "w": 12,
          "x": 0,
          "y": 8
        },
        "targets": [
          {
            "expr": "sum(rate(dos_rate_limit_rejections_total{namespace=\"tenant\"}[5m])) by (tier)",
            "legendFormat": "{{tier}}"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "color": {
              "mode": "palette-classic"
            },
            "custom": {
              "fillOpacity": 20
            },
            "unit": "reqps"
          }
        }
      },
      {
        "id": 4,
        "title": "Rate Limit Check Volume vs Rejections",
        "type": "timeseries",
        "gridPos": {
          "h": 8,
          "w": 12,
          "x": 12,
          "y": 8
        },
        "targets": [
          {
            "expr": "sum(rate(dos_rate_limit_requests_total[5m]))",
            "legendFormat": "Total Checks"
          },
          {
            "expr": "sum(rate(dos_rate_limit_rejections_total[5m]))",
            "legendFormat": "Total Rejections"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "color": {
              "mode": "palette-classic"
            },
            "custom": {
              "fillOpacity": 10
            },
            "unit": "reqps"
          }
        }
      },
      {
        "id": 5,
        "title": "Rejection Ratio (%)",
        "type": "gauge",
        "gridPos": {
          "h": 8,
          "w": 8,
          "x": 0,
          "y": 16
        },
        "targets": [
          {
            "expr": "sum(rate(dos_rate_limit_rejections_total[5m])) / sum(rate(dos_rate_limit_requests_total[5m])) * 100",
            "legendFormat": "Rejection %"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "percent",
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {
                  "color": "green",
                  "value": 0
                },
                {
                  "color": "yellow",
                  "value": 5
                },
                {
                  "color": "red",
                  "value": 20
                }
              ]
            },
            "min": 0,
            "max": 100
          }
        }
      },
      {
        "id": 6,
        "title": "Auth Endpoint 429s",
        "type": "timeseries",
        "gridPos": {
          "h": 8,
          "w": 8,
          "x": 8,
          "y": 16
        },
        "targets": [
          {
            "expr": "sum(rate(dos_rate_limit_rejections_total{namespace=\"auth\"}[5m]))",
            "legendFormat": "Auth Rejections/s"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "color": {
              "fixedColor": "red",
              "mode": "fixed"
            },
            "custom": {
              "fillOpacity": 30
            },
            "unit": "reqps"
          }
        }
      },
      {
        "id": 7,
        "title": "Nginx Active Connections",
        "description": "Requires nginx stub_status at /nginx_status and nginx-exporter scraping",
        "type": "stat",
        "gridPos": {
          "h": 8,
          "w": 8,
          "x": 16,
          "y": 16
        },
        "targets": [
          {
            "expr": "nginx_connections_active",
            "legendFormat": "Active"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {
                  "color": "green",
                  "value": 0
                },
                {
                  "color": "yellow",
                  "value": 100
                },
                {
                  "color": "red",
                  "value": 300
                }
              ]
            }
          }
        }
      }
    ]
  },
  "title": "DOS API Throttling"
}