{
  "extends": "../tsconfig.modules.build.json",
  "compilerOptions": {
    "noEmit": false,
    "outDir": "dist",
    "rootDir": "source",
    "declaration": true,
    "strict": false,
    "noImplicitAny": false,
    "strictNullChecks": false
  },
  "include": ["source/**/*.ts"],
  "exclude": ["**/node_modules", "**/dist", "**/*.test.ts", "**/*.spec.ts", "source/frontend/**", "source/backend/integrations/**", "../integrations/**"]
}
