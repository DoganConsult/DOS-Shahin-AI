NODE_ENV=production
PORT=4003
LOG_LEVEL=info
DATABASE_URL=postgresql://dos_user:ZHxZ1RF4hRCK8Tpa90ouWEOZgaUXeMlada13tTEEBJQ=@localhost:5432/shahin_grc
DB_POOL_MAX=10
AUTH_SERVICE_URL=http://127.0.0.1:4001

# ── Tenant isolation: RLS is mandatory in production (enforced by @dos/runtime-config) ──
RLS_ENABLED=true

# ── DAuth / Keycloak verification (cookie-based dos_access_token is RS256) ──
KEYCLOAK_BASE_URL=https://shahin-ai.com/login
KEYCLOAK_INTERNAL_BASE_URL=http://127.0.0.1:8180
KEYCLOAK_REALM=dogan
KEYCLOAK_AUDIENCE=shahin-bff
KEYCLOAK_ISSUER=https://shahin-ai.com/login/realms/dogan
KEYCLOAK_JWKS_URL=http://127.0.0.1:8180/login/realms/dogan/protocol/openid-connect/certs
KEYCLOAK_JWKS_CACHE_TTL_MS=600000
DAUTH_ACCEPT_NATIVE_HS256=false
DAUTH_KEYCLOAK_ENFORCE=true

# JWT_SECRET / JWT_REFRESH_SECRET / SECRETS_ENCRYPTION_KEY → ops/env/platform.secrets.env (single source of truth, do NOT redeclare here)

# ── Foundation module (canonical platform-tier capability) ──
# Pin to the canonical pnpm workspace location: platform/foundation
# Built artifact lives at platform/foundation/dist (run: pnpm --filter @dos/module-foundation build)
FOUNDATION_MODULE_DIST=/root/DOS-Platform/platform/foundation/dist
MOUNT_FILTER_MODE=strict
