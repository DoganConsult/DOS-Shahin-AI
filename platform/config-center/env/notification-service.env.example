# notification-service.env.example
# Copy to notification-service.env and fill in secrets.
# NEVER commit the actual .env file.

NODE_ENV=production
PORT=4005
LOG_LEVEL=info

# ─── Database ────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://dos_notification:CHANGE_ME@localhost:5432/shahin_grc
DB_POOL_MAX=5

# ─── Redis ───────────────────────────────────────────────────────────────────
REDIS_URL=redis://127.0.0.1:6379

# ─── Auth service (for token validation) ─────────────────────────────────────
AUTH_SERVICE_URL=http://127.0.0.1:4001

# ─── SMTP Configuration ─────────────────────────────────────────────────────
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USER=info@doganconsult.com
SMTP_PASS=

# ─── Email Sender Addresses ─────────────────────────────────────────────────
# Platform emails: admin notifications, system alerts, provisioning confirmations
SMTP_FROM_PLATFORM=Dogan-AI-OS <info@doganconsult.com>
# Product emails: user notifications, reports, workflow alerts
SMTP_FROM_PRODUCT=Shahin-Ai <info@shahin-ai.com>
# Legacy single-from (still honoured as fallback)
SMTP_FROM=DOS Platform <info@doganconsult.com>
SMTP_DOMAIN=doganconsult.com

# ─── Branding ───────────────────────────────────────────────────────────────
BRAND_NAME=Shahin-Ai
BRAND_COLOR=#1a56db
APP_URL=https://shahin-ai.com

# ─── Webhook retry (optional) ───────────────────────────────────────────────
# MAX_RETRIES=3
# WEBHOOK_TIMEOUT_MS=10000

# Phase 1: keys below were in the real env file but missing from this template.
# Added by Phase 1 secrets contract pass. Set real values via secrets manager.
EMAIL_VERIFY_URL=<SET_VIA_SECRETS_MANAGER>
INVITATION_ACCEPT_URL=<SET_VIA_SECRETS_MANAGER>
PASSWORD_RESET_URL=<SET_VIA_SECRETS_MANAGER>
PLATFORM_URL=<SET_VIA_SECRETS_MANAGER>
