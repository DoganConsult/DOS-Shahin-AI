# Template generated in Phase 1 from the real tracked env file's KEY NAMES.
# Populate real values via the secrets manager at deploy time.
# Real env file is now untracked (.gitignore).

NODE_ENV=<SET_VIA_SECRETS_MANAGER>
PORT=<SET_VIA_SECRETS_MANAGER>
LOG_LEVEL=<SET_VIA_SECRETS_MANAGER>
DATABASE_URL=<SET_VIA_SECRETS_MANAGER>
DB_POOL_MAX=<SET_VIA_SECRETS_MANAGER>
JWT_PRIVATE_KEY_PATH=<SET_VIA_SECRETS_MANAGER>
JWT_PUBLIC_KEY_PATH=<SET_VIA_SECRETS_MANAGER>
JWT_ALGORITHM=<SET_VIA_SECRETS_MANAGER>
JWT_EXPIRES_IN=<SET_VIA_SECRETS_MANAGER>
JWT_REFRESH_EXPIRES_IN=<SET_VIA_SECRETS_MANAGER>
SECRETS_ENCRYPTION_KEY=<SET_VIA_SECRETS_MANAGER>

# ── DAuth Enterprise Stack (Keycloak + OpenFGA + Cerbos) ──
# loadOidcConfig() returns null → OIDC_UNCONFIGURED unless KEYCLOAK_BASE_URL
# AND KEYCLOAK_(OIDC_)CLIENT_SECRET are set.
OPENFGA_ENABLED=<SET_VIA_SECRETS_MANAGER>
OPENFGA_API_URL=<SET_VIA_SECRETS_MANAGER>
OPENFGA_STORE_ID=<SET_VIA_SECRETS_MANAGER>
OPENFGA_MODEL_ID=<SET_VIA_SECRETS_MANAGER>
OPENFGA_API_TOKEN=<SET_VIA_SECRETS_MANAGER>
KEYCLOAK_BASE_URL=<SET_VIA_SECRETS_MANAGER>
# Internal (loopback) base URL the auth-service uses for back-channel calls
# to Keycloak (token exchange, logout). MUST include the `/login` path
# prefix because this Keycloak deploys with KC_HTTP_RELATIVE_PATH=/login —
# `http://127.0.0.1:8180/realms/...` returns "Resource not found" HTML and
# the OIDC callback bubbles it up as 502 TOKEN_EXCHANGE_FAILED. The 2026-04-27
# registration outage was exactly this misconfiguration. Canonical value:
#   http://127.0.0.1:8180/login
KEYCLOAK_INTERNAL_BASE_URL=<SET_VIA_SECRETS_MANAGER>
KEYCLOAK_REALM=<SET_VIA_SECRETS_MANAGER>
KEYCLOAK_CLIENT_ID=<SET_VIA_SECRETS_MANAGER>
KEYCLOAK_JWKS_URL=<SET_VIA_SECRETS_MANAGER>
# Single canonical issuer (same-domain /login topology). KC is mounted under
# https://shahin-ai.com/login (KC_HTTP_RELATIVE_PATH=/login) so issuer claims,
# authorize/token/JWKS endpoints all share the apex host. Dual-issuer
# compatibility (auth.shahin-ai.com / auth.dogan-ai.com) is removed.
#   Canonical: https://shahin-ai.com/login/realms/dogan
KEYCLOAK_ISSUER=<SET_VIA_SECRETS_MANAGER>
KEYCLOAK_AUDIENCE=<SET_VIA_SECRETS_MANAGER>
# OIDC client credentials. The generic KEYCLOAK_OIDC_CLIENT_* pair is the
# fallback used by applyHostOverride() when surface-specific envs are
# not set. For per-brand client isolation set the surface-specific pairs
# below — config-safety will fail boot if either half of a pair is set
# without the other.
KEYCLOAK_OIDC_CLIENT_ID=<SET_VIA_SECRETS_MANAGER>
KEYCLOAK_OIDC_CLIENT_SECRET=<SET_VIA_SECRETS_MANAGER>
KEYCLOAK_OIDC_REDIRECT_URI=<SET_VIA_SECRETS_MANAGER>
# Per-surface OIDC client overrides. Leave blank to reuse the generic
# pair above. Set as a pair or not at all.
# Per-surface OIDC clients. Each product brand has its own KC client so
# redirect URIs + web origins never mix (Shahin product users cannot be
# routed through the admin client, and vice versa). applyHostOverride
# in oidc.routes.ts picks the right pair based on the X-Forwarded-Host.
# Leave either pair blank to fall back to KEYCLOAK_OIDC_CLIENT_ID above.
KEYCLOAK_PRODUCT_OIDC_CLIENT_ID=shahin-bff
KEYCLOAK_PRODUCT_OIDC_CLIENT_SECRET=<SET_VIA_SECRETS_MANAGER>
KEYCLOAK_ADMIN_OIDC_CLIENT_ID=admin-portal
KEYCLOAK_ADMIN_OIDC_CLIENT_SECRET=<SET_VIA_SECRETS_MANAGER>
KEYCLOAK_ADMIN_WRITE_CLIENT_ID=<SET_VIA_SECRETS_MANAGER>
KEYCLOAK_ADMIN_WRITE_CLIENT_SECRET=<SET_VIA_SECRETS_MANAGER>
DAUTH_KEYCLOAK_ENFORCE=<SET_VIA_SECRETS_MANAGER>
DAUTH_ACCEPT_NATIVE_HS256=<SET_VIA_SECRETS_MANAGER>
DAUTH_OPENFGA_ENFORCE=<SET_VIA_SECRETS_MANAGER>

# ── OIDC browser-flow cookies (oidc.routes.ts) ──
# Apex domain shared by all per-product hostnames so the access/refresh
# cookies survive cross-host navigation between shahin-ai.com and the
# product subdomains. Must be set explicitly — oidc.routes.ts now treats
# COOKIE_DOMAIN as required() and refuses to start if it is missing.
COOKIE_DOMAIN=<SET_VIA_SECRETS_MANAGER>

# Tenant-service base URL used by the OIDC callback to dispatch
# POST /register (mode=register) or GET /me (mode=login) immediately after
# token exchange. Defaults to http://127.0.0.1:4002 when unset.
TENANT_SERVICE_URL=<SET_VIA_SECRETS_MANAGER>
