# ──────────────────────────────────────────────────────────────────────────
# analytics-service runtime env (ops-managed; .env is gitignored)
# Schema template — copy to ops/env/analytics-service.env, fill real values.
#
# SECRETS POLICY:
#   JWT_SECRET, JWT_REFRESH_SECRET, SECRETS_ENCRYPTION_KEY are sourced from
#   ops/env/platform.secrets.env (single source of truth). DO NOT redeclare
#   them here — PM2 load order would override the canonical values.
#
# CLICKHOUSE POLICY (Wave-1):
#   ClickHouse is OPTIONAL. No ClickHouse cluster is provisioned for Wave-1,
#   so this MUST be set to false. The /health endpoint treats ClickHouse as
#   "not applicable" when CLICKHOUSE_ENABLED!=true and reports clickhouse:ok.
#   Set to true only after a ClickHouse cluster is provisioned and the
#   `modules/analytics` module is restored to the workspace.
# ──────────────────────────────────────────────────────────────────────────

NODE_ENV=production
PORT=4024
LOG_LEVEL=info

# PostgreSQL (analytics warehouse + RLS)
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME
DB_POOL_MAX=10
RLS_ENABLED=true

# Redis (rate limit / cache)
REDIS_URL=redis://:REDACTED@127.0.0.1:6379/0

# ClickHouse — DISABLED for Wave-1 (see policy above)
CLICKHOUSE_ENABLED=false

# Inter-service URLs (loopback in single-host deployments)
AUTH_SERVICE_URL=http://127.0.0.1:4001
TENANT_SERVICE_URL=http://127.0.0.1:4002
USER_SERVICE_URL=http://127.0.0.1:4003

# ── DAuth / Keycloak verification ──
KEYCLOAK_BASE_URL=https://your-domain/login
KEYCLOAK_INTERNAL_BASE_URL=http://127.0.0.1:8180
KEYCLOAK_REALM=YOUR_REALM
KEYCLOAK_AUDIENCE=YOUR_AUDIENCE
KEYCLOAK_ISSUER=https://your-domain/login/realms/YOUR_REALM
KEYCLOAK_JWKS_URL=http://127.0.0.1:8180/login/realms/YOUR_REALM/protocol/openid-connect/certs
KEYCLOAK_JWKS_CACHE_TTL_MS=600000
DAUTH_ACCEPT_NATIVE_HS256=false
DAUTH_KEYCLOAK_ENFORCE=true
