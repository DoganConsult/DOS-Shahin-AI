# integrations-service — copy to integrations-service.env (untracked) and fill values.
# Default port 4026 matches packages/dos-platform-core service-client registry.

NODE_ENV=development
PORT=4026
LOG_LEVEL=info

DATABASE_URL=postgresql://dos_user:password@localhost:5432/dos_platform
DB_POOL_MAX=10

REDIS_URL=redis://localhost:6379
REDIS_PREFIX=dos:

AUTH_SERVICE_URL=http://127.0.0.1:4001
TENANT_SERVICE_URL=http://127.0.0.1:4002
USER_SERVICE_URL=http://127.0.0.1:4003
WORKFLOW_SERVICE_URL=http://127.0.0.1:4004
NOTIFICATION_SERVICE_URL=http://127.0.0.1:4005
AUDIT_SERVICE_URL=http://127.0.0.1:4006
AI_GATEWAY_SERVICE_URL=http://127.0.0.1:4007
GATEWAY_URL=http://127.0.0.1:4000

OTEL_TRACING_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SAMPLING_RATE=0.1

# ── OpenClaw bridge (dos-platform-core openclaw-bridge.ts) ─────────────────
# Execute path requires HTTP upstream. MCP URL is optional (tool listing).
# OPENCLAW_DISABLE=1 or true — disables OpenClaw entirely.
OPENCLAW_HTTP_BASE_URL=
# OPENCLAW_HTTP_TOOLS_PATH=/tools
# OPENCLAW_HTTP_RESOURCES_PATH=/resources
# OPENCLAW_HTTP_EXECUTE_PATH_TEMPLATE=/tools/{tool}/execute
OPENCLAW_MCP_GATEWAY_URL=
# MCP_GATEWAY_URL=

# External connectors (optional)
JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=
SERVICENOW_INSTANCE_URL=
SERVICENOW_USERNAME=
SERVICENOW_PASSWORD=
