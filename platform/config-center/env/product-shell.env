# Product-shell — serves the SPA + proxies /api/* to gateway.
# Canonical SPA path lives under products/shahin-ai/app (Shahin-AI is the first
# product inside the platform; the legacy "Shahin-AI Website/frontend" tree was
# moved in Batch 1 of the canonical-source restructure, and the legacy
# "Shahin-AI Website/spa" marketing tree was moved to products/shahin-ai/website
# in Phase 4A of the canonical-source restructure on 2026-04-29).
NODE_ENV=production
PORT=3000
LOG_LEVEL=info

GATEWAY_URL=http://127.0.0.1:4000

# PRODUCT_SHELL_SPA_DIR is the canonical env var (precedence #1 in server.ts).
# Leave unset → server.ts falls back to __dirname-anchored path (no hardcoded repo path).
# PRODUCT_SHELL_SPA_DIR=

PUBLIC_BASE_URL=https://shahin-ai.com
CORS_ALLOWED_ORIGINS=https://shahin-ai.com,https://www.shahin-ai.com
