# Keycloak — same-domain /login factory-reset topology.
#
# Loaded by the Keycloak systemd unit (NOT by PM2). Mirrored here so
# operators have a single source of canonical KC env values.
KC_HTTP_RELATIVE_PATH=/login
KC_HOSTNAME=https://shahin-ai.com/login
KC_HOSTNAME_STRICT=true
KC_HOSTNAME_STRICT_BACKCHANNEL=false
KC_HTTP_ENABLED=true
KC_PROXY_HEADERS=xforwarded
KC_HTTP_PORT=8180

# DB.
KC_DB=postgres
KC_DB_URL=jdbc:postgresql://127.0.0.1:5432/keycloak
KC_DB_USERNAME=keycloak
KC_DB_PASSWORD=d57921272933f2d3a94a6f1fbf42982791b8afdd74f96f89

# Realm + client expectations:
#   Realm:    dogan
#   Issuer:   https://shahin-ai.com/login/realms/dogan
#   Client:   shahin-bff
#   Redirect: https://shahin-ai.com/api/auth/oidc/callback
#             https://www.shahin-ai.com/api/auth/oidc/callback
#   Origins:  https://shahin-ai.com, https://www.shahin-ai.com
