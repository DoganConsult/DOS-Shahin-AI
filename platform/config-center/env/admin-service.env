# Platform Admin Service — service-specific env
PORT=4080
LOG_LEVEL=info
NODE_ENV=production

# CORS origins for /api/admin. The platform app (admin.dogan-ai.com) and the
# public landing (dogan-ai.com / www.dogan-ai.com) both call admin endpoints
# during whoami / config / health bootstraps.
ADMIN_CORS_ORIGINS=https://shahin-ai.com/login,https://dogan-ai.com,https://www.dogan-ai.com,http://localhost:3000,http://127.0.0.1:3000,http://localhost:4200,http://127.0.0.1:3010,http://localhost:3010

# Dev-headers off in production
ADMIN_ALLOW_DEV_HEADERS=0

# PM2 Dashboard (mounted at https://shahin-ai.com/admin/pm2/).
# HTTP Basic auth — intentionally outside the platform JWT layer so the
# fleet board stays reachable when KC/DAuth are degraded. Treat these as
# break-glass operator credentials.
#
# Whitelist model: PM2_DASHBOARD_ALLOWED_USERS is a comma-separated list of
# allowed Basic-auth usernames (emails). Any login that is NOT in this list
# is rejected with 401 even if the password is correct. The shared password
# below is the second gate. One login for all whitelisted operators.
PM2_DASHBOARD_ALLOWED_USERS=ahmet.dogan@doganconsult.com,doganlap@gmail.com
PM2_DASHBOARD_PASS=AhmEma$123456789
# Legacy single-user var kept for backward compat with older builds; the
# whitelist above takes precedence when both are set.
PM2_DASHBOARD_USER=ahmet.dogan@doganconsult.com
