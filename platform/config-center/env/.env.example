# Enterprise DOS Platform Environment Configuration
# Copy this file to .env.development, .env.staging, or .env.production and provide valid values.
# IMPORTANT: Variables marked with # SECRET must never be committed to source control.
# IMPORTANT: Variables marked with # PII control access to personally identifiable information.

# -----------------------------------------------------------------------------
# 1. CORE RUNTIME CONFIGURATION
# -----------------------------------------------------------------------------

# Defines the execution environment. Valid values: development, staging, production, test
NODE_ENV=development

# Core application listening port
PORT=3000

# Structured log verbosity. Valid values: trace, debug, info, warn, error, fatal
LOG_LEVEL=info

# -----------------------------------------------------------------------------
# 2. STATE STORAGE (DATABASE & CACHE)
# -----------------------------------------------------------------------------

# SECRET - PostgreSQL connection string. Must be properly secured.
# PII - Database contains user data, audit logs, and compliance records.
DATABASE_URL=postgresql://shahin:dev_password@localhost:5432/shahin_grc

# Maximum number of concurrent connections in the PG pool
DB_POOL_MAX=20

# Whether PostgreSQL requires an SSL connection
PG_SSL=false

# SECRET - Redis connection string used for caching, queues, and pub/sub.
# MUST embed auth when the target instance has `requirepass` set, otherwise
# the first command returns NOAUTH/WRONGPASS. validate-env.ts enforces this
# in production; set REDIS_ALLOW_NOAUTH=true to opt out for local dev.
REDIS_URL=redis://:CHANGE_ME_REDIS_PASSWORD@127.0.0.1:6379/0

# Prefix applied to all Redis keys for multi-tenancy isolation in a shared cluster
REDIS_PREFIX=dos:dev:

# -----------------------------------------------------------------------------
# 3. OBSERVABILITY & TRACING
# -----------------------------------------------------------------------------

# Toggles OpenTelemetry distributed tracing
OTEL_TRACING_ENABLED=false

# Endpoint for the OpenTelemetry collector (required if tracing is enabled)
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# Sampling rate for traces (0.0 to 1.0)
OTEL_SAMPLING_RATE=1.0

# -----------------------------------------------------------------------------
# 4. MICROSERVICE TOPOLOGY
# -----------------------------------------------------------------------------

# Public origin gateway for the client
GATEWAY_URL=http://localhost:4000

AUTH_SERVICE_URL=http://localhost:4001
TENANT_SERVICE_URL=http://localhost:4002
USER_SERVICE_URL=http://localhost:4003
WORKFLOW_SERVICE_URL=http://localhost:4004
NOTIFICATION_SERVICE_URL=http://localhost:4005
AUDIT_SERVICE_URL=http://localhost:4006
AI_GATEWAY_SERVICE_URL=http://localhost:4007

# -----------------------------------------------------------------------------
# 5. SECURITY & AUTHENTICATION
# -----------------------------------------------------------------------------

# SECRET - Cryptographic key used to sign JSON Web Tokens
JWT_SECRET=super-secure-dev-secret-do-not-use-in-prod

JWT_REFRESH_SECRET=super-secure-dev-refresh-secret-do-not-use-in-prod
SECRETS_ENCRYPTION_KEY=dev-secrets-encryption-key-do-not-use-in-prod
RLS_ENABLED=false

# Expiration window for access tokens (e.g., 15m, 1h)
JWT_EXPIRES_IN=1h

# Expiration window for refresh tokens
REFRESH_TOKEN_EXPIRES_IN=7d

# Idle timeout for user sessions
SESSION_TIMEOUT=30m

# SECRET - Shared secret key for Time-Based One-Time Passwords (MFA)
MFA_SECRET_KEY=dev-mfa-secret-key

# SECRET - PII Encryption key used for resting database fields
PII_ENCRYPTION_KEY=dev-pii-encryption-key-for-local-testing

# -----------------------------------------------------------------------------
# 6. EXTERNAL API INTEGRATIONS
# -----------------------------------------------------------------------------

# SECRET - Anthropic API key for AI generation tasks
# PII - May process prompts containing user data (must ensure PII redaction pipeline is active)
CLAUDE_API_KEY=

# SECRET - OpenAI API key
OPENAI_API_KEY=

# SECRET - Google GenAI API key
GOOGLE_AI_API_KEY=

# SECRET - Cohere API key
COHERE_API_KEY=

# -----------------------------------------------------------------------------
# 7. COMMUNICATIONS
# -----------------------------------------------------------------------------

# Outbound SMTP Mail Server Address
SMTP_HOST=localhost

# Outbound SMTP Port (e.g., 587, 465)
SMTP_PORT=1025

# SMTP Username for authentication
SMTP_USER=test

# SECRET - SMTP Password for authentication
SMTP_PASS=test

# SECRET - Corporate Slack integration webhook
SLACK_WEBHOOK_URL=

# SECRET - Corporate Microsoft Teams integration webhook
TEAMS_WEBHOOK_URL=

# -----------------------------------------------------------------------------
# 8. HARDENING & PROTECTION
# -----------------------------------------------------------------------------

# Enforce strict rate limiting profiles
ENABLE_REQUEST_RATE_LIMITING=false

# Global max requests per rolling window per IP
RATE_LIMIT_MAX=1000

# Rolling window duration for rate limits
RATE_LIMIT_WINDOW=1m

# Enables strict Input Sanitization via DOMPurify / Zod Coercion
ENABLE_INPUT_SANITIZATION=true

# Enables heuristic blocking of suspected SQL injection patterns
ENABLE_SQL_INJECTION_PROTECTION=true

# Content Security Policy protection
CSP_ENABLED=true

# -----------------------------------------------------------------------------
# 9. FRONTEND DIRECTIVES
# -----------------------------------------------------------------------------

# Path to the pre-compiled Angular SPA directory to serve via the shell
SPA_DIR=../../frontend/dist/shahin-grc/browser

# Google Analytics tracking ID
GA_TRACKING_ID=

# Toggle Analytics payload sending
ANALYTICS_ENABLED=false

# Phase 1: keys below were in the real env file but missing from this template.
# Added by Phase 1 secrets contract pass. Set real values via secrets manager.
ENABLE_AI_FEATURES=<SET_VIA_SECRETS_MANAGER>
ENABLE_ANALYTICS=<SET_VIA_SECRETS_MANAGER>
ENABLE_DEBUG_MODE=<SET_VIA_SECRETS_MANAGER>
ENABLE_METRICS=<SET_VIA_SECRETS_MANAGER>
METRICS_PORT=<SET_VIA_SECRETS_MANAGER>

# -----------------------------------------------------------------------------
# 10. SECURITY DISCLOSURE (RFC 9116 / SECURITY.md)
# -----------------------------------------------------------------------------
# Required by the gateway at boot. If SECURITY_CONTACT_EMAIL is missing or the
# SECURITY_EXPIRES date is in the past, /.well-known/security.txt returns 503
# and the gateway emits a validate-env warning. These values are rendered into
# the RFC 9116 advertisement and the JSON mirror at
# GET /api/public/security/policy. See /SECURITY.md for the full policy and
# services/gateway/src/schemas/security.schemas.ts for the config schema.

# Primary mailbox for vulnerability reports (RFC 9116 Contact field).
SECURITY_CONTACT_EMAIL=security@example.com

# Public URL of the human-readable policy (defaults to ${PUBLIC_BASE_URL}/security).
SECURITY_POLICY_URL=https://example.com/security

# Public base URL — used to build canonical + policy URLs when a request
# does not carry x-forwarded-host.
PUBLIC_BASE_URL=https://example.com

# OPTIONAL: public URL of the PGP key (RFC 9116 Encryption field).
SECURITY_PGP_KEY_URL=

# OPTIONAL: public URL of the hall-of-fame / acknowledgments page.
SECURITY_ACKNOWLEDGMENTS_URL=

# OPTIONAL: public URL of the security-hiring page.
SECURITY_HIRING_URL=

# RFC 9116 Preferred-Languages — comma-separated IETF BCP 47 tags (en, ar).
SECURITY_PREFERRED_LANGUAGES=en,ar

# ISO 8601 expiry of the advertisement. RFC 9116 recommends <= 1 year.
# When unset the gateway defaults to 180 days ahead of boot.
SECURITY_EXPIRES=

# Reporter-acknowledgement SLO in business days (default 2).
SECURITY_ACK_BUSINESS_DAYS=2

# Severity -> patch SLO (calendar days). Use `next` for next-release bucket.
# Format: "critical=7,high=30,medium=90,low=next,unknown=next".
SECURITY_PATCH_SLO=critical=7,high=30,medium=90,low=next,unknown=next

# -----------------------------------------------------------------------------
# 11. IDENTITY (Keycloak) — SAME-DOMAIN /login TOPOLOGY
# -----------------------------------------------------------------------------
# Canonical architecture (factory reset):
#   - ONE Keycloak realm (`dogan`) internally for both product and admin.
#   - Keycloak mounted under https://shahin-ai.com/login
#     (KC_HTTP_RELATIVE_PATH=/login). No auth.* subdomains, no dogan-ai.com.
#   - Browser/user sees shahin-ai.com only.
#   - Login uses Keycloak's built-in form (no SPA-side custom credential UI).
#
# See packages/dos-platform-core/src/auth-host-policy.ts for the SoT mapping:
#   product -> https://shahin-ai.com/login
#   admin   -> https://shahin-ai.com/login   (folded into the same host)
#
# The auth-service (platform/dauth/services/auth-service/src/routes/oidc.routes.ts)
# resolves the IdP base URL per request via X-Forwarded-Host.

# Public canonical Keycloak base (path-prefixed). Used by the auth-service to
# build authorization URLs, redirect URIs, and to validate the `iss` claim.
AUTH_PUBLIC_BASE=https://shahin-ai.com/login

# Keycloak admin base (backchannel — loopback inside the cluster).
KEYCLOAK_BASE_URL=http://127.0.0.1:8180
KEYCLOAK_REALM=dogan

# Single canonical issuer — no dual issuer, no auth.* hosts accepted.
KEYCLOAK_ISSUER=https://shahin-ai.com/login/realms/dogan
KEYCLOAK_WELL_KNOWN=https://shahin-ai.com/login/realms/dogan/.well-known/openid-configuration

# JWKS URL — backchannel via loopback. Public mirror is
# https://shahin-ai.com/login/realms/dogan/protocol/openid-connect/certs
KEYCLOAK_JWKS_URL=http://127.0.0.1:8180/login/realms/dogan/protocol/openid-connect/certs
KEYCLOAK_JWKS_URI=https://shahin-ai.com/login/realms/dogan/protocol/openid-connect/certs

# Single canonical OIDC callback (BFF on shahin-ai.com).
OIDC_REDIRECT_URI=https://shahin-ai.com/api/auth/oidc/callback
OIDC_CLIENT_ID=shahin-bff

# Keycloak server-side hostname-v2 settings — KC must believe it lives at
# /login under shahin-ai.com so issuer/static-resource URLs match nginx.
KC_HTTP_RELATIVE_PATH=/login
KC_HOSTNAME=https://shahin-ai.com/login
KC_HOSTNAME_STRICT=true
KC_PROXY_HEADERS=xforwarded
KC_HTTP_ENABLED=true

# Per-surface OIDC client credentials. The auth-service routes requests to
# the correct client based on getAuthSurface(host).
#   product  -> shahin-bff (or the brand's BFF client)
#   admin    -> admin-portal
# Fallback: if surface-specific envs are unset the generic KEYCLOAK_OIDC_*
# are used (keeps legacy single-client deploys working through the cutover).
KEYCLOAK_PRODUCT_OIDC_CLIENT_ID=prod-shahin-grc-bff
KEYCLOAK_PRODUCT_OIDC_CLIENT_SECRET=<SET_VIA_SECRETS_MANAGER>
KEYCLOAK_ADMIN_OIDC_CLIENT_ID=admin-portal
KEYCLOAK_ADMIN_OIDC_CLIENT_SECRET=<SET_VIA_SECRETS_MANAGER>

# Legacy / fallback generic client (used when per-surface envs above are unset).
KEYCLOAK_OIDC_CLIENT_ID=
KEYCLOAK_OIDC_CLIENT_SECRET=

# Optional audience check — when set the verifier enforces `aud` contains it.
KEYCLOAK_AUDIENCE=

# JWKS cache TTL in ms (default 600000 = 10 min).
KEYCLOAK_JWKS_CACHE_TTL_MS=600000

# Adapter mode flags. shadow = verify but allow native fallback; enforce = KC wins.
DAUTH_KEYCLOAK_SHADOW=true
DAUTH_KEYCLOAK_ENFORCE=false

# Provisioning (scripts/provision-keycloak-product.mjs) admin creds.
KEYCLOAK_ADMIN_WRITE_CLIENT_ID=admin-cli
KEYCLOAK_ADMIN_WRITE_CLIENT_SECRET=<SET_VIA_SECRETS_MANAGER>

# Per-product host override consumed by scripts/provision-keycloak-product.mjs
# (resolveHostsFor). Comma-separated product-facing hostnames that the brand
# owns. Used to build redirectUris, webOrigins, rootUrl, post-logout URIs on
# the confidential + public clients. If unset the script falls back to the
# built-in registry (shahin* -> shahin-ai.com) or `<code>.dogan-ai.com`.
PRODUCT_HOST_SHAHIN_GRC=shahin-ai.com,www.shahin-ai.com
# AUTH_HOST_SHAHIN_GRC=auth.shahin-ai.com    # derived from first product host if unset

# Keycloak server (container) side — required so KC honours X-Forwarded-Host
# from nginx and emits the per-brand hostname in authorization URLs + issuer
# claims + JWKS URLs. Without these the issuer drifts to the upstream host
# and id_token `iss` no longer matches KEYCLOAK_ISSUER.
KC_HOSTNAME_STRICT=false
KC_HOSTNAME_STRICT_HTTPS=true
KC_PROXY=edge
KC_HTTP_ENABLED=true
