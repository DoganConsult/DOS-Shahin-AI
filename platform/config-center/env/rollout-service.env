# rollout-service — DOS Master Phase 1 PM2 enrollment (2026-05-04)
# Ports SoT: platform/config-center/ops/ports.allocation.json
# Shared cryptographic secrets are loaded from platform.secrets.env.

NODE_ENV=production
PORT=4017
LOG_LEVEL=info

# Database (DOS Master controlled tables — actor enforced via dos.actor session GUC).
DATABASE_URL=postgresql://dos_auth:dos_auth_pass_2026@localhost:5432/shahin_grc
DB_POOL_MAX=5

# Redis (cache + locks + rate limiter).
REDIS_URL=redis://:d57921272933f2d3a94a6f1fbf42982791b8afdd74f96f89@127.0.0.1:6379/0
REDIS_PREFIX=dos:

# Internal service mesh.
AUTH_SERVICE_URL=http://127.0.0.1:4001
TENANT_SERVICE_URL=http://127.0.0.1:4002
USER_SERVICE_URL=http://127.0.0.1:4003
NOTIFICATION_SERVICE_URL=http://127.0.0.1:4005
AUDIT_SERVICE_URL=http://127.0.0.1:4006
GATEWAY_URL=http://127.0.0.1:4000

INTER_SERVICE_SECRET=local-dev-inter-service-secret-rotate-2026-04-28

# DOS Master writer identity (Doctrine Article 11). All writes go via
# masterQuery() which sets dos.actor='dos-master' on every connection.
DOS_MASTER_ACTOR=dos-master

# ── L29 (Phase 3 D2) — admin-zone mTLS (ops-approved flip 2026-05-04). ──
# Local CA minted under platform/config-center/secrets/admin-mtls/ (NOT committed).
MTLS_ENFORCE=1
MTLS_REQUIRED=true
ADMIN_MTLS_CA=/root/DOS-Platform/platform/config-center/secrets/admin-mtls/ca.crt
ADMIN_MTLS_CERT=/root/DOS-Platform/platform/config-center/secrets/admin-mtls/rollout-service.crt
ADMIN_MTLS_KEY=/root/DOS-Platform/platform/config-center/secrets/admin-mtls/rollout-service.key
MTLS_REJECT_UNAUTHORIZED=1
