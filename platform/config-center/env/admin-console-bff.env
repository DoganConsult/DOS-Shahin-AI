# admin-console-bff — DOS Master Phase 1 PM2 enrollment (2026-05-04)
# Ports SoT: platform/config-center/ops/ports.allocation.json
# Shared cryptographic secrets are loaded from platform.secrets.env.

NODE_ENV=production
PORT=4013
LOG_LEVEL=info

# Database (DOS Master controlled tables — actor enforced via dos.actor session GUC).
DATABASE_URL=postgresql://dos_auth:dos_auth_pass_2026@localhost:5432/shahin_grc
DB_POOL_MAX=5

# Redis (cache + locks + rate limiter).
REDIS_URL=redis://:d57921272933f2d3a94a6f1fbf42982791b8afdd74f96f89@127.0.0.1:6379/0
REDIS_PREFIX=dos:

# Internal service mesh.
AUTH_SERVICE_URL=http://127.0.0.1:4001
TENANT_SERVICE_URL=http://127.0.0.1:4002
USER_SERVICE_URL=http://127.0.0.1:4003
NOTIFICATION_SERVICE_URL=http://127.0.0.1:4005
AUDIT_SERVICE_URL=http://127.0.0.1:4006
GATEWAY_URL=http://127.0.0.1:4000

INTER_SERVICE_SECRET=local-dev-inter-service-secret-rotate-2026-04-28

# DOS Master writer identity (Doctrine Article 11). All writes go via
# masterQuery() which sets dos.actor='dos-master' on every connection.
DOS_MASTER_ACTOR=dos-master

# ── M15 D1 (B) — Keycloak `platform-ops` realm verifier ──────────────────
# DOCTRINE: Article 4 (separate admin realm), Article 5 (no fake-green),
#           Article 7 (PPD-gated flip), §10 (no autonomous KC provisioning).
# DISABLED BY DEFAULT. Flip KC_REQUIRE=1 ONLY via PPD ring R0..R5 after ops
# provisions the platform-ops realm + client credentials + audience.
KC_REQUIRE=0
KC_REALM=platform-ops
KC_ISSUER=
KC_JWKS_URL=
KC_AUDIENCE=admin-console-bff

# ── M15 D1 (C) — admin-zone mTLS env hooks (gateway → :4013) ─────────────
# DOCTRINE: Article 4 (admin-zone mTLS required), Article 5 (no fake-green),
#           Article 7 (PPD-gated flip), §10 (no autonomous CA mint).
# DISABLED BY DEFAULT. Flip MTLS_ENFORCE=1 ONLY after ops provisions the
# CA + service cert. Guard `mtls-required-on-admin-zone` will tighten its
# baseline once these three vars contain non-empty paths and MTLS_ENFORCE=1.
MTLS_ENFORCE=0
ADMIN_MTLS_CA=
ADMIN_MTLS_CERT=
ADMIN_MTLS_KEY=
MTLS_REJECT_UNAUTHORIZED=1
