# dynamic-ui-service — PG-backed Dynamic UI HTTP API (:4015 by default in ops/ecosystem.m1.config.js).
# Copy to ops/env/dynamic-ui-service.env and set DATABASE_URL (same DB as gateway shell is fine).

NODE_ENV=production
LOG_LEVEL=info
PORT=4015

# Required. Role must have USAGE on schema `dos` and SELECT on dos.dynamic_ui_* tables.
# After applying SQL as a superuser, run ops/sql/grant-dynamic-ui-readonly-dos-auth.sql if the app role is dos_auth.
DATABASE_URL=<SET_VIA_SECRETS_MANAGER>
