# Template generated in Phase 1 from the real tracked env file's KEY NAMES.
# Populate real values via the secrets manager at deploy time.
# Real env file is now untracked (.gitignore).

NODE_ENV=<SET_VIA_SECRETS_MANAGER>
PORT=<SET_VIA_SECRETS_MANAGER>
LOG_LEVEL=<SET_VIA_SECRETS_MANAGER>
DATABASE_URL=<SET_VIA_SECRETS_MANAGER>
DB_POOL_MAX=<SET_VIA_SECRETS_MANAGER>
AUTH_SERVICE_URL=<SET_VIA_SECRETS_MANAGER>
SECRETS_ENCRYPTION_KEY=<SET_VIA_SECRETS_MANAGER>

# Self-registration role policy (Patch 1).
# Default role granted to a self-registered user. Owner is reserved for the
# legal representative / billing principal and is promoted via a verified
# flow (out of self-registration scope).
DEFAULT_REGISTRATION_ROLE=tenant_admin

# Hard-fail /register when orgName is missing. Toggle to `false` ONLY during
# the cutover sprint when Keycloak hasn't yet been re-provisioned with the
# new user-profile (companyNameEn required).
REQUIRE_ORG_NAME=true
