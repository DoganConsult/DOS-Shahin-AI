# Runtime environment (development | staging | production | test)
NODE_ENV=production
# Service listen port
PORT=3000
# Structured log verbosity (fatal error warn info debug trace)
LOG_LEVEL=warn

# Database
# SECRET - Secure Postgres connection URL
DATABASE_URL=postgresql://db_user:password@db-prod.internal:5432/shahin_grc
DB_POOL_MAX=100

# Redis 
# SECRET - ElastiCache or Redis cluster
REDIS_URL=redis://redis-prod.internal:6379
REDIS_PREFIX=dos:prod:

# Observability
OTEL_TRACING_ENABLED=true
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
OTEL_SAMPLING_RATE=0.1

# Auth / new-user journey (production — MUST be vault-backed, never committed real values)
# SECRET - JWT signing secret for access tokens (>=32 chars, high entropy)
JWT_SECRET=production-replace-with-64-char-random-hex-value-fedcba9876543210abcdef
# SECRET - Separate signing secret for refresh tokens
JWT_REFRESH_SECRET=production-replace-with-64-char-random-hex-value-fedcba9876543210abcdef
# SECRET - HMAC key for email verification payloads
EMAIL_VERIFY_SIGNING_KEY=production-replace-with-64-char-random-hex-value-fedcba9876543210abcdef
# SECRET - SSE stream authentication / signing
SSE_STREAM_KEY=production-replace-with-64-char-random-hex-value-fedcba9876543210abcdef
# SECRET - Captcha provider secret
CAPTCHA_SECRET=production-replace-with-64-char-random-hex-value-fedcba9876543210abcdef

# Outbound email (production provider)
# SMTP host for transactional email
SMTP_HOST=smtp-prod.internal
# SMTP port (587 TLS typical)
SMTP_PORT=587
# SMTP auth username
SMTP_USER=notifications-prod
# SECRET - SMTP password
SMTP_PASS=production-smtp-password-min-8-chars
