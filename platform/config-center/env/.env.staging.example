# Staging Environment Configuration Template
# Copy to .env.staging and fill in actual values for staging deployment

# Environment Configuration
NODE_ENV=staging
PORT=3000
LOG_LEVEL=info

# Database Configuration
# SECRET - Production database connection
DATABASE_URL=postgresql://user:password@staging-db.example.com:5432/dos_staging
DB_POOL_MAX=20

# Redis Configuration
# SECRET - Production Redis cluster
REDIS_URL=redis://staging-redis.example.com:6379
REDIS_PREFIX=dos:staging:

# Observability Configuration
OTEL_TRACING_ENABLED=true
OTEL_EXPORTER_OTLP_ENDPOINT=https://staging-otel.example.com:4317
OTEL_SAMPLING_RATE=0.1

# Service URLs
GATEWAY_URL=https://staging-api.dos-platform.com
AUTH_SERVICE_URL=http://auth-service:4001
TENANT_SERVICE_URL=http://tenant-service:4002
USER_SERVICE_URL=http://user-service:4003
WORKFLOW_SERVICE_URL=http://workflow-service:4004
NOTIFICATION_SERVICE_URL=http://notification-service:4005
AUDIT_SERVICE_URL=http://audit-service:4006
AI_GATEWAY_SERVICE_URL=http://ai-gateway-service:4007

# Feature Flags
ENABLE_AI_FEATURES=true
ENABLE_ANALYTICS=true
ENABLE_DEBUG_MODE=false
ENABLE_BETA_FEATURES=true
ENABLE_MULTI_TENANT=true

# Security Configuration
# SECRET - JWT signing key (min 32 chars, generate with: openssl rand -base64 32)
JWT_SECRET=your-staging-jwt-secret-here
JWT_EXPIRES_IN=1h
REFRESH_TOKEN_EXPIRES_IN=7d
SESSION_TIMEOUT=30m

# SECRET - MFA TOTP secret key
MFA_SECRET_KEY=your-staging-mfa-secret-here

# SECRET - SCIM provisioning webhook secret
SCIM_SECRET=your-staging-scim-secret-here

# AI Services
# SECRET - External API keys for AI services
CLAUDE_API_KEY=your-staging-claude-api-key
OPENAI_API_KEY=your-staging-openai-api-key
GOOGLE_AI_API_KEY=your-staging-google-ai-api-key
COHERE_API_KEY=your-staging-cohere-api-key

# Communication Services
SMTP_HOST=smtp.staging.example.com
SMTP_PORT=587
# SECRET - SMTP credentials
SMTP_USER=staging@dos-platform.com
SMTP_PASS=your-staging-smtp-password

# SECRET - Webhook URLs for notifications
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/STAGING/SLACK/WEBHOOK
TEAMS_WEBHOOK_URL=https://outlook.office.com/webhook/YOUR-STAGING-TEAMS-WEBHOOK

# Frontend Configuration
SPA_DIR=/app/dist/shahin-grc/browser
CSP_ENABLED=true
HSTS_ENABLED=true
ANALYTICS_ENABLED=true
# SECRET - Google Analytics
GA_TRACKING_ID=GA-STAGING-TRACKING-ID

# Performance & Scaling
ENABLE_METRICS=true
METRICS_PORT=9090
CLUSTER_MODE=false
CLUSTER_INSTANCES=2
RATE_LIMIT_WINDOW=60s
RATE_LIMIT_MAX=200

# Monitoring & Observability
HEALTH_CHECK_INTERVAL=30s
HEALTH_CHECK_TIMEOUT=5s
GRACEFUL_SHUTDOWN_TIMEOUT=30s
MEMORY_LIMIT_MB=1024
CPU_LIMIT_PERCENT=80

# Data & Backup
BACKUP_ENABLED=true
BACKUP_SCHEDULE=0 2 * * *
BACKUP_RETENTION_DAYS=30
DATA_EXPORT_ENABLED=true
# SECRET - PII encryption key
PII_ENCRYPTION_KEY=your-staging-pii-encryption-key

# Compliance & Audit
AUDIT_LOG_RETENTION_DAYS=2555
COMPLIANCE_MODE=SOC2
DATA_CLASSIFICATION_ENABLED=true
GDPR_COMPLIANT=true
PDPL_COMPLIANT=true

# Phase 1: keys below were in the real env file but missing from this template.
# Added by Phase 1 secrets contract pass. Set real values via secrets manager.
CAPTCHA_SECRET=<SET_VIA_SECRETS_MANAGER>
EMAIL_VERIFY_SIGNING_KEY=<SET_VIA_SECRETS_MANAGER>
JWT_REFRESH_SECRET=<SET_VIA_SECRETS_MANAGER>
SSE_STREAM_KEY=<SET_VIA_SECRETS_MANAGER>
