NODE_ENV=production
PORT=4004
LOG_LEVEL=info
DATABASE_URL=postgresql://dos_workflow:dos_workflow_pass_2026@localhost:5432/shahin_grc
DB_POOL_MAX=10
AUTH_SERVICE_URL=http://127.0.0.1:4001
TENANT_SERVICE_URL=http://127.0.0.1:4002

# ── DAuth Enterprise Stack (DAuth-ECP-COMPLETE) ──
# These flags activate the Keycloak/OpenFGA/Cerbos adapters under DAuth at
# bootstrap. Source of truth is ops/env/.env.shared — this block mirrors
# the subset PM2 process env must see. Secrets (KEYCLOAK_ADMIN_WRITE_CLIENT_SECRET,
# VAULT_TOKEN) are NOT kept here — operator loads those from /etc/keycloak/*.
OPENFGA_ENABLED=true
OPENFGA_API_URL=http://localhost:8080
OPENFGA_STORE_ID=01KNSF17SBJBCF4H0E4KZM15EQ
OPENFGA_MODEL_ID=01KPKCHMEWKZ4C27JQ92NF6F52
OPENFGA_API_TOKEN=
# Keycloak — aligned with .env.shared / platform-wide dogan realm after
# the Shahin cutover. The previous master/dos-auth values pre-dated the
# realm switch and made workflow-service reject every Keycloak-issued
# token with INVALID_TOKEN (wrong JWKS realm, wrong audience).
KEYCLOAK_BASE_URL=https://shahin-ai.com/login
KEYCLOAK_INTERNAL_BASE_URL=http://127.0.0.1:8180
KEYCLOAK_REALM=dogan
KEYCLOAK_CLIENT_ID=shahin-bff
KEYCLOAK_JWKS_URL=http://127.0.0.1:8180/login/realms/dogan/protocol/openid-connect/certs
KEYCLOAK_ISSUER=https://shahin-ai.com/login/realms/dogan,https://shahin-ai.com/login/realms/dogan
KEYCLOAK_AUDIENCE=shahin-bff
KEYCLOAK_JWKS_CACHE_TTL_MS=600000
KEYCLOAK_TARGET_REALM=dogan
KEYCLOAK_TARGET_AUDIENCE=shahin-bff
KEYCLOAK_TARGET_CLIENT_BFF=shahin-bff
KEYCLOAK_TARGET_CLIENT_WEB=shahin-web
KEYCLOAK_ADMIN_WRITE_CLIENT_ID=
KEYCLOAK_LOGIN_CLIENT_ID=
KEYCLOAK_LOGIN_CLIENT_SECRET=
REGISTER_USE_KEYCLOAK_FIRST=true
LOGIN_USE_KEYCLOAK=true
DAUTH_ACCEPT_NATIVE_HS256=true
DAUTH_KEYCLOAK_SHADOW=true
DAUTH_KEYCLOAK_ENFORCE=true
OPENFGA_TIMEOUT_MS=250
DAUTH_OPENFGA_SHADOW=true
DAUTH_OPENFGA_ENFORCE=true
CERBOS_PDP_URL=http://127.0.0.1:3592
CERBOS_TLS_ENABLED=false
CERBOS_TIMEOUT_MS=250
DAUTH_CERBOS_SHADOW=true
DAUTH_CERBOS_ENFORCE=false
DAUTH_VAULT_ENABLED=false
VAULT_ADDR=
VAULT_MOUNT=secret
DAUTH_DECISION_LEDGER_ENABLED=true
DAUTH_POLICY_SIMULATION_ENABLED=true
DAUTH_ACCESS_REPLAY_ENABLED=true
DAUTH_RLS_FAIL_CLOSED=true
