# =============================================================================
# DOS Platform — Single Source of Truth for shared cryptographic secrets.
# =============================================================================
#
# POLICY (enforced by ops/ecosystem.all.config.js):
#   - This is the ONLY file in the platform that defines JWT_SECRET,
#     JWT_REFRESH_SECRET, and SECRETS_ENCRYPTION_KEY.
#   - Per-service ops/env/<svc>.env files MUST NOT redeclare these keys.
#   - PM2 load order:  COMMON  →  platform.secrets  →  <service>.env  →  PORT
#   - Mode 0600. Gitignored (covered by `ops/env/*.env` in .gitignore).
#
# RATIONALE:
#   - SECRETS_ENCRYPTION_KEY is used to encrypt at-rest data; a second value
#     would silently corrupt previously-encrypted records. One value, one home.
#   - JWT_SECRET / JWT_REFRESH_SECRET must match across every service that
#     issues or verifies tokens. Drift = silent auth failure.
#
# ROTATION:
#   - Update here, then `pm2 reload all` → all consumers pick up atomically.
#   - For SECRETS_ENCRYPTION_KEY rotation, follow the key-rotation runbook
#     (re-encrypt at-rest payloads before retiring the previous key).
# =============================================================================

# JWT signing secret (≥32 chars, hex-256). Validated by @dos/dos-service-bootstrap.
JWT_SECRET=ebc91e252bf7727f16ac7ebfdcb20f1fa2ef139809259cd134c14aed0b76d4e4

# JWT refresh signing secret (≥32 chars, hex-256). Validated by @dos/dos-service-bootstrap.
JWT_REFRESH_SECRET=2d6ca41b89e03cff65e24439ae52a1eac3227666baa622c8bb2dc48595683142

# AES-256 at-rest encryption key (32-byte hex). Validated by @dos/dos-service-bootstrap.
SECRETS_ENCRYPTION_KEY=dd88a344371747f471bc5afd675cdcd3eb656ceca9532351d76c7b5a85b73776

# Row-Level Security gate (Phase 2 tenant-safety).
# @dos/runtime-config refuses to boot any service in production unless this
# is exactly "true". packages/dos-db/src/tenant.ts only sets the
# app.current_tenant_id / app.current_user_id GUCs when RLS_ENABLED='true'.
# Defined here in the platform-wide secrets file so every PM2 app inherits
# it via the COMMON → platform.secrets → <svc>.env merge in
# ops/ecosystem.platform.config.js.
RLS_ENABLED=true

# Redis connection (used by @dos/db's buildRedisOptions in
# packages/dos-db/src/redis.ts which reads discrete REDIS_* vars,
# NOT REDIS_URL). Defined here so every PM2 app inherits the
# auth-protected local instance via the COMMON merge.
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=d57921272933f2d3a94a6f1fbf42982791b8afdd74f96f89
REDIS_DB=0

# Single-source REDIS_URL for any client that constructs ioredis from a URL
# instead of discrete REDIS_* vars. Examples:
#   - packages/dos-event-backbone/src/redis-stream-bus.ts (event bus)
#   - packages/dos-service-bootstrap/src/distributed-lock.ts (redlock)
#   - services/notification-service/src/routes/events.routes.ts (SSE pub/sub)
# Per-service env files MAY override (e.g. auth-service uses DB /1) but
# MUST NOT drop the password. validate-env.ts enforces presence in production.
REDIS_URL=redis://:d57921272933f2d3a94a6f1fbf42982791b8afdd74f96f89@127.0.0.1:6379/0

# Cryptographic origin proof for hop-by-hop service trust.
# The gateway signs an HS256 token in `x-gateway-origin` for every authenticated
# request (see services/gateway/src/server.ts::injectIdentityHeaders). Every
# downstream service that consumes the gatewayOriginGuard middleware (tenant,
# governance-policy, risk-incident, evidence-audit-reporting, asset, vendor,
# bcp, privacy, dora, compliance, etc.) MUST verify with the same secret —
# otherwise gateway-routed traffic 500s with CONFIG_ERROR/NO_GATEWAY_SECRET.
# Promoted to platform.secrets so every PM2 app inherits via the
# COMMON → platform.secrets → <svc>.env merge in
# ops/ecosystem.platform.config.js. Single source — do NOT redeclare per-service.
GATEWAY_ORIGIN_HMAC_SECRET=edaea84ef5aac336f1a948f92a21f1d81c655bccf0c383a8d04e99c692ddbd8c

# Keycloak RS256 verification — required by every PM2 service that accepts
# user bearer tokens. Without these, packages/dos-service-bootstrap's
# bootstrapDauth() call cannot register the KeycloakTokenVerifier; the
# canonical authenticate middleware then falls back to HS256 jwt.verify and
# rejects every KC-issued token with {"error":"Invalid or expired token",
# "code":"INVALID_TOKEN"} — observed Wave B 2026-04-30 across risk/governance/
# admin/policy/evidence/vendor/asset/bcp/privacy/dora prefixes.
# Single source for the entire fleet — do NOT redeclare in <svc>.env.
KEYCLOAK_BASE_URL=https://shahin-ai.com/login
KEYCLOAK_INTERNAL_BASE_URL=http://127.0.0.1:8180
KEYCLOAK_REALM=dogan
KEYCLOAK_CLIENT_ID=shahin-bff
KEYCLOAK_AUDIENCE=shahin-bff
KEYCLOAK_ISSUER=https://shahin-ai.com/login/realms/dogan
KEYCLOAK_JWKS_URL=http://127.0.0.1:8180/login/realms/dogan/protocol/openid-connect/certs
KEYCLOAK_JWKS_CACHE_TTL_MS=600000
DAUTH_KEYCLOAK_ENFORCE=true
DAUTH_ACCEPT_NATIVE_HS256=false
