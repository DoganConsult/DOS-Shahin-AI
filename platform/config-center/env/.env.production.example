# Production Environment Configuration Template
# Copy to .env.production and fill in actual values for production deployment
# CRITICAL: Ensure all SECRET variables are properly secured in production

# Environment Configuration
NODE_ENV=production
PORT=3000
LOG_LEVEL=warn

# Database Configuration
# SECRET - Production database connection (highly secure)
DATABASE_URL=postgresql://user:password@prod-db.example.com:5432/dos_production
DB_POOL_MAX=50

# Redis Configuration
# SECRET - Production Redis cluster (highly secure)
REDIS_URL=redis://prod-redis-cluster.example.com:6379
REDIS_PREFIX=dos:prod:

# Observability Configuration
OTEL_TRACING_ENABLED=true
OTEL_EXPORTER_OTLP_ENDPOINT=https://otel.example.com:4317
OTEL_SAMPLING_RATE=0.05

# Service URLs — full mesh.
# Every URL below is REQUIRED in production; the gateway's
# validateRequiredServiceUrls() (services/gateway/src/domain/service-registry.ts)
# throws at boot if any is missing under NODE_ENV=production.
# Canonical list + ports + PM2 app names lives in docs/FULL-MESH-ENV-VARS.md.
GATEWAY_URL=https://api.dos-platform.com
AUTH_SERVICE_URL=http://auth-service:4001
TENANT_SERVICE_URL=http://tenant-service:4002
USER_SERVICE_URL=http://user-service:4003
WORKFLOW_SERVICE_URL=http://workflow-service:4004
NOTIFICATION_SERVICE_URL=http://notification-service:4005
AUDIT_SERVICE_URL=http://audit-service:4006
AI_GATEWAY_SERVICE_URL=http://ai-gateway-service:4007
AI_ENGINE_SERVICE_URL=http://ai-engine-service:4008
ONBOARDING_SERVICE_URL=http://onboarding-service:4010
GOVERNANCE_POLICY_SERVICE_URL=http://governance-policy-service:4011
COMPLIANCE_CONTROLS_SERVICE_URL=http://compliance-controls-service:4012
RISK_INCIDENT_SERVICE_URL=http://risk-incident-service:4013
EVIDENCE_AUDIT_REPORTING_SERVICE_URL=http://evidence-audit-reporting-service:4014
VENDOR_SERVICE_URL=http://vendor-service:4015
ASSET_SERVICE_URL=http://asset-service:4016
BCP_SERVICE_URL=http://bcp-service:4017
TRAINING_SERVICE_URL=http://training-service:4018
PRIVACY_SERVICE_URL=http://privacy-service:4019
DORA_SERVICE_URL=http://dora-service:4020
REMEDIATION_ACTION_SERVICE_URL=http://remediation-action-service:4021
QIYAS_JOURNEY_SERVICE_URL=http://qiyas-journey-service:4022
DASHBOARD_WIDGETS_SERVICE_URL=http://dashboard-widgets-service:4023
ANALYTICS_SERVICE_URL=http://analytics-service:4024
EXECUTIVE_INTELLIGENCE_SERVICE_URL=http://executive-intelligence-service:4025
INTEGRATIONS_SERVICE_URL=http://integrations-service:4026
NOTIFICATION_INBOX_SERVICE_URL=http://notification-inbox-service:4027
PORTALS_SERVICE_URL=http://portals-service:4028
RECORDS_SERVICE_URL=http://records-service:4029
PLATFORM_PRODUCT_SERVICE_URL=http://platform-product-service:4030
AGRC_OS_SERVICE_URL=http://agrc-os-service:4031

# Gateway AI safety flag — Phase 3E + Phase 12C.
# AI_ENABLED=false blocks /api/ai, /api/ai-gateway, /api/ai-engine,
# /api/ai-enhanced, /api/ai-os, /api/agrc-os, /api/autonomous, /api/copilot,
# /api/nudges, /api/mcp at the gateway so no Claude-billing request can reach
# the AI services even if a user deep-links a POST.
# AI_ENABLED=true opens the safety gate. Every AI billing-sensitive path is
# additionally protected by per-user + per-tenant + per-IP rate limits (see
# AI_RATE_* below) and by per-route authenticate + requirePermission +
# requireTenantId middleware. Phase 12C certified enablement in production
# on 2026-04-19.
AI_ENABLED=true

# Gateway AI billing guard — Phase 12C.
# Per-user, per-tenant, per-IP request caps for every AI-billed prefix
# (/api/copilot, /api/ai-engine, /api/ai-gateway, /api/ai-enhanced, /api/ai-os,
# /api/agrc-os, /api/mcp, /api/ai/*). Sliding-window (60s). Ops can tighten
# without a redeploy. Defaults are conservative for first production
# customer; raise with tenant tier.
AI_RATE_PER_USER_PER_MIN=30
AI_RATE_PER_TENANT_PER_MIN=200
AI_RATE_IP_PER_MIN=100

# Claude client caps (read by ai-engine-service). Hard ceiling per call.
# Request timeout is fixed at 120s in the client; max retries at 3.
CLAUDE_MAX_TOKENS=4096

# Feature Flags
ENABLE_AI_FEATURES=true
ENABLE_ANALYTICS=true
ENABLE_DEBUG_MODE=false
ENABLE_BETA_FEATURES=false
ENABLE_MULTI_TENANT=true

# Security Configuration
# SECRET - JWT signing key (min 32 chars, generate with: openssl rand -base64 64)
JWT_SECRET=your-production-jwt-secret-very-long-and-secure
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d
SESSION_TIMEOUT=15m

# SECRET - MFA TOTP secret key
MFA_SECRET_KEY=your-production-mfa-secret-very-long-and-secure

# SECRET - SCIM provisioning webhook secret
SCIM_SECRET=your-production-scim-secret-very-long-and-secure

# AI Services
# SECRET - External API keys for AI services
CLAUDE_API_KEY=your-production-claude-api-key
OPENAI_API_KEY=your-production-openai-api-key
GOOGLE_AI_API_KEY=your-production-google-ai-api-key
COHERE_API_KEY=your-production-cohere-api-key

# Communication Services
SMTP_HOST=smtp.example.com
SMTP_PORT=587
# SECRET - SMTP credentials (highly secure)
SMTP_USER=noreply@dos-platform.com
SMTP_PASS=your-production-smtp-password

# SECRET - Webhook URLs for notifications
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/PRODUCTION/SLACK/WEBHOOK
TEAMS_WEBHOOK_URL=https://outlook.office.com/webhook/YOUR-PRODUCTION-TEAMS-WEBHOOK

# Frontend Configuration
SPA_DIR=/app/dist/shahin-grc/browser
CSP_ENABLED=true
HSTS_ENABLED=true
ANALYTICS_ENABLED=true
# SECRET - Google Analytics
GA_TRACKING_ID=GA-PRODUCTION-TRACKING-ID

# Performance & Scaling
ENABLE_METRICS=true
METRICS_PORT=9090
CLUSTER_MODE=true
CLUSTER_INSTANCES=4
RATE_LIMIT_WINDOW=60s
RATE_LIMIT_MAX=1000

# Monitoring & Observability
HEALTH_CHECK_INTERVAL=15s
HEALTH_CHECK_TIMEOUT=3s
GRACEFUL_SHUTDOWN_TIMEOUT=15s
MEMORY_LIMIT_MB=2048
CPU_LIMIT_PERCENT=85

# Data & Backup
BACKUP_ENABLED=true
BACKUP_SCHEDULE=0 3 * * *
BACKUP_RETENTION_DAYS=90
DATA_EXPORT_ENABLED=true
# SECRET - PII encryption key (highly secure)
PII_ENCRYPTION_KEY=your-production-pii-encryption-key-very-long-and-secure

# Compliance & Audit
AUDIT_LOG_RETENTION_DAYS=2555
COMPLIANCE_MODE=SOC2,ISO27001,GDPR,PDPL
DATA_CLASSIFICATION_ENABLED=true
GDPR_COMPLIANT=true
PDPL_COMPLIANT=true

# Production Security Hardening
ENABLE_REQUEST_RATE_LIMITING=true
ENABLE_IP_WHITELISTING=false
ENABLE_INPUT_SANITIZATION=true
ENABLE_SQL_INJECTION_PROTECTION=true
ENABLE_XSS_PROTECTION=true
ENABLE_CSRF_PROTECTION=true

# Production Monitoring
ENABLE_PERFORMANCE_MONITORING=true
ENABLE_ERROR_TRACKING=true
ENABLE_USER_BEHAVIOR_TRACKING=true
ENABLE_SECURITY_EVENT_LOGGING=true

# Production Scaling
AUTO_SCALE_ENABLED=true
MIN_INSTANCES=2
MAX_INSTANCES=10
SCALE_UP_THRESHOLD=80
SCALE_DOWN_THRESHOLD=30
SCALE_UP_COOLDOWN=300s
SCALE_DOWN_COOLDOWN=600s

# Phase 1: keys below were in the real env file but missing from this template.
# Added by Phase 1 secrets contract pass. Set real values via secrets manager.
CAPTCHA_SECRET=<SET_VIA_SECRETS_MANAGER>
EMAIL_VERIFY_SIGNING_KEY=<SET_VIA_SECRETS_MANAGER>
JWT_REFRESH_SECRET=<SET_VIA_SECRETS_MANAGER>
SECRETS_ENCRYPTION_KEY=<SET_VIA_SECRETS_MANAGER>
RLS_ENABLED=true
PG_SSL=true
PG_SSL_CA=/etc/ssl/certs/postgres-ca.pem
SSE_STREAM_KEY=<SET_VIA_SECRETS_MANAGER>
