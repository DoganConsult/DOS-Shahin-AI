# Runtime environment (development | staging | production | test)
NODE_ENV=staging
# Service listen port
PORT=3000
# Structured log verbosity (fatal error warn info debug trace)
LOG_LEVEL=info

# Database
# SECRET - Secure Postgres connection URL
DATABASE_URL=postgresql://db_user:password@db-staging.internal:5432/shahin_grc
DB_POOL_MAX=25

# Redis 
# SECRET - ElastiCache or Redis cluster
REDIS_URL=redis://redis-staging.internal:6379
REDIS_PREFIX=dos:staging:

# Observability
OTEL_TRACING_ENABLED=true
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
OTEL_SAMPLING_RATE=1.0

# Auth / new-user journey (staging — replace with vault-backed values)
# SECRET - JWT signing secret for access tokens (>=32 chars, high entropy)
JWT_SECRET=staging-replace-with-64-char-random-hex-value-fedcba9876543210abcdef
# SECRET - Separate signing secret for refresh tokens
JWT_REFRESH_SECRET=staging-replace-with-64-char-random-hex-value-fedcba9876543210abcdef
# SECRET - HMAC key for email verification payloads
EMAIL_VERIFY_SIGNING_KEY=staging-replace-with-64-char-random-hex-value-fedcba9876543210abcdef
# SECRET - SSE stream authentication / signing
SSE_STREAM_KEY=staging-replace-with-64-char-random-hex-value-fedcba9876543210abcdef
# SECRET - Captcha provider secret
CAPTCHA_SECRET=staging-replace-with-64-char-random-hex-value-fedcba9876543210abcdef

# Outbound email (staging provider)
# SMTP host for transactional email
SMTP_HOST=smtp-staging.internal
# SMTP port (587 TLS typical)
SMTP_PORT=587
# SMTP auth username
SMTP_USER=notifications-staging
# SECRET - SMTP password
SMTP_PASS=staging-smtp-password-min-8-chars
