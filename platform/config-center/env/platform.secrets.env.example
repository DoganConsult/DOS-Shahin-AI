# =============================================================================
# DOS Platform — Single Source of Truth for shared cryptographic secrets.
# =============================================================================
#
# Copy this file to `platform.secrets.env` (chmod 600) and replace the
# placeholders with real values BEFORE booting any service that consumes
# @dos/dos-service-bootstrap (dos / dsoc / dnoc / etc.).
#
# Generate values with (Linux/macOS):
#   openssl rand -hex 32
#
# POLICY:
#   - This file is the ONLY place these three keys are defined.
#   - Per-service ops/env/<svc>.env files MUST NOT redeclare them.
#   - PM2 load order:  COMMON  →  platform.secrets  →  <service>.env  →  PORT
# =============================================================================

# JWT signing secret (≥32 chars). MUST be hex/random — not a phrase.
JWT_SECRET=CHANGE_ME_MIN_32_CHARS_RANDOM_STRING

# JWT refresh signing secret (≥32 chars). MUST differ from JWT_SECRET.
JWT_REFRESH_SECRET=CHANGE_ME_ANOTHER_32_CHARS_RANDOM_STRING

# AES-256 at-rest encryption key (32-byte hex = 64 hex chars).
SECRETS_ENCRYPTION_KEY=CHANGE_ME_32_BYTE_HEX_KEY
