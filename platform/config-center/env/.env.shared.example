# Phase 12C — AI production enablement.
# AI_ENABLED=false fully closes /api/ai*, /api/copilot, /api/nudges,
# /api/mcp at the gateway (Phase 3E safety flag). AI_ENABLED=true is
# the Phase 12C-certified production state; every billing-sensitive
# path remains protected by per-user / per-tenant / per-IP rate
# buckets, per-route authenticate + requirePermission, and tenant
# scoping.
AI_ENABLED=<SET_VIA_SECRETS_MANAGER>
AI_RATE_PER_USER_PER_MIN=<SET_VIA_SECRETS_MANAGER>
AI_RATE_PER_TENANT_PER_MIN=<SET_VIA_SECRETS_MANAGER>
AI_RATE_IP_PER_MIN=<SET_VIA_SECRETS_MANAGER>
