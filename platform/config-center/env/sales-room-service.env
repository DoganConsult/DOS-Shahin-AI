# sales-room-service — Wave 1 stub env (added 2026-04-30)
# Ports SoT: ops/ports.allocation.json
# Shared cryptographic secrets are loaded from ops/env/platform.secrets.env
# (do NOT redeclare JWT_SECRET / JWT_REFRESH_SECRET / SECRETS_ENCRYPTION_KEY here).

NODE_ENV=production
PORT=4047
LOG_LEVEL=info
RLS_ENABLED=true

# Database
DATABASE_URL=postgresql://dos_app:dos_app_pass_2026@localhost:5432/shahin_grc
DB_POOL_MAX=5

# Redis
REDIS_URL=redis://:d57921272933f2d3a94a6f1fbf42982791b8afdd74f96f89@127.0.0.1:6379/0
REDIS_PREFIX=dos:

# Internal service mesh
AUTH_SERVICE_URL=http://127.0.0.1:4001
TENANT_SERVICE_URL=http://127.0.0.1:4002
USER_SERVICE_URL=http://127.0.0.1:4003
NOTIFICATION_SERVICE_URL=http://127.0.0.1:4005
AUDIT_SERVICE_URL=http://127.0.0.1:4006
AI_GATEWAY_SERVICE_URL=http://127.0.0.1:4310
GATEWAY_URL=http://127.0.0.1:4000

INTER_SERVICE_SECRET=local-dev-inter-service-secret-rotate-2026-04-28

# Storage driver: 'fs' (default), 's3', or 'r2'.
SALES_ROOM_STORAGE_DRIVER=fs
SALES_ROOM_FS_ROOT=/data/sales-room/objects

# HMAC signing secret for stateless preview/download tokens.
# MUST be >=32 chars in production. Rotate via SALES_ROOM_SIGNING_SECRET_NEXT
# (Wave 2 will add dual-key verifier for zero-downtime rotation).
SALES_ROOM_SIGNING_SECRET=dev-only-sales-room-signing-secret-rotate-me-2026-04-30
