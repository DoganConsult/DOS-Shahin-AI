# Development Environment Configuration
# This file is used for local development and testing.
# Port allocation mirrors production — see docs/PORT-MAP.md.

NODE_ENV=development
# Default service port for the stack — each service overrides via ops/ecosystem.all.config.js.
PORT=3000
# Structured log verbosity (fatal error warn info debug trace)
LOG_LEVEL=debug

# Database Configuration
# SECRET - Must be protected in real environments
DATABASE_URL=postgresql://shahin:shahin_grc_2024@localhost:5432/shahin_grc
DB_POOL_MAX=10

# Redis Configuration
# SECRET - Redis cluster URL
REDIS_URL=redis://localhost:6379
REDIS_PREFIX=dos:dev:

# Observability Configuration
OTEL_TRACING_ENABLED=false

# Service URLs — production layout (services run natively on this host).
GATEWAY_URL=http://localhost:4000
AUTH_SERVICE_URL=http://localhost:4001
TENANT_SERVICE_URL=http://localhost:4002

# Feature Flags
ENABLE_AI_FEATURES=true
ENABLE_ANALYTICS=true
ENABLE_DEBUG_MODE=true

# Security Configuration
JWT_EXPIRES_IN=1h
REFRESH_TOKEN_EXPIRES_IN=7d
SESSION_TIMEOUT=30m

# External Services
# SECRET - External API keys
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=test@example.com
SMTP_PASS=test123

# Monitoring — services expose /metrics on their own $PORT.
# 9090 is reserved for Prometheus; do not repurpose.
ENABLE_METRICS=true
