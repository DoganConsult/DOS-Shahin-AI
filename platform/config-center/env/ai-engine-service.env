NODE_ENV=production
PORT=4311
LOG_LEVEL=info
RLS_ENABLED=true
DATABASE_URL=postgresql://dos_ai:dos_ai_pass_2026@localhost:5432/shahin_grc
DB_POOL_MAX=10
REDIS_URL=redis://:d57921272933f2d3a94a6f1fbf42982791b8afdd74f96f89@127.0.0.1:6379/0
REDIS_PREFIX=dos:

AUTH_SERVICE_URL=http://127.0.0.1:4001
TENANT_SERVICE_URL=http://127.0.0.1:4002
USER_SERVICE_URL=http://127.0.0.1:4003
WORKFLOW_SERVICE_URL=http://127.0.0.1:4004
NOTIFICATION_SERVICE_URL=http://127.0.0.1:4005
AUDIT_SERVICE_URL=http://127.0.0.1:4006
AI_GATEWAY_SERVICE_URL=http://127.0.0.1:4310
AI_GOVERNANCE_SERVICE_URL=http://127.0.0.1:4312
GATEWAY_URL=http://127.0.0.1:4000

INTER_SERVICE_SECRET=local-dev-inter-service-secret-rotate-2026-04-28

AI_ENABLED=true
AI_PROVIDER=anthropic

# Tier 0 — top-power runtime flags
LANGGRAPH_AGENTS_ENABLED=true
LANGGRAPH_MAX_TOOL_ITERATIONS=8
LANGGRAPH_RAG_ENABLED=true
LANGGRAPH_MEMORY_ENABLED=true
MCP_ENABLED=true
MCP_GATEWAY_URL=http://127.0.0.1:3011/mcp
OTEL_TRACING_ENABLED=true
OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318
OTEL_SAMPLING_RATE=1.0

# Governance enforcement mode (audit | warn | enforce)
AI_GOVERNANCE_ENFORCEMENT_MODE=enforce
AI_TOOL_PERMISSIONS_ENABLED=true
AI_SOD_ENABLED=true
AI_PER_TOOL_AUDIT=true
AI_COST_HARD_CAP_ENABLED=true
# default-deny: tenants with no agent_tool_permissions row are blocked (post-seed mode)
AI_PERMISSION_DEFAULT_ALLOW=false

# Tier 4 — autonomous cron scheduler (reads dos.ai_workflow_triggers)
CRON_SCHEDULER_ENABLED=true

# Wave 6 — alert rules runner (60s tick, reads public.ai_alert_rules,
# writes public.ai_activity_alerts on breach, dispatches via notification-service)
AI_ALERTING_ENABLED=true

# Tier 3 — LLM observability via OTEL → existing Jaeger (Langfuse declined; native stack)
# OTEL_TRACING_ENABLED above turns on the SDK in src/otel-init.ts; it pushes
# spans for agent runs / Claude calls / tool calls / pg / ioredis / http to
# OTEL_EXPORTER_OTLP_ENDPOINT (Jaeger OTLP HTTP receiver). View at http://<host>:16686.
OTEL_SERVICE_NAME=ai-engine-service
# Langfuse declined; native OTEL→Jaeger stack is the source of truth (see comment block above).
# Flip LANGFUSE_ENABLED=true ONLY when a Langfuse server is actually provisioned on LANGFUSE_HOST.
# Leaving it on without a server causes ECONNREFUSED on every prompt fetch (LangfuseFetchNetworkError).
LANGFUSE_ENABLED=false
AI_TENANT_DAILY_USD_CAP=50
AI_PRICE_INPUT_USD_PER_MTOK=3
AI_PRICE_OUTPUT_USD_PER_MTOK=15

# Tier 6 — auto-evaluate every completed run (cost: 1 judge call per run)
AI_AUTO_EVAL_ENABLED=true
ANTHROPIC_API_KEY=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
CLAUDE_API_KEY=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
GEMINI_API_KEY=AIzaSyBqur3LeUZualow-QjHiJndiHcjK8gmJNY
GOOGLE_API_KEY=AIzaSyBqur3LeUZualow-QjHiJndiHcjK8gmJNY
OPENROUTER_API_KEY=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
LANGFUSE_PUBLIC_KEY=pk-lf-dos-de8227b48f57b2c1
LANGFUSE_SECRET_KEY=sk-lf-dos-3d569de9cbf85aec18c2d1492aa690607d649bea7102be92
LANGFUSE_HOST=http://127.0.0.1:4090/admin/langfuse
# Direct Postgres read-only correlation for DNOC trace-surface counts. Read-only
# usage from /api/dnoc-ai/langfuse-counts. Falls back to empty counts if unset.
LANGFUSE_DB_URL=postgresql://langfuse:langfuse_dev_2026@127.0.0.1:5432/langfuse
