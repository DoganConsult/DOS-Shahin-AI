# ──────────────────────────────────────────────────────────────────────────────
# dnoc-service — Deployment Wave 1 runtime env (production)
# Canonical path: platform/dnoc/services/dnoc-service
# Schema-validated by @dos/runtime-config (RLS_ENABLED=true is mandatory in prod)
# ──────────────────────────────────────────────────────────────────────────────

SERVICE_CODE=dnoc-service
NODE_ENV=production
PORT=4102
LOG_LEVEL=info

# ── Postgres (shared platform DB) ─────────────────────────────────────────────
DATABASE_URL=postgresql://dos_auth:dos_auth_pass_2026@localhost:5432/shahin_grc
DB_POOL_MAX=10
RLS_ENABLED=true

# ── Redis (event backbone, DB 0 — shared with platform services) ──────────────
REDIS_URL=redis://:d57921272933f2d3a94a6f1fbf42982791b8afdd74f96f89@127.0.0.1:6379/0

# ── DNOC-service specific (consumed by dist/server.js) ────────────────────────
DNOC_LOGS_RETENTION_DAYS=14
DNOC_METRICS_RETENTION_DAYS=30
DNOC_TRACES_RETENTION_DAYS=7
