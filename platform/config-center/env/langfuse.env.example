# Langfuse v3 (self-hosted) — bare-metal / systemd / PM2 launcher
# Copy to /etc/langfuse/langfuse.env (recommended) and symlink:
#   ln -sf /etc/langfuse/langfuse.env /opt/langfuse/.env
#
# Aligns with upstream docker-compose variables:
#   https://github.com/langfuse/langfuse/blob/main/docker-compose.yml
#
# DOS defaults (see platform/config-center/ops/ports.allocation.json):
#   LISTEN: 127.0.0.1:4090  (gateway/nginx → /admin/langfuse/)

# ----- Core web / auth -----
PORT=4090
HOSTNAME=127.0.0.1

# Public URL Langfuse uses for redirects / NextAuth (behind nginx use external HTTPS URL).
NEXTAUTH_URL=http://127.0.0.1:4090
NEXTAUTH_SECRET=CHANGE_ME_OPENSSL_RAND_HEX_32

# Postgres (platform DB or dedicated langfuse DB)
DATABASE_URL=postgresql://langfuse:CHANGE_ME@127.0.0.1:5432/langfuse

SALT=CHANGE_ME_RANDOM_STRING
# openssl rand -hex 32
ENCRYPTION_KEY=CHANGE_ME_64_HEX_CHARS_OPENSSL_RAND_HEX_32

# Base path when served under nginx sub-path (must match gateway location /admin/langfuse/)
NEXT_PUBLIC_BASE_PATH=/admin/langfuse

TELEMETRY_ENABLED=false
LANGFUSE_ENABLE_EXPERIMENTAL_FEATURES=false

# ----- ClickHouse (required v3) -----
CLICKHOUSE_MIGRATION_URL=clickhouse://127.0.0.1:9000
CLICKHOUSE_URL=http://127.0.0.1:8123
CLICKHOUSE_USER=clickhouse
CLICKHOUSE_PASSWORD=CHANGE_ME
CLICKHOUSE_CLUSTER_ENABLED=false

# ----- Redis (required v3) -----
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_AUTH=CHANGE_ME
REDIS_TLS_ENABLED=false

# ----- S3-compatible object storage (MinIO / AWS / etc.) -----
LANGFUSE_USE_AZURE_BLOB=false
LANGFUSE_USE_OCI_NATIVE_OBJECT_STORAGE=false

LANGFUSE_S3_EVENT_UPLOAD_BUCKET=langfuse
LANGFUSE_S3_EVENT_UPLOAD_REGION=auto
LANGFUSE_S3_EVENT_UPLOAD_ACCESS_KEY_ID=minio
LANGFUSE_S3_EVENT_UPLOAD_SECRET_ACCESS_KEY=CHANGE_ME
LANGFUSE_S3_EVENT_UPLOAD_ENDPOINT=http://127.0.0.1:9000
LANGFUSE_S3_EVENT_UPLOAD_FORCE_PATH_STYLE=true
LANGFUSE_S3_EVENT_UPLOAD_PREFIX=events/

LANGFUSE_S3_MEDIA_UPLOAD_BUCKET=langfuse
LANGFUSE_S3_MEDIA_UPLOAD_REGION=auto
LANGFUSE_S3_MEDIA_UPLOAD_ACCESS_KEY_ID=minio
LANGFUSE_S3_MEDIA_UPLOAD_SECRET_ACCESS_KEY=CHANGE_ME
# External URL for browser-accessible media when different from internal endpoint
LANGFUSE_S3_MEDIA_UPLOAD_ENDPOINT=http://127.0.0.1:9000
LANGFUSE_S3_MEDIA_UPLOAD_FORCE_PATH_STYLE=true
LANGFUSE_S3_MEDIA_UPLOAD_PREFIX=media/

LANGFUSE_S3_BATCH_EXPORT_ENABLED=false

# ----- Optional seed admin / project (first boot) -----
# LANGFUSE_INIT_ORG_ID=
# LANGFUSE_INIT_ORG_NAME=
# LANGFUSE_INIT_PROJECT_ID=
# LANGFUSE_INIT_PROJECT_NAME=
# LANGFUSE_INIT_PROJECT_PUBLIC_KEY=
# LANGFUSE_INIT_PROJECT_SECRET_KEY=
# LANGFUSE_INIT_USER_EMAIL=
# LANGFUSE_INIT_USER_NAME=
# LANGFUSE_INIT_USER_PASSWORD=

# ----- Email (optional) -----
# EMAIL_FROM_ADDRESS=
# SMTP_CONNECTION_URL=
