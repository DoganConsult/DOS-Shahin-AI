# Tenant-service (clean shell).
NODE_ENV=production
PORT=4002
LOG_LEVEL=info

DATABASE_URL=postgresql://dos_auth:dos_auth_pass_2026@localhost:5432/shahin_grc
DB_POOL_MAX=10

AUTH_SERVICE_URL=http://127.0.0.1:4001
# JWT_SECRET / JWT_REFRESH_SECRET / SECRETS_ENCRYPTION_KEY → ops/env/platform.secrets.env (single source of truth, do NOT redeclare here)

# ── DAuth / Keycloak verification ──
KEYCLOAK_BASE_URL=https://shahin-ai.com/login
KEYCLOAK_INTERNAL_BASE_URL=http://127.0.0.1:8180
KEYCLOAK_REALM=dogan
KEYCLOAK_AUDIENCE=shahin-bff
KEYCLOAK_ISSUER=https://shahin-ai.com/login/realms/dogan
KEYCLOAK_JWKS_URL=http://127.0.0.1:8180/login/realms/dogan/protocol/openid-connect/certs
KEYCLOAK_JWKS_CACHE_TTL_MS=600000
DAUTH_ACCEPT_NATIVE_HS256=false
DAUTH_KEYCLOAK_ENFORCE=true

# ── Gateway-origin trust (Wave 1 HMAC) ──
# Must match GATEWAY_ORIGIN_HMAC_SECRET in gateway.env so signed
# x-dos-gateway-token headers verify. Without it, any browser-originated
# request that gateway signs (every authenticated proxy hop) hard-fails
# with 500 CONFIG_ERROR/NO_GATEWAY_SECRET in requireGatewayOrigin
# (platform/config-center/services/tenant-service/src/middleware/gateway-origin.ts:159).
# Gateway-internal axios fetches without the token still pass via
# LEGACY_HEADER_TRUST=true.
GATEWAY_ORIGIN_HMAC_SECRET=edaea84ef5aac336f1a948f92a21f1d81c655bccf0c383a8d04e99c692ddbd8c
LEGACY_HEADER_TRUST=true

# ── Patch 1: Self-registration role policy ──────────────────────────────
# The self-registered user is the workspace ADMIN, not the owner.
# Owner (legal rep / billing principal) is promoted later via a verified flow.
DEFAULT_REGISTRATION_ROLE=tenant_admin

# Hard-fail self-registration when no orgName is collected (from Keycloak
# companyNameEn claim or POST body). Set to `false` ONLY during the cutover
# sprint when Keycloak hasn't been re-provisioned with the new user-profile
# yet; this re-enables the legacy email-domain fallback (e.g. "shahinaicom
# workspace") so existing clients aren't locked out.
REQUIRE_ORG_NAME=false

# ── Patch 1: OpenFGA tuple seeding for self-registered tenants ──────────
# Without these vars services/tenant-service/src/openfga.ts logs "disabled"
# and skips the canonical tuple write (admin/member/ui_admin).  Workflow
# already uses the same store; tenant-service shares the model id.
OPENFGA_API_URL=http://127.0.0.1:8080
OPENFGA_STORE_ID=01KNSF17SBJBCF4H0E4KZM15EQ
OPENFGA_MODEL_ID=01KQHTBYFQ9826QKAQ75QQ0A63
TENANT_SERVICE_OPENFGA_ENFORCE=true
