# DAuth — auth-service (clean shell).
NODE_ENV=production
PORT=4001
LOG_LEVEL=info

# DB.
DATABASE_URL=postgresql://dos_auth:dos_auth_pass_2026@localhost:5432/shahin_grc
DB_POOL_MAX=10

# Public canonical URL.
PUBLIC_BASE_URL=https://shahin-ai.com

# ── Same-domain Keycloak (factory reset) ──
KEYCLOAK_BASE_URL=https://shahin-ai.com/login
KEYCLOAK_INTERNAL_BASE_URL=http://127.0.0.1:8180/login
KEYCLOAK_REALM=dogan
KEYCLOAK_ISSUER=https://shahin-ai.com/login/realms/dogan
KEYCLOAK_JWKS_URL=http://127.0.0.1:8180/login/realms/dogan/protocol/openid-connect/certs
KEYCLOAK_WELL_KNOWN=https://shahin-ai.com/login/realms/dogan/.well-known/openid-configuration
KEYCLOAK_AUDIENCE=shahin-bff

# OIDC browser-mediated flow.
KEYCLOAK_OIDC_CLIENT_ID=shahin-bff
KEYCLOAK_OIDC_CLIENT_SECRET=c96c0661318f3a5d5bceda3d74c3274fe2f3a839189d3b042234cc9284e070d1
KEYCLOAK_OIDC_REDIRECT_URI=https://shahin-ai.com/api/auth/oidc/callback

# Cookie names (consistent across the stack).
COOKIE_DOMAIN=shahin-ai.com
COOKIE_SECURE=true
COOKIE_SAMESITE=lax
COOKIE_ACCESS_NAME=dos_access_token
COOKIE_REFRESH_NAME=dauth_rt
COOKIE_OIDC_STATE=dos_oidc_state

# Final landing after callback.
OIDC_DEFAULT_RETURN_URL=/workspace-home

# Onboarding off — submit lands directly in workspace.
ONBOARDING_ENABLED=false
ONBOARDING_REQUIRE_EMAIL_VERIFIED=false

# Redis (state + sessions).
REDIS_URL=redis://:d57921272933f2d3a94a6f1fbf42982791b8afdd74f96f89@127.0.0.1:6379/1

# ── L34 (Phase 4) — tenant-zone HTTPS listener (mTLS).
# Doctrine Article 4: tenant trust zone uses a SEPARATE CA from admin zone.
# CA: DOS Platform Tenant Zone CA (NOT 'DOS Platform Admin Zone CA').
MTLS_HTTPS_LISTEN=1
MTLS_REQUEST_CLIENT_CERT=1
MTLS_REJECT_UNAUTHORIZED=1
TENANT_MTLS_CA=/root/DOS-Platform/platform/config-center/secrets/tenant-mtls/ca.crt
TENANT_MTLS_CERT=/root/DOS-Platform/platform/config-center/secrets/tenant-mtls/auth-service.crt
TENANT_MTLS_KEY=/root/DOS-Platform/platform/config-center/secrets/tenant-mtls/auth-service.key

# ── Dynamic-only role rule ──────────────────────────────────────────────
# Self-registered users always become tenant_admin for their own tenant.
# Direct platform-admin (PaaS) access is restricted to this allow-list.
PLATFORM_ADMIN_EMAILS=doganlap@gmail.com,ahmet.dogan@doganconsult.com

# ── OpenFGA login-tuple seeder (post-login-roles hook) ──────────────────
OPENFGA_API_URL=http://127.0.0.1:8080
OPENFGA_STORE_ID=01KNSF17SBJBCF4H0E4KZM15EQ
OPENFGA_MODEL_ID=01KQHTBYFQ9826QKAQ75QQ0A63
OPENFGA_PLATFORM_ID=dos
AUTH_SERVICE_OPENFGA_ENFORCE=false

# ── MFA-by-email (Microsoft Graph) ──────────────────────────────────────
# Identity values (azure.tenantId / azure.clientId / azure.clientSecret /
# mfa.sender / mfa.fromLabel / mfa.otpPepper / graph.apiEndpoint) are
# managed dynamically via the platform admin UI at
# /admin/integrations/secrets and stored AES-256-GCM-encrypted in
# dos.platform_secret. The values below are LEGACY BOOTSTRAP fallbacks
# only — the DB store wins whenever ALLOW_ENV_FALLBACK is true (default)
# and a row is populated. Set ALLOW_ENV_FALLBACK=false to enforce
# DB-only resolution in production.
ALLOW_ENV_FALLBACK=true
SECRET_CACHE_TTL_MS=60000
# Numeric MFA knobs (kept as static config — non-secret tunables).
MFA_OTP_TTL_SECONDS=300
MFA_RESEND_COOLDOWN_SECONDS=30
MFA_MAX_ATTEMPTS=5
MFA_PASS_TTL_SECONDS=28800
COOKIE_MFA_PASSED=dos_mfa_passed
# Legacy env-only bootstrap (commented; populate via /admin/integrations/secrets):
# GRAPH_API_ENDPOINT=https://graph.microsoft.com/v1.0
# MFA_SENDER=info@shahin-ai.com
# MFA_FROM_LABEL=Shahin-AI
# MFA_OTP_PEPPER=
# AZURE_TENANT_ID=
# AZURE_CLIENT_ID=
# AZURE_CLIENT_SECRET=

