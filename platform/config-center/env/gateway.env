# Gateway — clean shell. Only the three internal services the shell needs.
NODE_ENV=production
PORT=4000
LOG_LEVEL=info

# DB (shared with auth-service / tenant-service for the shell baseline).
DATABASE_URL=postgresql://dos_auth:dos_auth_pass_2026@localhost:5432/shahin_grc
DB_POOL_MAX=5

# Internal services (only the shell trio).
AUTH_SERVICE_URL=http://127.0.0.1:4001
TENANT_SERVICE_URL=http://127.0.0.1:4002
# DYNAMIC_UI_SERVICE_URL retired per canonicalization decree (Wave 10a).
# Port 4015 now hosts the canonical ui-os-service. Use UI_OS_SERVICE_URL.
UI_OS_SERVICE_URL=http://127.0.0.1:4015
DASHBOARD_WIDGETS_SERVICE_URL=http://127.0.0.1:4023
ANALYTICS_SERVICE_URL=http://127.0.0.1:4024
INTEGRATIONS_SERVICE_URL=http://127.0.0.1:4026
NOTIFICATION_SERVICE_URL=http://127.0.0.1:4005
AI_ENGINE_SERVICE_URL=http://127.0.0.1:4311
AI_GATEWAY_SERVICE_URL=http://127.0.0.1:4310
AI_GOVERNANCE_SERVICE_URL=http://127.0.0.1:4312
PRIVACY_SERVICE_URL=http://127.0.0.1:4012
LANGFUSE_URL=http://127.0.0.1:4090

# 4D platform pillars — port surfaces.
DOS_SERVICE_URL=http://127.0.0.1:4100
DSOC_SERVICE_URL=http://127.0.0.1:4101
DNOC_SERVICE_URL=http://127.0.0.1:4102
# Platform Admin Workspace.
ADMIN_SERVICE_URL=http://127.0.0.1:4080

# Gateway origin signing (required by service.ts startup).
GATEWAY_ORIGIN_HMAC_SECRET=edaea84ef5aac336f1a948f92a21f1d81c655bccf0c383a8d04e99c692ddbd8c
GATEWAY_ORIGIN_TTL_SECONDS=60

# CORS — apex + www only.
CORS_ALLOWED_ORIGINS=https://shahin-ai.com,https://www.shahin-ai.com
PUBLIC_BASE_URL=https://shahin-ai.com

# ── Same-domain Keycloak (factory reset) ──
KEYCLOAK_BASE_URL=https://shahin-ai.com/login
KEYCLOAK_INTERNAL_BASE_URL=http://127.0.0.1:8180
KEYCLOAK_REALM=dogan
KEYCLOAK_CLIENT_ID=shahin-bff
KEYCLOAK_AUDIENCE=shahin-bff
KEYCLOAK_ISSUER=https://shahin-ai.com/login/realms/dogan
KEYCLOAK_JWKS_URL=http://127.0.0.1:8180/login/realms/dogan/protocol/openid-connect/certs
KEYCLOAK_JWKS_CACHE_TTL_MS=600000

# OIDC browser-mediated flow.
KEYCLOAK_OIDC_CLIENT_ID=shahin-bff
KEYCLOAK_OIDC_CLIENT_SECRET=c96c0661318f3a5d5bceda3d74c3274fe2f3a839189d3b042234cc9284e070d1
KEYCLOAK_OIDC_REDIRECT_URI=https://shahin-ai.com/api/auth/oidc/callback

# Login flow.
LOGIN_USE_KEYCLOAK=true
REGISTER_USE_KEYCLOAK_FIRST=true

# Token validation.
DAUTH_ACCEPT_NATIVE_HS256=false
DAUTH_KEYCLOAK_ENFORCE=true

# Onboarding wizard disabled — register submit lands directly in /workspace-home.
CAPTCHA_REQUIRED=false
ONBOARDING_EMAIL_VERIFICATION_ENABLED=false
ONBOARDING_REQUIRE_EMAIL_VERIFIED=false
FORM_ELAPSED_ENFORCE=false

# Redis (cookies + state).
REDIS_URL=redis://:d57921272933f2d3a94a6f1fbf42982791b8afdd74f96f89@127.0.0.1:6379/0
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0
USER_SERVICE_URL=http://127.0.0.1:4003

# ── M15 D1 (C) — admin-zone mTLS hook (gateway → admin-console-bff:4013) ─
# DOCTRINE: Article 4 (admin-zone mTLS required), Article 5 (no fake-green),
#           Article 7 (PPD-gated flip), §10 (no autonomous CA mint).
# DISABLED BY DEFAULT. agent === null when MTLS_ENFORCE=0 or any path is
# missing; proxy then falls back to plain HTTP loopback (M11 baseline).
# L29 (Phase 3 D2) — ops-approved flip 2026-05-04.
MTLS_ENFORCE=1
ADMIN_MTLS_CA=/root/DOS-Platform/platform/config-center/secrets/admin-mtls/ca.crt
ADMIN_MTLS_GATEWAY_CERT=/root/DOS-Platform/platform/config-center/secrets/admin-mtls/gateway-client.crt
ADMIN_MTLS_GATEWAY_KEY=/root/DOS-Platform/platform/config-center/secrets/admin-mtls/gateway-client.key
MTLS_REJECT_UNAUTHORIZED=1
DOS_WORKFLOW_SERVICE_URL=http://127.0.0.1:4018
