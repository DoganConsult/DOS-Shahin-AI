# Dogan-AI OS Platform App Shell — service-specific env
PORT=3010
GATEWAY_URL=http://127.0.0.1:4000
SPA_DIR=/root/DOS-Platform/products/shahin-ai/app/dist/dogan-os-platform/browser
NODE_ENV=production
LOG_LEVEL=info
PLATFORM_APP_SHELL_RATE_LIMIT_MAX=600
PLATFORM_APP_SHELL_RATE_LIMIT_WINDOW_MS=60000
CORS_ALLOWED_ORIGINS=https://dogan-ai.com,https://www.dogan-ai.com,https://shahin-ai.com/login
