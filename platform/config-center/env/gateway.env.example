# Template generated in Phase 1 from the real tracked env file's KEY NAMES.
# Populate real values via the secrets manager at deploy time.
# Real env file is now untracked (.gitignore).

NODE_ENV=<SET_VIA_SECRETS_MANAGER>
PORT=<SET_VIA_SECRETS_MANAGER>
LOG_LEVEL=<SET_VIA_SECRETS_MANAGER>
DATABASE_URL=<SET_VIA_SECRETS_MANAGER>
DB_POOL_MAX=<SET_VIA_SECRETS_MANAGER>
# Gateway public URL — used to build canonical redirect URLs in Keycloak OIDC flows.
GATEWAY_URL=<SET_VIA_SECRETS_MANAGER>
AUTH_SERVICE_URL=<SET_VIA_SECRETS_MANAGER>
TENANT_SERVICE_URL=<SET_VIA_SECRETS_MANAGER>
USER_SERVICE_URL=<SET_VIA_SECRETS_MANAGER>
WORKFLOW_SERVICE_URL=<SET_VIA_SECRETS_MANAGER>
NOTIFICATION_SERVICE_URL=<SET_VIA_SECRETS_MANAGER>
AUDIT_SERVICE_URL=<SET_VIA_SECRETS_MANAGER>
ONBOARDING_SERVICE_URL=<SET_VIA_SECRETS_MANAGER>
AI_GATEWAY_SERVICE_URL=<SET_VIA_SECRETS_MANAGER>
AI_ENGINE_SERVICE_URL=<SET_VIA_SECRETS_MANAGER>
# AI governance surface (31 entity-type endpoints under /api/ai-governance/<slug>).
AI_GOVERNANCE_SERVICE_URL=<SET_VIA_SECRETS_MANAGER>
GOVERNANCE_POLICY_SERVICE_URL=<SET_VIA_SECRETS_MANAGER>
COMPLIANCE_CONTROLS_SERVICE_URL=<SET_VIA_SECRETS_MANAGER>
RISK_INCIDENT_SERVICE_URL=<SET_VIA_SECRETS_MANAGER>
EVIDENCE_AUDIT_REPORTING_SERVICE_URL=<SET_VIA_SECRETS_MANAGER>
VENDOR_SERVICE_URL=<SET_VIA_SECRETS_MANAGER>
ASSET_SERVICE_URL=<SET_VIA_SECRETS_MANAGER>
BCP_SERVICE_URL=<SET_VIA_SECRETS_MANAGER>
TRAINING_SERVICE_URL=<SET_VIA_SECRETS_MANAGER>
PRIVACY_SERVICE_URL=<SET_VIA_SECRETS_MANAGER>
DORA_SERVICE_URL=<SET_VIA_SECRETS_MANAGER>
REMEDIATION_ACTION_SERVICE_URL=<SET_VIA_SECRETS_MANAGER>
QIYAS_JOURNEY_SERVICE_URL=<SET_VIA_SECRETS_MANAGER>
DASHBOARD_WIDGETS_SERVICE_URL=<SET_VIA_SECRETS_MANAGER>
ANALYTICS_SERVICE_URL=<SET_VIA_SECRETS_MANAGER>
EXECUTIVE_INTELLIGENCE_SERVICE_URL=<SET_VIA_SECRETS_MANAGER>
# Proxies /api/integrations → integrations-service (OpenClaw routes live there under /api/integrations/...).
# Set OPENCLAW_* on integrations-service, not on the gateway. See ops/env/integrations-service.env.example.
INTEGRATIONS_SERVICE_URL=<SET_VIA_SECRETS_MANAGER>
# OUTLIER: MCP Gateway intentionally binds to port 3011 (MCP protocol default).
# All other platform services use the 4000-range. MCP_GATEWAY_SERVICE_URL is
# required by the gateway routeServiceMap for /api/mcp proxy routing.
MCP_GATEWAY_SERVICE_URL=<SET_VIA_SECRETS_MANAGER>
NOTIFICATION_INBOX_SERVICE_URL=<SET_VIA_SECRETS_MANAGER>
PORTALS_SERVICE_URL=<SET_VIA_SECRETS_MANAGER>
RECORDS_SERVICE_URL=<SET_VIA_SECRETS_MANAGER>
PLATFORM_PRODUCT_SERVICE_URL=<SET_VIA_SECRETS_MANAGER>
AGRC_OS_SERVICE_URL=<SET_VIA_SECRETS_MANAGER>
# Dynamic UI (PG-backed): gateway proxies /api/dynamic-ui → service root (see services/gateway/src/server.ts).
DYNAMIC_UI_SERVICE_URL=<SET_VIA_SECRETS_MANAGER>
# Platform orchestrator services (DOS = orchestrator, DSOC = security ops, DNOC = network ops).
DOS_SERVICE_URL=<SET_VIA_SECRETS_MANAGER>
DSOC_SERVICE_URL=<SET_VIA_SECRETS_MANAGER>
DNOC_SERVICE_URL=<SET_VIA_SECRETS_MANAGER>
DOS_AIO_SOURCE_ROOT=<SET_VIA_SECRETS_MANAGER>
# Comma-separated exact Origin values (browser sends scheme+host, no path).
# Auth host split (product + admin): set live PM2 env to exactly:
#   https://shahin-ai.com,https://www.shahin-ai.com,https://admin.dogan-ai.com
CORS_ALLOWED_ORIGINS=<SET_VIA_SECRETS_MANAGER>

# Required by services/gateway/src/server.ts (origin / session hardening). High-entropy random string.
GATEWAY_ORIGIN_HMAC_SECRET=<SET_VIA_SECRETS_MANAGER>
# Optional: override default TTL for signed origin payloads (seconds).
# GATEWAY_ORIGIN_TTL_SECONDS=60

# Browser OIDC redirect endpoints: higher per-IP ceiling than default (429 mitigation).
# Applies to GET /api/auth/oidc/start and /api/auth/oidc/callback only.
OIDC_BROWSER_RATE_PER_IP_PER_MIN=<SET_VIA_SECRETS_MANAGER>

# ── DAuth Enterprise Stack (Keycloak + OpenFGA + Cerbos) ──
# Required at the gateway chokepoint. Populate real values via secrets
# manager. `OIDC_UNCONFIGURED` is returned by /api/auth/oidc/start|callback
# when KEYCLOAK_BASE_URL or KEYCLOAK_(OIDC_)CLIENT_SECRET is missing.
OPENFGA_ENABLED=<SET_VIA_SECRETS_MANAGER>
OPENFGA_API_URL=<SET_VIA_SECRETS_MANAGER>
OPENFGA_STORE_ID=<SET_VIA_SECRETS_MANAGER>
OPENFGA_MODEL_ID=<SET_VIA_SECRETS_MANAGER>
OPENFGA_API_TOKEN=<SET_VIA_SECRETS_MANAGER>
GATEWAY_FGA_ENFORCE=<SET_VIA_SECRETS_MANAGER>
KEYCLOAK_BASE_URL=<SET_VIA_SECRETS_MANAGER>
# Loopback base URL for any back-channel KC call from the gateway. MUST
# include the `/login` path prefix (KC_HTTP_RELATIVE_PATH=/login). See
# auth-service.env.example for the full rationale and the 2026-04-27
# incident that documented this invariant. Canonical value:
#   http://127.0.0.1:8180/login
KEYCLOAK_INTERNAL_BASE_URL=<SET_VIA_SECRETS_MANAGER>
KEYCLOAK_REALM=<SET_VIA_SECRETS_MANAGER>
KEYCLOAK_CLIENT_ID=<SET_VIA_SECRETS_MANAGER>
KEYCLOAK_JWKS_URL=<SET_VIA_SECRETS_MANAGER>
# Multi-issuer: comma-separated list of accepted token issuers. Required
# when the platform fronts the same realm via multiple per-brand auth
# hostnames. See auth-service.env.example for the full explanation.
KEYCLOAK_ISSUER=<SET_VIA_SECRETS_MANAGER>
KEYCLOAK_AUDIENCE=<SET_VIA_SECRETS_MANAGER>
KEYCLOAK_OIDC_CLIENT_ID=<SET_VIA_SECRETS_MANAGER>
KEYCLOAK_OIDC_CLIENT_SECRET=<SET_VIA_SECRETS_MANAGER>
KEYCLOAK_OIDC_REDIRECT_URI=<SET_VIA_SECRETS_MANAGER>
DAUTH_KEYCLOAK_ENFORCE=<SET_VIA_SECRETS_MANAGER>
DAUTH_ACCEPT_NATIVE_HS256=<SET_VIA_SECRETS_MANAGER>
DAUTH_OPENFGA_ENFORCE=<SET_VIA_SECRETS_MANAGER>
