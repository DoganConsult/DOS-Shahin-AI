{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "platform-app": {
      "projectType": "application",
      "root": "",
      "sourceRoot": "src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-angular:application",
          "options": {
            "externalDependencies": ["web-worker"],
            "allowedCommonJsDependencies": [
              "events",
              "graphology-utils/is-graph",
              "lottie-web",
              "plotly.js-dist-min",
              "elkjs",
              "@profoundlogic/hogan",
              "flatpickr/dist/plugins/rangePlugin",
              "flatpickr/dist/l10n/index"
            ],
            "outputPath": "dist/platform-app",
            "index": "src/index.html",
            "browser": "src/main.ts",
            "polyfills": ["zone.js"],
            "tsConfig": "tsconfig.app.json",
            "assets": [
              { "glob": "**/*", "input": "src/assets", "output": "assets" },
              { "glob": "**/*", "input": "../../products/shahin-ai/app/public", "output": "/" },
              { "glob": "**/*", "input": "../../products/shahin-ai/shahin_agent_assets_crop", "output": "assets/shahin-kit" },
              { "glob": "manifest.webmanifest", "input": "src", "output": "/" }
            ],
            "styles": [
              "@carbon/styles/css/styles.css",
              "node_modules/@fontsource-variable/inter/index.css",
              "node_modules/@fontsource/tajawal/300.css",
              "node_modules/@fontsource/tajawal/400.css",
              "node_modules/@fontsource/tajawal/500.css",
              "node_modules/@fontsource/tajawal/700.css",
              "node_modules/@fontsource/tajawal/800.css",
              "node_modules/@fontsource-variable/ibm-plex-sans/index.css",
              "node_modules/@fontsource/ibm-plex-sans-arabic/300.css",
              "node_modules/@fontsource/ibm-plex-sans-arabic/400.css",
              "node_modules/@fontsource/ibm-plex-sans-arabic/500.css",
              "node_modules/@fontsource/ibm-plex-sans-arabic/600.css",
              "node_modules/@fontsource/ibm-plex-sans-arabic/700.css",
              "node_modules/@fontsource/ibm-plex-mono/400.css",
              "node_modules/@fontsource/ibm-plex-mono/500.css",
              "node_modules/@fontsource/ibm-plex-mono/600.css",
              "src/design-tokens.css",
              "src/auth-form.styles.css",
              "src/styles.css",
              "src/mobile/mobile.css"
            ],
            "scripts": []
          },
          "configurations": {
            "production": {
              "budgets": [
                { "type": "initial", "maximumWarning": "4MB", "maximumError": "5MB" },
                { "type": "anyComponentStyle", "maximumWarning": "30kB", "maximumError": "50kB" }
              ],
              "outputHashing": "all",
              "serviceWorker": "ngsw-config.json",
              "optimization": {
                "scripts": true,
                "styles": {
                  "minify": true,
                  "inlineCritical": false
                },
                "fonts": false
              }
            },
            "staging": {
              "budgets": [
                { "type": "initial", "maximumWarning": "3MB", "maximumError": "5MB" }
              ],
              "outputHashing": "all",
              "optimization": true,
              "sourceMap": true
            },
            "development": { "optimization": false, "extractLicenses": false, "sourceMap": true }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular-devkit/build-angular:dev-server",
          "options": { "proxyConfig": "src/proxy.conf.json" },
          "configurations": {
            "production": { "buildTarget": "platform-app:build:production" },
            "development": { "buildTarget": "platform-app:build:development" }
          },
          "defaultConfiguration": "development"
        }
      }
    }
  },
  "cli": {
    "analytics": false
  }
}
