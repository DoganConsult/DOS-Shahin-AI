{
  "compileOnSave": false,
  "compilerOptions": {
    "rootDir": "..",
    "outDir": "./dist/out-tsc",
    "forceConsistentCasingInFileNames": true,
    "strict": false,
    "strictNullChecks": false,
    "noImplicitAny": false,
    "noImplicitOverride": true,
    "noPropertyAccessFromIndexSignature": false,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "sourceMap": true,
    "declaration": false,
    "experimentalDecorators": true,
    "moduleResolution": "bundler",
    "importHelpers": true,
    "target": "ES2022",
    "module": "ES2022",
    "useDefineForClassFields": false,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "allowSyntheticDefaultImports": true,
    "lib": ["ES2022", "dom"],
    "paths": {
      "@app/dos":                       ["../dos/index.core.ts"],
      "@app/dos/*":                     ["../dos/*"],
      "@app/dauth":                     ["../dauth/index.ts"],
      "@app/dauth/*":                   ["../dauth/*"],
      "@dos/module-foundation":         ["../foundation/dist/index"],
      "@dos/module-foundation/*":       ["../foundation/dist/*"],
      "@dos/module-foundation/ui":      ["../foundation/ui/index.ts"],
      "@dos/module-foundation/ui/*":    ["../foundation/ui/*"],
      "@dos/ui-system":                 ["../ui-system/dos-ui-system/src/index.ts"],
      "@dos/ui-system/*":               ["../ui-system/dos-ui-system/src/*"],
      "@app/api":                       ["../core/services/api/index.ts"],
      "@app/api/*":                     ["../core/services/api/*"],
      "@app/infrastructure":            ["../runtime/infrastructure/index.ts"],
      "@app/infrastructure/*":          ["../runtime/infrastructure/*"],
      "@app/runtime/*":                 ["../runtime/*"],
      "@app/admin":                     ["../core/admin/index.ts"],
      "@app/admin/*":                   ["../core/admin/*"],
      "@app/ai":                        ["../ai/services/index.ts"],
      "@app/ai/*":                      ["../ai/services/*"],
      "@app/grc":                       ["../core/grc/index.ts"],
      "@app/grc/*":                     ["../core/grc/*"],
      "@app/modules":                   ["../core/modules/index.ts"],
      "@app/modules/*":                 ["../core/modules/*"],
      "@app/portals":                   ["../core/portals/index.ts"],
      "@app/portals/*":                 ["../core/portals/*"],
      "@app/reporting":                 ["../config-center/board-report/features/reporting/index.ts"],
      "@app/reporting/*":               ["../config-center/board-report/features/reporting/services/*"],
      "@app/websocket":                 ["../runtime/websocket/index.ts"],
      "@app/websocket/*":               ["../runtime/websocket/*"],
      "@app/workspace":                 ["../foundation/ui/workspace/index.ts"],
      "@app/workspace/*":               ["../foundation/ui/workspace/*"],
      "@app/core/*":                    ["../core/*"],
      "@app/shared/*":                  ["../config-center/shared/*"],
      "@app/charts/*":                  ["../config-center/shared/charts/*"],
      "@app/widgets":                   ["../config-center/shared/widgets/index.ts"],
      "@app/widgets/*":                 ["../config-center/shared/widgets/*"],
      "@app/features/*":                ["../../modules/compliance/ui/features/*"],
      "@app/services/*":                ["../core/services/*"],
      "@compliance-module/ui":          ["../../modules/compliance/ui/index.ts"],
      "@compliance-module/ui/*":        ["../../modules/compliance/ui/*"],
      "@risk-module/ui":                ["../../modules/risk/ui/index.ts"],
      "@risk-module/ui/*":              ["../../modules/risk/ui/*"],
      "@foundation-module/ui":          ["../foundation/ui/index.ts"],
      "@foundation-module/ui/*":        ["../foundation/ui/*"],
      "@workflow-module/ui":            ["../../products/shahin-ai/app/src/_stubs/workflow-module-ui.stub.ts"],
      "@workflow-module/ui/*":          ["../../products/shahin-ai/app/src/_stubs/workflow-module-ui.stub.ts"],
      "@app/features/risk/*":           ["../../modules/risk/ui/features/risk/*"],
      "@app/features/compliance/*":     ["../../modules/compliance/ui/features/compliance/*"],
      "@app/grc/services/grc-compliance.service": ["../../modules/compliance/ui/services/grc-compliance.service.ts"],
      "@app/*":                         ["./src/*"],
      "@env/*":                         ["./src/environments/*"],
      "@mobile/*":                      ["./src/mobile/*"],
      "@platform/shell/templates":      ["../core/platform/shell/templates/index.ts"],
      "@platform/shell/templates/*":    ["../core/platform/shell/templates/*"],
      "@platform/shell":                ["../core/platform/shell/index.ts"],
      "@platform/shell/*":              ["../core/platform/shell/*"]
    }
  },
  "angularCompilerOptions": {
    "enableI18nLegacyMessageIdFormat": false,
    "strictInjectionParameters": true,
    "strictInputAccessModifiers": true
  },
  "exclude": ["node_modules", "src/mobile/**", "src/**/*.spec.ts", "src/**/*.test.ts", "src/**/*.pbt.ts"]
}
