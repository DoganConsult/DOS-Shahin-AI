{
  "$schema": "./00-universal-module-contract.schema.json",
  "schemaVersion": 1,
  "module": {
    "code": "workspace-shell",
    "product_key": "platform-dna",
    "tier": "platform",
    "category": "platform",
    "owner_service": "ui-os-service",
    "name_en": "Workspace Shell",
    "name_ar": "هيكل مساحة العمل",
    "version": "2.1.0",
    "is_platform_dna": true,
    "route_base": null
  },
  "permissions": [
    { "code": "workspace.shell.read",     "description": "Read workspace shell config",         "sensitive": false },
    { "code": "workspace.shell.manage",   "description": "Manage workspace shell binding rows", "sensitive": true },
    { "code": "workspace.search.use",     "description": "Use command search (cmd-k)",          "sensitive": false },
    { "code": "workspace.workqueue.read", "description": "Read shell action queue",             "sensitive": false },
    { "code": "workspace.agents.observe", "description": "Observe agent activity strip",        "sensitive": false },
    { "code": "workspace.inbox.read",     "description": "Read shell inbox messages",           "sensitive": false },
    { "code": "workspace.records.create", "description": "Use shell quick-create FAB",          "sensitive": false }
  ],
  "roles": [
    { "code": "workspace_shell_viewer", "archetype": "viewer", "permissions": [
      "workspace.shell.read", "workspace.search.use", "workspace.workqueue.read",
      "workspace.agents.observe", "workspace.inbox.read", "workspace.records.create"
    ]},
    { "code": "workspace_shell_admin",  "archetype": "module_lead", "permissions": [
      "workspace.shell.read", "workspace.shell.manage", "workspace.search.use",
      "workspace.workqueue.read", "workspace.agents.observe", "workspace.inbox.read",
      "workspace.records.create"
    ]}
  ],
  "navigation": [],
  "pages": [],
  "components": [
    { "component_key": "shell.app",                "vendor": "ibm-carbon", "carbon_key": "ui-shell",      "schema_version": 1, "selector": "dos-app-shell",              "metadata": { "family": "shell-layout", "position": "root", "responsive": true } },
    { "component_key": "shell.desktop",            "vendor": "ibm-carbon", "carbon_key": "ui-shell",      "schema_version": 1, "selector": "dos-desktop-shell",          "metadata": { "family": "shell-layout", "position": "root", "viewport": "desktop" } },
    { "component_key": "shell.mobile",             "vendor": "ibm-carbon", "carbon_key": "ui-shell",      "schema_version": 1, "selector": "dos-mobile-shell",           "metadata": { "family": "shell-layout", "position": "root", "viewport": "mobile" } },
    { "component_key": "shell.desktop-sidebar",    "vendor": "ibm-carbon", "carbon_key": "ui-shell",      "schema_version": 1, "selector": "dos-desktop-sidebar",        "metadata": { "family": "shell-layout", "position": "left", "collapsible": true } },
    { "component_key": "workspace.header",         "vendor": "ibm-carbon", "carbon_key": "ui-shell",      "schema_version": 1, "selector": "dos-workspace-header",       "metadata": { "family": "workspace-shell", "position": "top" } },
    { "component_key": "workspace.sidebar",        "vendor": "ibm-carbon", "carbon_key": "ui-shell",      "schema_version": 1, "selector": "dos-workspace-sidebar",      "metadata": { "family": "workspace-shell", "position": "left", "collapsible": true } },
    { "component_key": "workspace.mobile-nav",     "vendor": "ibm-carbon", "carbon_key": "tiles",         "schema_version": 1, "selector": "dos-mobile-bottom-nav",      "metadata": { "family": "workspace-shell", "position": "bottom", "max_items": 5 } },
    { "component_key": "shell.mobile-drawer",      "vendor": "ibm-carbon", "carbon_key": "ui-shell",      "schema_version": 1, "selector": "dos-mobile-drawer",          "metadata": { "family": "workspace-shell", "position": "left-overlay", "rtl_safe": true } },
    { "component_key": "shell.workspace-nav",      "vendor": "ibm-carbon", "carbon_key": "ui-shell",      "schema_version": 1, "selector": "dos-workspace-nav",          "metadata": { "family": "workspace-shell", "position": "sidebar-content" } },
    { "component_key": "shell.nav-section",        "vendor": "ibm-carbon", "carbon_key": "ui-shell",      "schema_version": 1, "selector": "dos-nav-section",            "metadata": { "family": "workspace-shell", "position": "sidebar-group" } },
    { "component_key": "shell.nav-item",           "vendor": "ibm-carbon", "carbon_key": "ui-shell",      "schema_version": 1, "selector": "dos-nav-item",               "metadata": { "family": "workspace-shell", "position": "sidebar-leaf" } },
