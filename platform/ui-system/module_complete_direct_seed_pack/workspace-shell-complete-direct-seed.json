  "seeds": [
    {
      "table": "dos.workspace_shell_binding",
      "scope": "per_tenant",
      "conflict_target": ["tenant_id", "component_key"],
      "on_conflict": "do_update",
      "rows": [
        { "component_key": "shell.app",                "enabled": true, "position": 1,  "perms_required": [],
          "props": { "responsive_breakpoint": 672, "desktop_component": "shell.desktop", "mobile_component": "shell.mobile" } },
        { "component_key": "shell.desktop",            "enabled": true, "position": 2,  "perms_required": [],
          "props": { "sidebar_component": "shell.desktop-sidebar", "header_component": "workspace.header" } },
        { "component_key": "shell.mobile",             "enabled": true, "position": 3,  "perms_required": [],
          "props": { "drawer_component": "shell.mobile-drawer", "header_component": "workspace.header", "bottom_nav_component": "workspace.mobile-nav" } },
        { "component_key": "shell.desktop-sidebar",    "enabled": true, "position": 4,  "perms_required": [],
          "props": { "collapsible": true, "rail_width": 48, "expanded_width": 256, "nav_component": "shell.workspace-nav" } },
        { "component_key": "workspace.header",         "enabled": true, "position": 5,  "perms_required": [],
          "props": { "i18n_ns": "shell", "brand_key": "shell.header.brand", "title_key": "shell.header.workspace_title", "home_route": "/workspace-home",
                     "trailing_actions": ["search", "notifications", "help", "theme", "language"],
                     "account_menu_component": "shell.account-menu" } },
        { "component_key": "workspace.sidebar",        "enabled": true, "position": 6,  "perms_required": [],
          "props": { "i18n_ns": "shell", "aria_key": "shell.sidenav.aria_label", "nav_source": "dos.navigation_registry",
                     "search_placeholder_key": "shell.sidebar.search_placeholder" } },
        { "component_key": "workspace.mobile-nav",     "enabled": true, "position": 7,  "perms_required": [],
          "props": { "max_items": 5, "nav_source": "dos.navigation_registry", "aria_key": "shell.mobile_bottom_nav.aria" } },
        { "component_key": "shell.mobile-drawer",      "enabled": true, "position": 8,  "perms_required": [],
          "props": { "title_key": "shell.drawer.title", "close_key": "shell.drawer.close", "nav_component": "shell.workspace-nav" } },
        { "component_key": "shell.workspace-nav",      "enabled": true, "position": 9,  "perms_required": [],
          "props": { "nav_source": "dos.navigation_registry", "section_component": "shell.nav-section", "item_component": "shell.nav-item" } },
        { "component_key": "shell.nav-section",        "enabled": true, "position": 10, "perms_required": [],
          "props": { "collapsible": true, "icon_source": "shell.group.icon" } },
        { "component_key": "shell.nav-item",           "enabled": true, "position": 11, "perms_required": [],
          "props": { "show_badge": true, "disabled_reason_keys": {
            "coming_soon": "shell.nav.disabled.coming_soon", "route_not_wired": "shell.nav.disabled.route_not_wired",
            "backend_offline": "shell.nav.disabled.backend_offline", "missing_permission": "shell.nav.disabled.missing_permission",
            "not_entitled": "shell.nav.disabled.not_entitled", "trial_expired": "shell.nav.disabled.trial_expired",
            "trial_limit_reached": "shell.nav.disabled.trial_limit_reached"
          } } },
        { "component_key": "workspace.command-search", "enabled": true, "position": 12, "perms_required": ["workspace.search.use"],
          "props": { "placeholder_key": "shell.command.placeholder", "aria_key": "shell.command.aria", "empty_key": "shell.command.empty",
                     "categories": ["route", "record", "action", "agent", "help"], "mobile_fullscreen": true } },
        { "component_key": "workspace.status-bar",     "enabled": true, "position": 13, "perms_required": [],
          "props": { "signals": [
            { "id": "system-health", "label_key": "shell.status_bar.system_health", "source": "dnoc-service" },
            { "id": "tenant-status", "label_key": "shell.status_bar.tenant_status", "source": "tenant-service" },
            { "id": "sync-state",    "label_key": "shell.status_bar.sync_state",    "source": "ui-os-service" }
          ] } },
        { "component_key": "workspace.action-queue",   "enabled": true, "position": 14, "perms_required": ["workspace.workqueue.read"],
          "props": { "title_key": "shell.action_queue.title", "aria_key": "shell.action_queue.aria", "empty_key": "shell.action_queue.empty",
                     "source": "workflow-service", "page_size": 5 } },
        { "component_key": "workspace.agent-strip",    "enabled": true, "position": 15, "perms_required": ["workspace.agents.observe"],
          "props": { "title_key": "shell.agent_strip.title", "empty_key": "shell.agent_strip.empty",
                     "source": "ai-engine-service", "live_updates": true } },
        { "component_key": "workspace.inbox-center",   "enabled": true, "position": 16, "perms_required": ["workspace.inbox.read"],
          "props": { "title_key": "shell.inbox.title", "aria_key": "shell.inbox.aria", "empty_key": "shell.inbox.empty",
                     "toggle_key": "shell.inbox.toggle", "source": "notification-service", "mobile_mode": "drawer" } },
        { "component_key": "workspace.context-panel",  "enabled": true, "position": 17, "perms_required": [],
          "props": { "title_key": "shell.context_panel.title", "tabs": [
            { "id": "record",      "label_key": "shell.context_panel.tab.record" },
            { "id": "help",        "label_key": "shell.context_panel.tab.help" },
            { "id": "audit",       "label_key": "shell.context_panel.tab.audit" },
            { "id": "ai-insights", "label_key": "shell.context_panel.tab.ai_insights" }
          ] } },
        { "component_key": "workspace.quick-create",   "enabled": true, "position": 18, "perms_required": ["workspace.records.create"],
          "props": { "title_key": "shell.quick_create.title", "aria_key": "shell.quick.aria", "fab_glyph_key": "shell.quick.fab_glyph",
                     "variant": "fab", "mobile_mode": "sticky-bottom", "actions_source": "module.contract.quick_create" } },
        { "component_key": "shell.account-menu",       "enabled": true, "position": 19, "perms_required": [],
          "props": { "aria_key": "shell.account.aria", "fallback_key": "shell.account.fallback", "initial_fallback_key": "shell.account.initial_fallback",
                     "signout_key": "shell.account.menu.logout",
                     "entries": [
                       { "id": "profile",          "label_key": "shell.account.menu.profile",          "route": "/profile",          "icon": "user" },
                       { "id": "settings",         "label_key": "shell.account.menu.settings",         "route": "/settings",         "icon": "settings" },
                       { "id": "tenant-profile",   "label_key": "shell.account.menu.tenant_profile",   "route": "/tenant-profile",   "icon": "enterprise" },
                       { "id": "tenant-settings",  "label_key": "shell.account.menu.tenant_settings",  "route": "/tenant-settings",  "icon": "settings-adjust", "requires_admin": true }
                     ],
                     "language_toggle": { "en_key": "shell.account.menu.switch_to_english", "ar_key": "shell.account.menu.switch_to_arabic" },
                     "theme_toggle": { "light_key": "shell.account.menu.light_theme", "dark_key": "shell.account.menu.dark_theme" }
          } },
        { "component_key": "shell.banner-strip",       "enabled": true, "position": 20, "perms_required": [],
          "props": { "banners": [
            { "id": "trial-expired",  "title_key": "shell.banner.trial_expired.title",  "message_key": "shell.banner.trial_expired.message",  "action_key": "shell.banner.trial_expired.action", "severity": "danger" },
            { "id": "offline",        "title_key": "shell.banner.offline.title",        "message_key": "shell.banner.offline.message",        "severity": "warning" }
          ] } },
        { "component_key": "shell.toast-outlet",       "enabled": true, "position": 21, "perms_required": [],
          "props": { "position": "bottom-right", "max_visible": 3, "auto_dismiss_ms": 5000 } },
        { "component_key": "page.layout",              "enabled": true, "position": 22, "perms_required": [],
          "props": { "zones": ["masthead", "kpi", "tabs", "main", "context-rail"],
                     "masthead_component": "page.masthead", "tabs_component": "page.tabs" } },
        { "component_key": "page.masthead",            "enabled": true, "position": 23, "perms_required": [],
          "props": { "gradient_token": "--dos-gradient-brand-soft",
                     "mesh_layers": ["--dos-gradient-mesh-1", "--dos-gradient-mesh-2", "--dos-gradient-mesh-3"],
                     "hairline_visible": true, "hairline_token": "--dos-gradient-kpi-line" } },
        { "component_key": "page.header",              "enabled": true, "position": 24, "perms_required": [],
          "props": { "breadcrumb_aria_key": "shell.breadcrumb.aria", "skip_to_main_key": "shell.a11y.skip_to_main" } },
        { "component_key": "page.tabs",                "enabled": true, "position": 25, "perms_required": [],
          "props": { "source": "dos.ui_route_tab", "permission_gated": true } },
        { "component_key": "page.widget-frame",        "enabled": true, "position": 26, "perms_required": [],
          "props": { "default_variant": "solid", "loading_key": "page.loading",
                     "error_title_key": "page.error.title", "empty_title_key": "page.empty.title", "empty_desc_key": "page.empty.description" } },
        { "component_key": "workspace.selectable-tile", "enabled": true, "position": 27, "perms_required": [],
