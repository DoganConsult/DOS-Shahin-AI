  },
  "seeds": [
    {
      "table": "dos.workspace_shell_binding",
      "scope": "per_tenant",
      "conflict_target": ["tenant_id", "component_key"],
      "on_conflict": "do_update",
      "rows": [
        { "component_key": "workspace.header",         "enabled": true, "position": 1,  "perms_required": [],
          "props": { "i18n_ns": "shell", "brand_key": "shell.header.brand", "title_key": "shell.header.workspace_title", "home_route": "/workspace-home" } },
        { "component_key": "workspace.sidebar",        "enabled": true, "position": 2,  "perms_required": [],
          "props": { "i18n_ns": "shell", "aria_key": "shell.sidenav.aria_label", "nav_source": "dos.navigation_registry" } },
        { "component_key": "workspace.mobile-nav",     "enabled": true, "position": 3,  "perms_required": [],
          "props": { "max_items": 5, "nav_source": "dos.navigation_registry" } },
        { "component_key": "workspace.command-search", "enabled": true, "position": 4,  "perms_required": ["workspace.search.use"],
          "props": { "placeholder_key": "shell.search.placeholder", "aria_key": "shell.search.aria", "categories": ["route", "record", "action", "agent", "help"] } },
        { "component_key": "workspace.status-bar",     "enabled": true, "position": 5,  "perms_required": [],
          "props": { "signals": [
            { "id": "system-health", "label_key": "shell.status_bar.system_health", "source": "dnoc-service" },
            { "id": "tenant-status", "label_key": "shell.status_bar.tenant_status", "source": "tenant-service" },
            { "id": "sync-state",    "label_key": "shell.status_bar.sync_state",    "source": "ui-os-service" }
          ] } },
        { "component_key": "workspace.action-queue",   "enabled": true, "position": 6,  "perms_required": ["workspace.workqueue.read"],
          "props": { "title_key": "shell.action_queue.title", "empty_key": "shell.action_queue.empty", "source": "workflow-service", "page_size": 5 } },
        { "component_key": "workspace.agent-strip",    "enabled": true, "position": 7,  "perms_required": ["workspace.agents.observe"],
          "props": { "title_key": "shell.agent_strip.title", "empty_key": "shell.agent_strip.empty", "source": "ai-engine-service", "live_updates": true } },
        { "component_key": "workspace.inbox-center",   "enabled": true, "position": 8,  "perms_required": ["workspace.inbox.read"],
          "props": { "title_key": "shell.inbox.title", "empty_key": "shell.inbox.empty", "source": "notification-service", "mobile_mode": "drawer" } },
        { "component_key": "workspace.context-panel",  "enabled": true, "position": 9,  "perms_required": [],
          "props": { "title_key": "shell.context_panel.title", "tabs": [
            { "id": "record",      "label_key": "shell.context_panel.tab.record" },
            { "id": "help",        "label_key": "shell.context_panel.tab.help" },
            { "id": "audit",       "label_key": "shell.context_panel.tab.audit" },
            { "id": "ai-insights", "label_key": "shell.context_panel.tab.ai_insights" }
          ] } },
        { "component_key": "workspace.quick-create",   "enabled": true, "position": 10, "perms_required": ["workspace.records.create"],
          "props": { "title_key": "shell.quick_create.title", "variant": "fab", "mobile_mode": "sticky-bottom", "actions_source": "module.contract.quick_create" } }
      ]
    }
  ],
  "tables_owned": [
    "dos.workspace_shell_binding",
    "dos.workspace_shell_i18n",
    "dos.workspace_shell_status_label",
    "dos.module_contract_errors",
    "dos.module_contract_publish_log"
  ],
  "depends_on": []
}
