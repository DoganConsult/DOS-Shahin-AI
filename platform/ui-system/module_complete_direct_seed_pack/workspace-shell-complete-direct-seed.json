    { "component_key": "workspace.status-bar",     "vendor": "ibm-carbon", "carbon_key": "tag",           "schema_version": 1, "selector": "dos-workspace-status-bar",   "metadata": { "family": "workspace-shell" } },
    { "component_key": "workspace.action-queue",   "vendor": "ibm-carbon", "carbon_key": "tiles",         "schema_version": 1, "selector": "dos-action-queue",           "metadata": { "family": "workspace-shell", "variant": "shell" } },
    { "component_key": "workspace.agent-strip",    "vendor": "ibm-carbon", "carbon_key": "tiles",         "schema_version": 1, "selector": "dos-agent-activity-strip",   "metadata": { "family": "workspace-shell" } },
    { "component_key": "workspace.inbox-center",   "vendor": "ibm-carbon", "carbon_key": "modal",         "schema_version": 1, "selector": "dos-inbox-center",           "metadata": { "family": "workspace-shell", "mobile_mode": "drawer" } },
    { "component_key": "workspace.context-panel",  "vendor": "ibm-carbon", "carbon_key": "accordion",     "schema_version": 1, "selector": "dos-context-panel",          "metadata": { "family": "workspace-shell", "position": "right" } },
    { "component_key": "workspace.quick-create",   "vendor": "ibm-carbon", "carbon_key": "button",        "schema_version": 1, "selector": "dos-quick-create",           "metadata": { "family": "workspace-shell", "variant": "fab" } },
    { "component_key": "shell.account-menu",       "vendor": "ibm-carbon", "carbon_key": "overflow-menu", "schema_version": 1, "selector": "dos-account-menu",           "metadata": { "family": "workspace-shell", "position": "header-end" } },
    { "component_key": "shell.banner-strip",       "vendor": "ibm-carbon", "carbon_key": "notification",  "schema_version": 1, "selector": "dos-shell-banner-strip",     "metadata": { "family": "shell-singleton", "position": "top-banner", "multiplex": true } },
    { "component_key": "shell.toast-outlet",       "vendor": "ibm-carbon", "carbon_key": "notification",  "schema_version": 1, "selector": "dos-toast-outlet",           "metadata": { "family": "shell-singleton", "position": "bottom-right", "transient": true } },
    { "component_key": "page.layout",              "vendor": "ibm-carbon", "carbon_key": "grid",          "schema_version": 1, "selector": "dos-page-layout",            "metadata": { "family": "page-infrastructure", "zones": ["masthead", "kpi", "tabs", "main", "context-rail"] } },
    { "component_key": "page.masthead",            "vendor": "ibm-carbon", "carbon_key": "tiles",         "schema_version": 1, "selector": "dos-page-masthead",          "metadata": { "family": "page-infrastructure", "position": "page-top", "has_gradient": true } },
    { "component_key": "page.header",              "vendor": "ibm-carbon", "carbon_key": "breadcrumb",    "schema_version": 1, "selector": "dos-page-header",            "metadata": { "family": "page-infrastructure", "position": "page-top" } },
    { "component_key": "page.tabs",                "vendor": "ibm-carbon", "carbon_key": "tabs",          "schema_version": 1, "selector": "dos-tabs",                   "metadata": { "family": "page-infrastructure", "position": "below-masthead" } },
    { "component_key": "page.widget-frame",        "vendor": "ibm-carbon", "carbon_key": "tiles",         "schema_version": 1, "selector": "dos-widget-frame",           "metadata": { "family": "page-infrastructure", "variants": ["solid", "glass", "gradient", "aurora", "minimal"], "states": ["ready", "loading", "error", "empty"] } },
    { "component_key": "workspace.selectable-tile", "vendor": "ibm-carbon", "carbon_key": "tiles",        "schema_version": 1, "selector": "dos-carbon-tile",          "metadata": { "family": "workspace-shell", "variant": "selectable", "primitive": "carbon-tile" } },
    { "component_key": "workspace.clickable-tile",  "vendor": "ibm-carbon", "carbon_key": "tiles",        "schema_version": 1, "selector": "dos-carbon-tile",          "metadata": { "family": "workspace-shell", "variant": "clickable", "primitive": "carbon-tile" } },
    { "component_key": "workspace.expandable-tile", "vendor": "ibm-carbon", "carbon_key": "tiles",        "schema_version": 1, "selector": "dos-carbon-tile",          "metadata": { "family": "workspace-shell", "variant": "expandable", "primitive": "carbon-tile" } },
