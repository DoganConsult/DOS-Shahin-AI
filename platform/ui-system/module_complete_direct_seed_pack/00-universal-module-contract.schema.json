{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dos.platform/seed-pack/module-contract.schema.json",
  "title": "DOS Module Contract — single-source publisher input",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "module"],
  "properties": {
    "$schema":       { "type": "string" },
    "schemaVersion": { "type": "integer", "const": 1 },
    "module": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "tier", "owner_service", "name_en", "name_ar"],
      "properties": {
        "code":          { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
        "product_key":   { "type": ["string", "null"] },
        "tier":          { "enum": ["platform", "module", "product"] },
        "category":      { "type": "string" },
        "owner_service": { "type": "string" },
        "name_en":       { "type": "string", "minLength": 1 },
        "name_ar":       { "type": "string", "minLength": 1 },
        "version":       { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
        "is_platform_dna": { "type": "boolean", "default": false },
        "route_base":    { "type": ["string", "null"] }
      }
    },
    "permissions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code"],
        "properties": {
          "code":        { "type": "string", "pattern": "^[a-z][a-z0-9_]*\\.[a-z][a-z0-9_]*\\.[a-z][a-z0-9_]*$" },
          "description": { "type": "string" },
          "sensitive":   { "type": "boolean", "default": false }
        }
      }
    },
    "roles": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "permissions"],
        "properties": {
          "code":        { "type": "string" },
          "archetype":   { "type": "string" },
          "permissions": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "navigation": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["nav_item_code", "label_en", "label_ar"],
        "properties": {
          "nav_item_code": { "type": "string" },
          "parent_code":   { "type": ["string", "null"] },
          "route":         { "type": ["string", "null"] },
          "label_en":      { "type": "string", "minLength": 1 },
          "label_ar":      { "type": "string", "minLength": 1 },
          "sort_order":    { "type": "integer", "default": 0 },
          "icon":          { "type": ["string", "null"] },
          "permission":    { "type": ["string", "null"] }
        }
      }
    },
    "pages": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["page_code", "route", "archetype", "template_export"],
        "properties": {
          "page_code":       { "type": "string" },
          "route":           { "type": "string", "pattern": "^/(?:[a-z0-9_:-]+(?:/[a-z0-9_:-]+)+|/?)$" },
          "archetype":       { "type": "string" },
          "template_export": { "type": "string", "pattern": ".*TemplateComponent$" },
          "permission":      { "type": ["string", "null"] },
          "props":           { "type": "object" }
        }
      }
    },
    "components": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["component_key", "vendor", "carbon_key"],
        "properties": {
          "component_key":  { "type": "string" },
          "vendor":         { "const": "ibm-carbon" },
          "carbon_key":     { "type": "string" },
          "schema_version": { "type": "integer", "default": 1 },
          "selector":       { "type": "string" },
          "approval_status": { "enum": ["draft", "approved"], "default": "approved" },
          "metadata":       { "type": "object" }
        }
      }
    },
    "apis": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["method", "path", "owner_service"],
        "properties": {
          "method":        { "enum": ["GET", "POST", "PUT", "PATCH", "DELETE"] },
          "path":          { "type": "string", "pattern": "^/api/" },
          "owner_service": { "type": "string" },
          "permission":    { "type": ["string", "null"] }
        }
      }
    },
    "i18n": {
      "type": "object",
      "additionalProperties": false,
      "required": ["en", "ar"],
      "properties": {
        "en": { "type": "object", "additionalProperties": { "type": "string" } },
        "ar": { "type": "object", "additionalProperties": { "type": "string" } }
      }
    },
    "seeds": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["table", "rows", "conflict_target", "on_conflict"],
        "properties": {
          "table":           { "type": "string", "pattern": "^[a-z_]+\\.[a-z_]+$" },
          "rows":            { "type": "array", "items": { "type": "object" } },
          "conflict_target": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
          "on_conflict":     { "enum": ["do_nothing", "do_update"] },
          "scope":           { "enum": ["global", "per_tenant"], "default": "global" }
        }
      }
    },
    "tables_owned": { "type": "array", "items": { "type": "string" } },
    "depends_on":   { "type": "array", "items": { "type": "string" } }
  }
}
