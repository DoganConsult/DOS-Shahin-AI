    "hardcodedSymbolsToPurge": [
      { "symbol": "DEFAULT_PRODUCT_KEY 'agrc'",                   "site": "platform/core/services/grc-auth.service.ts",                                       "replaceWith": "productRuntime.productKey" },
      { "symbol": "brand = 'DOS Platform' default",               "site": "platform/ui-system/dos-ui-system/src/carbon/dos-carbon-header-shell.component.ts","replaceWith": "productRuntime.chrome.brand" },
      { "symbol": "logoHref = '/' default",                       "site": "platform/ui-system/dos-ui-system/src/carbon/dos-carbon-header-shell.component.ts","replaceWith": "productRuntime.chrome.logoHref" },
