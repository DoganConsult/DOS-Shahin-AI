{
  "extends": "../../../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "../../dist",
    "rootDir": "source",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "target": "ES2022",
    "skipLibCheck": true,
    "allowJs": true,
    "esModuleInterop": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "noEmit": false
  },
  "include": ["source/backend/**/*.ts"]
}
